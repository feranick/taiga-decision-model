diff --git a/tests/test_ext_sizes.py b/tests/test_ext_sizes.py
new file mode 100644
index 0000000..ce872fb
--- /dev/null
+++ b/tests/test_ext_sizes.py
@@ -0,0 +1,52 @@
+"""taiga-expanded: goals at other sizes (patch 0007)."""
+import random
+
+import numpy as np
+
+from freecad_s1.ext import profiles as pr, sizes
+from freecad_s1.goals import sample_split_goal
+from freecad_s1.model.featurize import SEG_GOAL, encode_state
+from freecad_s1.schema import Goal, GoalFeature, State
+
+
+def _goal():
+    return Goal([GoalFeature("base_box", {"w": 40, "d": 30, "h": 20}),
+                 GoalFeature("profile_pocket", {"outline": pr.slot(5, 0, 16, 6), "w": 16, "d": 6, "x": 5, "y": 0, "depth": 4}),
+                 GoalFeature("hole", {"r": 2, "x": 20, "y": 3, "z": 10, "nx": 1.0, "ny": 0.0, "nz": 0.0, "at": [20, 3, 10]}),
+                 GoalFeature("polar_pattern", {"n": 4.0, "angle": 180.0, "ax": 0.0, "ay": 0.0, "az": -1.0})],
+                level=3, scale=40)
+
+
+def test_scale_goal_scales_lengths_only():
+    g = sizes.scale_goal(_goal(), 4)
+    assert g.scale == 160
+    assert g.features[0].params == {"w": 160, "d": 120, "h": 80}
+    assert pr.bbox(g.features[1].params["outline"]) == tuple(4 * c for c in pr.bbox(_goal().features[1].params["outline"]))
+    h = g.features[2].params
+    assert (h["r"], h["x"], h["z"], h["nx"], h["at"]) == (8, 80, 40, 1.0, [80, 12, 40])
+    assert g.features[3].params == _goal().features[3].params  # counts, angles, axes unchanged
+
+
+def test_scaled_goals_encode_the_same():
+    a, b = _goal(), sizes.scale_goal(_goal(), 4)
+    ta = encode_state(State(doc_open=True), a, invariant=True, sentinel=True)
+    tb = encode_state(State(doc_open=True), b, invariant=True, sentinel=True)
+    rows = np.flatnonzero(ta.seg == SEG_GOAL)
+    assert np.allclose(ta.num[rows].astype(np.float32), tb.num[rows].astype(np.float32), atol=2e-3)
+
+
+def test_large_suite_is_iid_scaled():
+    for level in (1, 2, 3):
+        a = sample_split_goal("iid", level, random.Random(17 + level))
+        b = sample_split_goal("large", level, random.Random(17 + level))
+        assert b == sizes.scale_goal(a, sizes.LARGE_FACTOR)
+
+
+def test_training_unchanged_unless_augmentation_is_on(monkeypatch):
+    a = [sample_split_goal("train", 3, r) for r in [random.Random(5)] * 50]
+    assert not sizes.applies("train")
+    monkeypatch.setattr(sizes, "SIZE_AUG", 0.5)
+    rng = random.Random(5)
+    big = sum(sample_split_goal("train", 3, rng).scale > 100 for _ in range(300))
+    assert 30 < big < 270
+    assert all(g.scale <= 100 for g in a)
