--- /dev/null
+++ b/freecad_s1/ext/sizes.py
@@ -0,0 +1,74 @@
+"""Goals at other sizes: a size-generalization test, and optional size augmentation.
+
+The goal samplers make parts up to about 80 mm; real parts (e.g. the S 80 pump casing,
+360 mm) are larger. The goal encoding divides lengths by the goal's scale, so a goal scaled
+by k should look the same to the model, apart from what FreeCAD does differently at that size.
+
+  suite "large"      the iid goals (same seeds) with every length x TAIGA_LARGE_FACTOR (4):
+                     compare with "iid" to see the effect of size alone
+  suite "large_ext"  expanded goals (a random new family each) x TAIGA_LARGE_FACTOR
+  training           with TAIGA_SIZE_AUG = p > 0, a fraction p of training goals is scaled
+                     by a log-uniform factor in [1, TAIGA_SIZE_MAX] (5); default 0 (off),
+                     and then the training data are exactly as without this module
+"""
+from __future__ import annotations
+
+import copy
+import math
+import os
+
+from ..schema import GOAL_LENGTH_KEYS, Goal
+
+LARGE_FACTOR = float(os.environ.get("TAIGA_LARGE_FACTOR", "4"))
+SIZE_AUG = float(os.environ.get("TAIGA_SIZE_AUG", "0"))
+SIZE_MAX = float(os.environ.get("TAIGA_SIZE_MAX", "5"))
+SIZE_SPLITS = ("large", "large_ext")
+EXTRA_LENGTH_KEYS = ("z", "off")  # lengths added by the expanded features
+
+
+def _s(v, k: float):
+    return round(float(v) * k, 2)
+
+
+def scale_outline(o: dict, k: float) -> dict:
+    segs = []
+    for seg in o["segs"]:
+        if seg[0] == "S":
+            segs.append(["S", [[_s(u, k), _s(v, k)] for u, v in seg[1]]])
+        else:
+            segs.append([seg[0], *(_s(c, k) for c in seg[1:])])
+    return {"start": [_s(c, k) for c in o["start"]], "segs": segs}
+
+
+def scale_goal(goal: Goal, k: float) -> Goal:
+    """Copy of `goal` with every length multiplied by k (counts, angles, directions unchanged)."""
+    g = copy.deepcopy(goal)
+    for f in g.features:
+        p = f.params
+        for key in list(p):
+            if key in GOAL_LENGTH_KEYS or key in EXTRA_LENGTH_KEYS:
+                p[key] = _s(p[key], k)
+            elif key == "outline":
+                p[key] = scale_outline(p[key], k)
+            elif key == "at":
+                p[key] = [_s(c, k) for c in p[key]]
+    g.scale = goal.scale * k
+    return g
+
+
+def applies(split: str) -> bool:
+    return split in SIZE_SPLITS or (split == "train" and SIZE_AUG > 0)
+
+
+def sample(split: str, level: int, rng, inner) -> Goal:
+    """`inner(split)` samples an unscaled goal (goals.sample_split_goal)."""
+    if split == "train":
+        goal = inner("train")
+        if rng.random() < SIZE_AUG:
+            goal = scale_goal(goal, math.exp(rng.uniform(0.0, math.log(SIZE_MAX))))
+        return goal
+    if split == "large":
+        return scale_goal(inner("iid"), LARGE_FACTOR)
+    from . import sampler
+
+    return scale_goal(inner(rng.choice(sampler.SPLITS)), LARGE_FACTOR)
