@@ -0,0 +1,56 @@
+"""taiga-expanded: stacks with several mirrored bolt holes in the flange rim (patch 0017)."""
+import math
+import random
+
+from freecad_s1.ext import mixed, sampler
+from freecad_s1.goals import heldout_composition, sample_split_goal
+
+
+def test_suites_keep_one_rim_hole():
+    # the suites (and every goal without `extra`) draw stacks with rim_holes=1, as in patch 0016
+    rng = random.Random(5)
+    base = mixed.GoalFeature("base_box", {"w": 90.0, "d": 70.0, "h": 40.0})
+    for _ in range(600):
+        g = mixed._stack_group(rng, base, rng.choice(["+Z", "+Y"]), (1.5, 43.5), explicit=True)
+        if g:
+            assert sum(f.kind == "mirror" for f in g) <= 1
+
+
+def test_training_stacks_carry_several_mirrored_rim_holes():
+    rng = random.Random(3)
+    multi = 0
+    for _ in range(2000):
+        g = sampler._mixed(3, rng, extra=True)
+        assert heldout_composition(g) is None and len(g.features) <= 24
+        pairs = sum(1 for a, b in zip(g.features, g.features[1:])
+                    if a.kind == "profile_pocket" and "at" in a.params and b.kind == "mirror")
+        multi += pairs >= 2
+    assert multi > 100
+
+
+def test_rim_holes_sit_on_the_rim_apart_and_off_the_mirror_plane():
+    rng = random.Random(8)
+    base = mixed.GoalFeature("base_box", {"w": 90.0, "d": 70.0, "h": 40.0})
+    seen = 0
+    for _ in range(600):
+        for face, xr in (("+Z", (1.5, 43.5)), ("+Y", None), ("-X", None)):
+            g = mixed._stack_group(rng, base, face, xr, explicit=True, rim_holes=3)
+            if not g:
+                continue
+            holes = [f for f, nxt in zip(g, g[1:]) if f.kind == "profile_pocket" and nxt.kind == "mirror"]
+            if len(holes) < 2:
+                continue
+            seen += 1
+            neck, flange = g[0], g[1]
+            k = "xyz".index(face[1].lower())
+            m = [a for a in "xyz" if g[-1].params["a" + a] != 0.0][0]
+            rn, rf = neck.params.get("r", neck.params.get("w", 0) / 2), flange.params["r"]
+            for h in holes:
+                d = math.dist([h.params[a] for a in "xyz" if a != "xyz"[k]],
+                              [neck.params[a] for a in "xyz" if a != "xyz"[k]])
+                assert abs(d - (rn + rf) / 2) < 0.2  # on the rim circle
+                assert h.params[m] - neck.params[m] > 0.5  # on one side of the mirror plane
+            for a, b in zip(holes, holes[1:]):
+                hr = a.params["w"] / 2
+                assert math.dist([a.params[x] for x in "xyz"], [b.params[x] for x in "xyz"]) >= 2 * hr + 0.9
+    assert seen > 30
