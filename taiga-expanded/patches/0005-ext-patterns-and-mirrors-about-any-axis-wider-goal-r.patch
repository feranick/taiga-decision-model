+def _span(rng: random.Random, lo: float, hi: float, size: float):
+    """Linear pattern of n copies of a feature `size` wide, centres within [lo, hi]:
+    (first centre, length first to last, n, sign), or None if there is no room."""
+    lo, hi = lo + 0.1, hi - 0.1
+    for n in (rng.randint(2, 4), 2):
+        min_len = (size + 1.5) * (n - 1)
+        if hi - lo >= min_len + 0.2:
+            length = _u(rng, min_len + 0.1, hi - lo - 0.1)
+            first = _u(rng, lo + 0.1, max(lo + 0.1, hi - length - 0.1))
+            sign = rng.choice([1.0, -1.0])
+            return (round(first + length, 1) if sign < 0 else first), length, n, sign
+    return None
+
+
+def _top_feature(rng: random.Random, kind: str, x: float, y: float, r: float, h: float) -> GoalFeature:
+    if kind == "slot_pocket":  # profile pocket: a short slot, round ends
+        from . import profiles as pr
+
+        return _outline_feature("profile_pocket", pr.slot(x, y, 2 * r, r, rng.choice([0.0, math.pi / 2])),
+                                depth=_u(rng, 1, max(1.1, h * 0.6)))
+    p = {"r": r, "x": x, "y": y}
+    if kind == "boss_cyl":
+        p["h"] = _u(rng, 2, 15)
+    return GoalFeature(kind, p)
+
+
+def _pattern_side(rng: random.Random):
+    """A hole / boss on a side face of a box, in a row along the face (horizontal or vertical)."""
+    from . import patterns as pt
+
+    base = _side_base(rng)
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    face = rng.choice(["+X", "-X", "+Y", "-Y"])
+    f = side_feature(rng, rng.choice(["hole", "hole", "hole_std", "boss_cyl"]), base, face)
+    if f is None:
+        return None
+    r = f.params["r"]
+    if rng.random() < 0.5:  # horizontal row
+        k = 1 if face[1] == "X" else 0
+        half = (d if k == 1 else w) / 2
+        sp = _span(rng, -(half - r - 1.5), half - r - 1.5, 2 * r)
+    else:  # vertical row
+        k = 2
+        sp = _span(rng, r + 1.5, h - r - 1.5, 2 * r)
+    if sp is None:
+        return None
+    first, length, n, sign = sp
+    f.params["xyz"[k]] = first
+    return base, [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", k, sign, n=float(n), length=length))]
+
+
+def _pattern_top(rng: random.Random):
+    """A hole / boss / slot pocket on top of a box, in a row along -X or +-Y."""
+    from . import patterns as pt
+
+    base = _side_base(rng) if rng.random() < 0.5 else GoalFeature("base_box", {"w": _u(rng, 30, 80), "d": _u(rng, 30, 80), "h": _u(rng, 6, 30)})
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    kind = rng.choice(["hole", "hole_std", "boss_cyl", "slot_pocket"])
+    k = rng.choice([0, 1, 1])
+    half_a, half_b = (w / 2, d / 2) if k == 0 else (d / 2, w / 2)
+    r = _u(rng, 1.5, max(1.6, min(half_a, half_b) * 0.25))
+    sp = _span(rng, -(half_a - r - 1.5), half_a - r - 1.5, 2 * r)
+    if sp is None:
+        return None
+    first, length, n, sign = sp
+    if k == 0 and sign > 0:
+        sign, first = -1.0, round(first + length, 1)  # +X rows are upstream's; use -X here
+    other = _u(rng, -(half_b - r - 1.5) * 0.8, (half_b - r - 1.5) * 0.8)
+    x, y = (first, other) if k == 0 else (other, first)
+    f = _top_feature(rng, kind, x, y, r, h)
+    return base, [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", k, sign, n=float(n), length=length))]
+
+
+def _pattern_mirror(rng: random.Random):
+    """Mirror across the XZ plane (top or side feature), or a side feature mirrored to the opposite face."""
+    from . import patterns as pt
+
+    base = _side_base(rng)
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    if rng.random() < 0.4:  # top feature at y > 0, mirrored across XZ
+        kind = rng.choice(["hole", "boss_cyl", "pocket_rect"])
+        if kind == "pocket_rect":
+            a, b = _u(rng, 2, w * 0.3), _u(rng, 2, d * 0.2)
+            f = GoalFeature(kind, {"w": a, "d": b, "x": _u(rng, -(w / 2 - a) * 0.7, (w / 2 - a) * 0.7),
+                                   "y": _u(rng, b / 2 + 1, max(b / 2 + 1.1, (d / 2 - b / 2) * 0.8)), "depth": _u(rng, 1, h * 0.6)})
+        else:
+            r = _u(rng, 1.5, max(1.6, min(w, d) * 0.12))
+            f = _top_feature(rng, kind, _u(rng, -(w / 2 - r) * 0.7, (w / 2 - r) * 0.7),
+                             _u(rng, r + 1, max(r + 1.1, (d / 2 - r) * 0.8)), r, h)
+        return base, [f, GoalFeature("mirror", pt.pattern_params("mirror", 1))]
+    face = rng.choice(["+X", "+Y"])
+    f = side_feature(rng, rng.choice(["hole", "boss_cyl", "pocket_rect"]), base, face)
+    if f is None:
+        return None
+    k_face = 0 if face[1] == "X" else 1
+    if rng.random() < 0.5:  # to the opposite face
+        return base, [f, GoalFeature("mirror", pt.pattern_params("mirror", k_face))]
+    k = 1 - k_face  # across the other vertical plane, on the same face
+    size = f.params.get("r", 0) * 2 or f.params["w"]
+    half = (d if k == 1 else w) / 2
+    if half - size / 2 - 1.5 < size / 2 + 1:
+        return None
+    f.params["xyz"[k]] = _u(rng, size / 2 + 1, half - size / 2 - 1.5)
+    return base, [f, GoalFeature("mirror", pt.pattern_params("mirror", k))]
+
+
+def _pattern_disc(rng: random.Random):
+    """A disc turned about X or Y; a hole or pin on its end face, polar pattern about the
+    disc axis (full or partial circle) or a mirror across XY."""
+    from . import patterns as pt
+    from . import revolve as rv
+
+    axis = rng.choice([0, 1])
+    R, L = _u(rng, 18, 45), _u(rng, 6, 25)
+    r_in = _u(rng, 3, R * 0.35) if rng.random() < 0.4 else 0.0
+    base = GoalFeature("profile_revolve", rv.revolve_params(axis, outline=rv.lathe_outline(
+        axis, [(0.0, r_in), (0.0, R), (L, R), (L, r_in)]), angle=360.0))
+    r = _u(rng, 1.5, max(1.6, (R - r_in) * 0.15))
+    lo, hi = r_in + r + 2, R - r - 2
+    if hi - lo < 0.5:
+        return None
+    rb = _u(rng, lo + 0.1, hi - 0.1)
+    kind = rng.choice(["hole", "hole", "boss_cyl"])
+    p = {"r": r, "nx": 0.0, "ny": 0.0, "nz": 0.0, "x": 0.0, "y": 0.0, "z": rb}
+    p["nx" if axis == 0 else "ny"] = 1.0
+    p["x" if axis == 0 else "y"] = L
+    if kind == "boss_cyl":
+        p["h"] = _u(rng, 2, 10)
+    f = GoalFeature(kind, p)
+    if rng.random() < 0.2:
+        return base, [f, GoalFeature("mirror", pt.pattern_params("mirror", 2))], max(2 * R, L)
+    sign = rng.choice([1.0, -1.0])
+    if rng.random() < 0.7:
+        pat = pt.pattern_params("polar_pattern", axis, sign, n=float(rng.randint(3, 8)), angle=360.0)
+    else:
+        pat = pt.pattern_params("polar_pattern", axis, sign, n=float(rng.randint(2, 4)), angle=float(rng.choice([90, 120, 180, 270])))
+    return base, [f, GoalFeature("polar_pattern", pat)], max(2 * R, L)
+
+
+def _pattern_arc(rng: random.Random):
+    """Holes / pins on top of a cylinder, polar about Z over part of a circle."""
+    from ..goals import _base
+    from . import patterns as pt
+
+    base = _base(rng, ["base_cyl"])
+    R, h = base.params["r"], base.params["h"]
+    r = _u(rng, 1.5, max(1.6, R * 0.15))
+    rb = _u(rng, r + 2, max(r + 2.1, R * 0.6))
+    a = rng.uniform(0, 2 * math.pi)
+    f = _top_feature(rng, rng.choice(["hole", "hole_std", "boss_cyl"]), round(rb * math.cos(a), 1), round(rb * math.sin(a), 1), r, h)
+    pat = pt.pattern_params("polar_pattern", 2, rng.choice([1.0, -1.0]), n=float(rng.randint(2, 4)),
+                            angle=float(rng.choice([90, 120, 180, 270])))
+    return base, [f, GoalFeature("polar_pattern", pat)]
+
+
+def _pattern_datum(rng: random.Random):
+    """A cross bore (datum-plane hole) repeated along the part or up its height."""
+    from . import patterns as pt
+
+    base = _side_base(rng)
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    k_n = rng.choice([0, 1])
+    f = datum_feature(rng, "hole", base, k_n)
+    if f is None:
+        return None
+    r = f.params["r"]
+    if rng.random() < 0.6:  # along the in-plane horizontal axis
+        k = 1 - k_n
+        half = (d if k == 1 else w) / 2
+        sp = _span(rng, -(half - r - 2), half - r - 2, 2 * r)
+    else:
+        k = 2
+        sp = _span(rng, r + 2, h - r - 2, 2 * r)
+    if sp is None:
+        return None
+    first, length, n, sign = sp
+    f.params["xyz"[k]] = first
+    return base, [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", k, sign, n=float(n), length=length))]
+
+
+def sample_pattern_goal(level: int, rng: random.Random) -> Goal:
+    """Patterns and mirrors about any axis, of any feature: rows on side faces and on top
+    (along -X / +-Y), rows of cross bores, mirrors across XZ or to the opposite face, polar
+    patterns on discs turned about X / Y, partial polar patterns about Z; optional top dressup."""
+    from ..goals import _dressup
+
+    makers = [_pattern_side, _pattern_top, _pattern_mirror, _pattern_disc, _pattern_arc, _pattern_datum]
+    for _ in range(200):
+        out = rng.choice(makers)(rng)
+        if out is None:
+            continue
+        base, group, scale = (*out, None) if len(out) == 2 else out
+        feats = [base, *group]
+        if level >= 3 and base.kind in ("base_box", "base_cyl") and rng.random() < 0.5:
+            feats.append(_dressup(rng, "chamfer_top" if base.kind == "base_cyl" else rng.choice(["fillet_top", "chamfer_top"]), base))
+        if scale is None:
+            p = base.params
+            scale = max(p["w"], p["d"], p["h"]) if base.kind == "base_box" else max(2 * p["r"], p["h"])
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample a pattern goal")
+
+
 SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _outline_split,
-            "revolve": sample_revolve_goal}
+            "revolve": sample_revolve_goal, "pattern": sample_pattern_goal}
 
 
