+"""taiga-expanded: patterns and mirrors about any axis (patch 0005), pure-Python parts."""
+import random
+
+import numpy as np
+
+from freecad_s1.ext import faces, patterns as pt, sampler
+from freecad_s1.model.featurize import NUM_DIM, SEG_GOAL, encode_state
+from freecad_s1.schema import GOAL_PARAM_KEYS, Goal, GoalFeature, State
+
+
+def test_rows_are_wide_enough_for_the_extra_block():
+    assert NUM_DIM == 64
+    assert 2 * len(GOAL_PARAM_KEYS) + 3 + faces.EXT_NUM_DIM <= NUM_DIM
+
+
+class _Feat:
+    MirrorPlane = Direction = Axis = Angle = Reversed = None
+
+
+def _origin(role):
+    return role
+
+
+def test_configure_sets_axis_plane_direction():
+    feat = _Feat()
+    pt.configure(feat, "PartDesign_Mirrored", GoalFeature("mirror", pt.pattern_params("mirror", 1)), _origin)
+    assert feat.MirrorPlane == ("XZ_Plane", [""])
+    feat = _Feat()
+    pt.configure(feat, "PartDesign_LinearPattern",
+                 GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", 2, -1.0, n=3.0, length=20.0)), _origin)
+    assert feat.Direction == ("Z_Axis", [""]) and feat.Reversed is True
+    feat = _Feat()
+    pt.configure(feat, "PartDesign_PolarPattern",
+                 GoalFeature("polar_pattern", pt.pattern_params("polar_pattern", 0, n=4.0, angle=180.0)), _origin)
+    assert feat.Axis == ("X_Axis", [""]) and feat.Angle == 180.0 and feat.Reversed is False
+    feat = _Feat()  # upstream intent (no axis): untouched
+    pt.configure(feat, "PartDesign_PolarPattern", GoalFeature("polar_pattern", {"n": 6.0}), _origin)
+    assert feat.Axis is None and feat.Angle is None
+
+
+def test_signed_axis_and_angle_are_encoded():
+    f = GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", 1, -1.0, n=3.0, length=20.0))
+    g = Goal([GoalFeature("base_box", {"w": 40, "d": 30, "h": 20}), GoalFeature("hole", {"r": 2, "x": 0, "y": 5}), f],
+             level=2, scale=40)
+    tok = encode_state(State(doc_open=True), g, invariant=True, sentinel=True)
+    row = tok.num[np.flatnonzero(tok.seg == SEG_GOAL)[2]]
+    assert row[43:47].tolist() == [0.0, -1.0, 0.0, 1.0]
+    assert not row[47:].any()
+
+
+def _copies(first, length, n, sign):
+    return [first + sign * i * length / (n - 1) for i in range(int(n))]
+
+
+def test_pattern_copies_stay_on_the_part():
+    rng = random.Random(9)
+    seen = set()
+    for _ in range(1500):
+        g = sampler.sample_pattern_goal(3, rng)
+        base, f, pat = g.features[:3]
+        seen.add(pat.kind)
+        if pat.kind != "linear_pattern" or base.kind != "base_box":
+            continue
+        k = next(i for i, key in enumerate(("ax", "ay", "az")) if pat.params[key])
+        sign = pat.params[("ax", "ay", "az")[k]]
+        size = f.params.get("r", 0.0) or max(f.params["w"], f.params["d"]) / 2
+        first = f.params["xyz"[k]]
+        lim = (base.params["w"] / 2, base.params["d"] / 2, base.params["h"])[k]
+        for c in _copies(first, pat.params["length"], pat.params["n"], sign):
+            if k == 2:
+                assert size <= c <= lim - size + 1e-6
+            else:
+                assert abs(c) <= lim - size + 1e-6
+    assert seen == {"linear_pattern", "polar_pattern", "mirror"}
+
+
+def test_disc_holes_fit_between_bore_and_rim():
+    rng = random.Random(3)
+    n = 0
+    for _ in range(1500):
+        g = sampler.sample_pattern_goal(2, rng)
+        base, f = g.features[:2]
+        if base.kind != "profile_revolve":
+            continue
+        n += 1
+        R = max(abs(v) for _, v in (tuple(s[1:3]) for s in base.params["outline"]["segs"]))
+        assert f.params["z"] + f.params["r"] <= R
+    assert n > 100
