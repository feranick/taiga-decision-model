+"""Patterns and mirrors about any axis.
+
+Upstream patterns are fixed: polar about Z, linear along +X, mirror across the YZ plane.
+A pattern intent may carry an axis (ax, ay, az), one of them +-1 (same keys as ext.revolve):
+  polar_pattern   axis of rotation (sign: direction of rotation), "angle" (default 360)
+  linear_pattern  direction (sign: towards + or -), "length" first to last copy as upstream
+  mirror          normal of the mirror plane (YZ for X, XZ for Y, XY for Z)
+The axes and planes are the body's origin features, so they pass through the origin.
+Intents without an axis keep upstream's behaviour exactly.
+
+Pure stdlib except configure(), which works on FreeCAD objects passed in.
+"""
+from __future__ import annotations
+
+from . import revolve
+
+PATTERN_KINDS = ("polar_pattern", "linear_pattern", "mirror")
+AXIS_FEATURES = ("X_Axis", "Y_Axis", "Z_Axis")
+PLANE_FEATURES = ("YZ_Plane", "XZ_Plane", "XY_Plane")  # normal X, Y, Z
+
+
+def axis_sign(f) -> float:
+    k = revolve.axis_index(f)
+    return -1.0 if float(f.params.get(revolve.AXIS_KEYS[k], 0.0)) < 0 else 1.0
+
+
+def pattern_params(kind: str, axis: int, sign: float = 1.0, **extra) -> dict:
+    p = {"ax": 0.0, "ay": 0.0, "az": 0.0}
+    p[revolve.AXIS_KEYS[axis]] = sign
+    p.update(extra)
+    return p
+
+
+def configure(feat, command: str, f, origin_feature) -> None:
+    """Hook in the pattern executor, after upstream set n / length / angle: axis, plane,
+    direction and angle from the intent. `origin_feature(role)` returns the body's origin
+    feature (e.g. "X_Axis")."""
+    if f is None or f.kind not in PATTERN_KINDS or not revolve.has_axis(f):
+        return
+    k = revolve.axis_index(f)
+    rev = axis_sign(f) < 0
+    if command == "PartDesign_Mirrored":
+        feat.MirrorPlane = (origin_feature(PLANE_FEATURES[k]), [""])
+    elif command == "PartDesign_LinearPattern":
+        feat.Direction = (origin_feature(AXIS_FEATURES[k]), [""])
+        feat.Reversed = rev
+    elif command == "PartDesign_PolarPattern":
+        feat.Axis = (origin_feature(AXIS_FEATURES[k]), [""])
+        feat.Angle = revolve.angle(f)
+        feat.Reversed = rev
