diff --git a/tests/test_ext_limits.py b/tests/test_ext_limits.py
new file mode 100644
index 0000000..682c684
--- /dev/null
+++ b/tests/test_ext_limits.py
@@ -0,0 +1,76 @@
+"""taiga-expanded: model input limits as options (patch 0011). Defaults reproduce upstream exactly;
+larger limits and newest-node truncation let long parts be seen."""
+from dataclasses import asdict
+
+import numpy as np
+import torch
+
+from freecad_s1.model.featurize import MAX_GOAL, MAX_NODES, SEG_GOAL, SEG_NODE, collate, encode_state, make_example
+from freecad_s1.model.net import S1Config, S1Model
+from freecad_s1.schema import Goal, GoalFeature, Node, State
+
+
+def _long_state(n_features: int) -> State:
+    """A Body followed by sketch + pad pairs, one per goal intent."""
+    tree = [Node("Body", "PartDesign::Body")]
+    for i in range(n_features):
+        tree.append(Node(f"Sketch{i:03d}", "Sketcher::SketchObject", parent=0, depth=1))
+        tree.append(Node(f"Pad{i:03d}", "PartDesign::Pad", parent=0, depth=1))
+    return State(doc_open=True, workbench="PartDesignWorkbench", has_body=True, tree=tree)
+
+
+def _goal(n: int) -> Goal:
+    feats = [GoalFeature("base_box", {"w": 40, "d": 30, "h": 10})]
+    feats += [GoalFeature("hole", {"r": 2.0, "x": float(i % 5), "y": 0.0}) for i in range(n - 1)]
+    return Goal(feats, level=3, scale=40.0)
+
+
+def _nodes(tokens):
+    return int((tokens.seg == SEG_NODE).sum()), int((tokens.seg == SEG_GOAL).sum())
+
+
+def test_defaults_are_upstreams_and_change_nothing():
+    cfg = S1Config(invariant_numerics=True, modular=True)
+    assert (cfg.max_nodes, cfg.max_goal, cfg.max_ord, cfg.max_pos, cfg.newest_nodes) == (MAX_NODES, MAX_GOAL, 32, 128, False)
+    assert cfg.feature_opts() == {"invariant": True, "sentinel": True}  # same cache names, same featurization
+    old = {k: v for k, v in asdict(cfg).items() if k not in ("max_nodes", "max_goal", "max_ord", "max_pos", "newest_nodes")}
+    assert S1Config(**old) == cfg  # configs of existing checkpoints load unchanged
+
+
+def test_default_truncation_keeps_the_oldest_objects_and_first_goal_intents():
+    st, g = _long_state(30), _goal(30)  # 61 tree objects, 30 intents
+    tok = encode_state(st, g, invariant=True, sentinel=True)
+    n_nodes, n_goal = _nodes(tok)
+    assert n_nodes == MAX_NODES and n_goal == MAX_GOAL + 1  # + END sentinel
+
+
+def test_larger_limits_and_newest_nodes_see_the_whole_long_part():
+    st, g = _long_state(30), _goal(30)
+    tok = encode_state(st, g, invariant=True, sentinel=True, max_nodes=160, max_goal=64, max_ord=72, max_pos=256)
+    assert _nodes(tok) == (61, 31)
+    assert tok.ord.max() == 31  # the END sentinel of 30 intents; ordinals no longer saturate at 31
+    # newest_nodes at the old size: the Body plus the newest 39 objects
+    tok = encode_state(st, g, invariant=True, sentinel=True, newest_nodes=True)
+    node_pos = tok.pos[tok.seg == SEG_NODE]
+    assert node_pos[0] == 0 and node_pos[1] == 61 - 39 and node_pos[-1] == 60
+    # ordinals are counted over the whole tree: the newest pad is intent 30
+    assert tok.ord[tok.seg == SEG_NODE][-1] == 30
+
+
+def test_a_model_with_larger_limits_runs_and_round_trips(tmp_path):
+    from freecad_s1.model.net import load_checkpoint, save_checkpoint
+
+    cfg = S1Config(pos_mode="rand", ordinal=True, invariant_numerics=True, modular=True, pointer="done",
+                   index_eval="identity", max_nodes=160, max_goal=64, max_ord=72, max_pos=256, newest_nodes=True,
+                   width=64, ff=128, heads=4)
+    model = S1Model(cfg).eval()
+    assert model.state_encoder.pos.num_embeddings == 256 and model.state_encoder.ord.num_embeddings == 72
+    st, g = _long_state(30), _goal(30)
+    ex = make_example(st, g, ["Select:Face+Z", "Std_Undo", "Done"], ["Select:Face+Z"], **cfg.feature_opts())
+    with torch.no_grad():
+        logits, _ = model(collate([ex]))
+    assert logits.shape == (1, 3) and torch.isfinite(logits[0]).all()
+    path = save_checkpoint(tmp_path / "m.pt", model)
+    again = load_checkpoint(path)
+    assert again.cfg == cfg and again.cfg.feature_opts()["newest_nodes"] is True
+    assert np.array_equal(again.state_encoder.pos.weight.detach().numpy(), model.state_encoder.pos.weight.detach().numpy())
