+def to_bottom(f: GoalFeature) -> GoalFeature:
+    """The same top-face feature on the bottom face (Face-Z) instead (patch 0011): x, y and the
+    outline keep their meaning (the bottom face's in-plane axes are X and Y as on top)."""
+    p = dict(f.params)
+    p.update(nx=0.0, ny=0.0, nz=-1.0, z=0.0)
+    return GoalFeature(f.kind, p)
+
+
+def bottom_feature(rng: random.Random, kind: str, base: GoalFeature) -> GoalFeature:
+    """A hole / hole_std / pocket_rect / boss_cyl / boss_box on the bottom face of a box base."""
+    from ..goals import _on_top
+
+    return to_bottom(_on_top(rng, kind, base))
+
+
