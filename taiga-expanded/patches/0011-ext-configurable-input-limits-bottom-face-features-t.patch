diff --git a/tests/test_ext_bottom_goalsfile.py b/tests/test_ext_bottom_goalsfile.py
new file mode 100644
index 0000000..5b9cff1
--- /dev/null
+++ b/tests/test_ext_bottom_goalsfile.py
@@ -0,0 +1,74 @@
+"""taiga-expanded: features on the bottom face, and training goals from a goals file (patch 0011)."""
+import json
+import random
+
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, goalsfile, sampler
+from freecad_s1.goals import RECIPES, heldout_composition, sample_split_goal
+from freecad_s1.schema import Goal, GoalFeature
+
+
+def test_bottom_features_go_on_face_minus_z():
+    rng = random.Random(1)
+    base = sampler._side_base(rng)
+    for kind in ("hole", "hole_std", "pocket_rect", "boss_cyl", "boss_box"):
+        f = sampler.bottom_feature(rng, kind, base)
+        assert faces.normal(f) == (2, -1.0) and f.params["z"] == 0.0
+        assert faces.support_for(f, RECIPES[kind]) == "Face-Z"
+        assert abs(f.params["x"]) < base.params["w"] / 2 and abs(f.params["y"]) < base.params["d"] / 2
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    hole = sampler.bottom_feature(rng, "hole", base)
+    assert expert_actions(Goal([base, hole], level=2, scale=40), meta) == ["Select:Face-Z"]
+
+
+def test_side_and_mixed_goals_now_use_the_bottom_face():
+    rng = random.Random(2)
+    for split, at_least in (("side", 60), ("mixed", 150)):
+        n = 0
+        for _ in range(500):
+            g = sample_split_goal(split, 3, rng)
+            assert heldout_composition(g) is None
+            n += any(faces.has_normal(f) and faces.face_arg(f) == "Face-Z" for f in g.features)
+        assert n >= at_least, (split, n)
+
+
+def _write_goals(tmp_path):
+    def outline(w, d):
+        return {"start": [-w / 2, -d / 2], "segs": [["L", w / 2, -d / 2], ["L", w / 2, d / 2], ["L", -w / 2, d / 2],
+                                                     ["L", -w / 2, -d / 2]]}
+    base = {"kind": "profile_base", "params": {"outline": outline(40, 30), "w": 40, "d": 30, "x": 0, "y": 0, "h": 8}}
+    pocket = {"kind": "profile_pocket", "params": {"outline": outline(6, 6), "w": 6, "d": 6, "x": 0, "y": 0, "depth": 4}}
+    specs = {"one": {"features": [base], "level": 3},
+             "three": {"features": [base, pocket, pocket], "level": 3},
+             "seven": {"features": [base] + [pocket] * 6, "level": 3},
+             "heldout": {"features": [base, {"kind": "boss_box", "params": {"w": 4, "d": 4, "x": 0, "y": 0, "h": 3}},
+                                      {"kind": "polar_pattern", "params": {"n": 4.0}}], "level": 3}}
+    path = tmp_path / "goals_train_verified.json"
+    path.write_text(json.dumps(specs))
+    return path
+
+
+def test_goals_file_feeds_training_by_length(tmp_path, monkeypatch):
+    path = _write_goals(tmp_path)
+    monkeypatch.setenv("TAIGA_GOALS_FILE", str(path))
+    monkeypatch.setenv("TAIGA_GOALS_FRACTION", "1.0")
+    goalsfile._CACHE.clear()
+    pools = goalsfile.load(goalsfile.files())
+    assert [len(pools[k]) for k in (1, 2, 3)] == [1, 1, 1]  # the held-out one is dropped
+    assert pools[3][0].scale == 40 and len(pools[3][0].features) == 7
+    rng = random.Random(3)
+    for level, n in ((1, 1), (2, 3), (3, 7), (4, 7)):
+        g = sample_split_goal("train", level, rng)
+        assert len(g.features) == n and g.features[0].kind == "profile_base"
+    # evaluation splits never draw from the file
+    assert sample_split_goal("iid", 3, random.Random(4)).features[0].kind != "profile_base"
+
+
+def test_without_a_goals_file_training_is_unchanged(monkeypatch):
+    monkeypatch.delenv("TAIGA_GOALS_FILE", raising=False)
+    a = [sample_split_goal("train", 3, random.Random(5)).to_json() for _ in range(5)]
+    monkeypatch.setenv("TAIGA_GOALS_FRACTION", "0.9")  # no file: the fraction does nothing
+    b = [sample_split_goal("train", 3, random.Random(5)).to_json() for _ in range(5)]
+    assert a == b and goalsfile.fraction() == 0.0
