diff --git a/freecad_s1/ext/goalsfile.py b/freecad_s1/ext/goalsfile.py
new file mode 100644
index 0000000..ae0260e
--- /dev/null
+++ b/freecad_s1/ext/goalsfile.py
@@ -0,0 +1,90 @@
+"""Training goals read from a goals file, e.g. converted real designs (patch 0011).
+
+TAIGA_GOALS_FILE   one or more goals JSON files ({name: goal}, as written by
+                   taiga-expanded/datasets/convert_deepcad.py and its verify stage), separated by ":"
+TAIGA_GOALS_FRACTION  share of the training goals drawn from them (default 0.25), at every level
+
+A file goal enters the level its length belongs to (1 intent: level 1, 2-3: level 2, 4 and more:
+level 3; level 3 has no upper limit, so long real designs reach training). Goals that match a
+held-out composition (goals.heldout_composition) are dropped, so the comp suites stay unseen.
+Evaluation splits are unaffected. The file is read once per process.
+
+Pure stdlib.
+"""
+from __future__ import annotations
+
+import json
+import os
+import random
+
+from ..schema import Goal, GoalFeature
+
+_CACHE: dict[str, dict[int, list[Goal]]] = {}
+
+
+def files() -> list[str]:
+    return [p for p in os.environ.get("TAIGA_GOALS_FILE", "").split(":") if p]
+
+
+def fraction() -> float:
+    return float(os.environ.get("TAIGA_GOALS_FRACTION", "0.25")) if files() else 0.0
+
+
+def level_of(n_features: int) -> int:
+    return 1 if n_features <= 1 else 2 if n_features <= 3 else 3
+
+
+def goal_scale(features: list[GoalFeature]) -> float:
+    """Largest extent of the base feature, as build/taiga_build_part.py computes it for a goal without one."""
+    f = features[0]
+    p = f.params
+    if f.kind in ("base_box",):
+        return max(p["w"], p["d"], p["h"])
+    if f.kind in ("base_cyl", "base_hex"):
+        return max(2 * p["r"], p["h"])
+    if f.kind == "profile_base":
+        if "w" in p and "d" in p:
+            return max(p["w"], p["d"], p["h"])
+        from .profiles import bbox
+
+        _, _, w, d = bbox(p["outline"])
+        return max(w, d, p["h"])
+    from .profiles import bbox  # e.g. profile_revolve: extent of the outline
+
+    _, _, w, d = bbox(p["outline"])
+    return max(w, d)
+
+
+def load(paths: list[str]) -> dict[int, list[Goal]]:
+    from ..goals import heldout_composition
+
+    key = ":".join(paths)
+    if key not in _CACHE:
+        by_level: dict[int, list[Goal]] = {1: [], 2: [], 3: []}
+        for path in paths:
+            with open(path) as fh:
+                specs = json.load(fh)
+            for spec in specs.values():
+                feats = [GoalFeature(f["kind"], f.get("params", {})) for f in spec["features"]]
+                if not feats:
+                    continue
+                lv = level_of(len(feats))
+                g = Goal(feats, level=lv, scale=float(spec.get("scale") or goal_scale(feats)))
+                if heldout_composition(g) is None:
+                    by_level[lv].append(g)
+        _CACHE[key] = by_level
+    return _CACHE[key]
+
+
+def use_for_train(rng: random.Random) -> bool:
+    f = fraction()
+    return f > 0 and rng.random() < f
+
+
+def sample(level: int, rng: random.Random) -> Goal | None:
+    """A file goal of `level` (levels above 3 use level 3), or None if the files have none."""
+    pool = load(files()).get(min(max(level, 1), 3), [])
+    if not pool:
+        return None
+    g = rng.choice(pool)
+    return Goal([GoalFeature(f.kind, dict(f.params)) for f in g.features], level=g.level, scale=g.scale)
