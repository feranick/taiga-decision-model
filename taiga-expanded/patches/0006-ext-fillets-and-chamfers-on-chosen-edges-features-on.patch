+def _dress(rng: random.Random, kind: str, limit: float, **sel) -> GoalFeature:
+    """fillet_edges / chamfer_edges no larger than `limit` x 0.3, with selector params."""
+    v = _u(rng, 0.4, max(0.5, limit * 0.3))
+    return GoalFeature(kind, {("r" if kind == "fillet_edges" else "size"): v, **sel})
+
+
+def _normal(axis: int, sign: float) -> dict:
+    p = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+    p[("nx", "ny", "nz")[axis]] = sign
+    return p
+
+
+def _edges_boss(rng: random.Random):
+    """A boss on top; its top edge filleted / chamfered, or a hole / smaller boss on its top face."""
+    from ..goals import _base, _on_top
+
+    base = _side_base(rng) if rng.random() < 0.5 else _base(rng, ["base_box", "base_cyl"])
+    h = base.params["h"]
+    kind = rng.choice(["boss_cyl", "boss_cyl", "boss_box"])
+    boss = _on_top(rng, kind, base)
+    x, y, bh = boss.params["x"], boss.params["y"], boss.params["h"]
+    top = [x, y, round(h + bh, 1)]
+    half = boss.params["r"] if kind == "boss_cyl" else min(boss.params["w"], boss.params["d"]) / 2
+    if kind == "boss_cyl" and rng.random() < 0.5:
+        if rng.random() < 0.6:
+            f = GoalFeature(rng.choice(["hole", "hole_std"]), {"r": _u(rng, 0.8, max(0.9, half * 0.5)), "x": x, "y": y, "at": top})
+        else:  # a smaller boss stacked on the boss (a hub)
+            f = GoalFeature("boss_cyl", {"r": _u(rng, 1, max(1.1, half * 0.7)), "x": x, "y": y, "h": _u(rng, 2, 12), "at": top})
+        return base, [boss, f]
+    kind_d = rng.choice(["fillet_edges", "chamfer_edges"])
+    return base, [boss, _dress(rng, kind_d, min(half, bh), **_normal(2, 1.0), at=top)]
+
+
+def _edges_parallel(rng: random.Random):
+    """A box (optionally with a top hole); fillet / chamfer every edge along X, Y or Z."""
+    from ..goals import _on_top
+
+    base = _side_base(rng)
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    k = rng.choice([0, 1, 2])
+    # a top hole's seam edge runs along Z: only with X / Y edges
+    feats = [_on_top(rng, rng.choice(["hole", "hole_std"]), base)] if k < 2 and rng.random() < 0.4 else []
+    across = [(d, h), (w, h), (w, d)][k]
+    kind = rng.choice(["fillet_edges", "chamfer_edges"])
+    sel = {"ax": 0.0, "ay": 0.0, "az": 0.0}
+    sel[("ax", "ay", "az")[k]] = 1.0
+    return base, feats + [_dress(rng, kind, min(across) * 0.5, **sel)]
+
+
+def _edges_face(rng: random.Random):
+    """A box; the outer edge loop of its bottom or a side face, optionally after a side feature on it."""
+    base = _side_base(rng)
+    w, d, h = base.params["w"], base.params["d"], base.params["h"]
+    face = rng.choice(["-Z", "+X", "-X", "+Y", "-Y"])
+    feats = []
+    if face != "-Z" and rng.random() < 0.4:
+        f = side_feature(rng, rng.choice(["hole", "pocket_rect"]), base, face)
+        if f is not None:
+            feats.append(f)
+    axis = "XYZ".index(face[1])
+    kind = rng.choice(["fillet_edges", "chamfer_edges"])
+    return base, feats + [_dress(rng, kind, min(w, d, h) * 0.5, **_normal(axis, 1.0 if face[0] == "+" else -1.0))]
+
+
+def _edges_turned(rng: random.Random):
+    """A stepped part turned about Z; fillet / chamfer the outer edge of a shoulder or an end."""
+    from . import revolve as rv
+
+    n_steps = rng.randint(2, 3)
+    lengths = [_u(rng, 6, 25) for _ in range(n_steps)]
+    radii = [_u(rng, 8, 35) for _ in range(n_steps)]
+    pts, a = [(0.0, 0.0), (0.0, radii[0])], 0.0
+    for i, (ln, r) in enumerate(zip(lengths, radii)):
+        a += ln
+        pts.append((a, r))
+        if i + 1 < n_steps:
+            pts.append((a, radii[i + 1]))
+    pts.append((a, 0.0))
+    base = GoalFeature("profile_revolve", rv.revolve_params(2, outline=rv.lathe_outline(2, pts), angle=360.0))
+    # candidate faces (sign of the normal, z, radius of a point on the face, size limit):
+    # the two ends, and shoulders between steps of different radius
+    cands = [(1.0, a, 0.0, min(radii[-1], lengths[-1])), (-1.0, 0.0, 0.0, min(radii[0], lengths[0]))]
+    for i in range(n_steps - 1):
+        z = sum(lengths[: i + 1])
+        r0, r1 = radii[i], radii[i + 1]
+        if abs(r0 - r1) < 2:
+            continue
+        lim = min(abs(r0 - r1), lengths[i], lengths[i + 1])
+        if r0 > r1:  # shoulder faces up; its outer edge is the lower step's rim
+            cands.append((1.0, z, (r0 + r1) / 2, lim))
+        else:  # faces down; outer edge is the upper step's rim
+            cands.append((-1.0, z, (r0 + r1) / 2, lim))
+    sign, z, rm, lim = rng.choice(cands)
+    at = [round(rm, 1), 0.0, round(z, 1)]
+    kind = rng.choice(["fillet_edges", "chamfer_edges"])
+    return base, [_dress(rng, kind, lim, **_normal(2, sign), at=at)], max(2 * max(radii), a)
+
+
+def sample_edges_goal(level: int, rng: random.Random) -> Goal:
+    """Fillets / chamfers on chosen edges (a boss's top edge, edges along X / Y / Z, the loop
+    of the bottom or a side face, a shoulder of a turned part) and features on a chosen face
+    (a hole or hub on top of a boss); optional top dressup at level 3."""
+    from ..goals import _dressup
+
+    makers = [_edges_boss, _edges_boss, _edges_parallel, _edges_face, _edges_turned]
+    for _ in range(200):
+        out = rng.choice(makers)(rng)
+        if out is None:
+            continue
+        base, group, scale = (*out, None) if len(out) == 2 else out
+        feats = [base, *group]
+        last = group[-1].kind
+        if (level >= 3 and base.kind == "base_box" and last in ("hole", "hole_std", "boss_cyl") and rng.random() < 0.4):
+            feats.append(_dressup(rng, "chamfer_top", base))
+        if scale is None:
+            p = base.params
+            scale = max(p["w"], p["d"], p["h"]) if base.kind == "base_box" else max(2 * p["r"], p["h"])
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample an edges goal")
+
+
 SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _outline_split,
-            "revolve": sample_revolve_goal, "pattern": sample_pattern_goal}
+            "revolve": sample_revolve_goal, "pattern": sample_pattern_goal,
+            "edges": sample_edges_goal}
 
 
 def sample_split(split: str, level: int, rng: random.Random) -> Goal:
