diff --git a/freecad_s1/ext/edges.py b/freecad_s1/ext/edges.py
new file mode 100644
index 0000000..23e76d4
--- /dev/null
+++ b/freecad_s1/ext/edges.py
@@ -0,0 +1,77 @@
+"""Dressups on chosen edges, and features on a chosen face.
+
+Fillet / chamfer intents "fillet_edges" (param r) and "chamfer_edges" (param size) pick
+their edges from the goal:
+  - with a normal (nx, ny, nz): the outer edge loop of a planar face with that outward
+    normal (Select:Edges@Face+X, Edges@Face-Z, ...);
+  - with an axis (ax, ay, az): every straight edge parallel to that axis (Select:Edges|X,
+    Edges|Y, Edges|Z).
+Which face: the largest one with that normal, as upstream does for the top face, unless the
+intent gives a point "at": [x, y, z] (global); then the face with that normal nearest to the
+point. "at" works the same for the sketch support of any sketched feature (Select:Face+Z,
+Face-X, ...): a hole on top of a boss, a boss on a step, a pocket in a lower face.
+Intents without these keys behave exactly as upstream.
+
+Pure stdlib; FreeCAD objects and helpers are passed in by the runtime.
+"""
+from __future__ import annotations
+
+from . import faces, revolve
+
+EDGE_KINDS = ("fillet_edges", "chamfer_edges")
+# new selections (appended to the catalogue); upstream has Edges@Face+Z and Edges|Z
+EXTRA_SELECTS = ["Edges@Face-Z", "Edges@Face+X", "Edges@Face-X", "Edges@Face+Y", "Edges@Face-Y", "Edges|X", "Edges|Y"]
+
+
+def has_at(f) -> bool:
+    at = None if f is None else f.params.get("at")
+    return isinstance(at, (list, tuple)) and len(at) == 3
+
+
+def select_for(f, recipe) -> str:
+    """Select argument for a non-sketched recipe (hook used by the expert)."""
+    if f.kind in EDGE_KINDS:
+        if revolve.has_axis(f):
+            return "Edges|" + faces.AXIS_NAMES[revolve.axis_index(f)]
+        return "Edges@" + faces.face_arg(f)
+    return recipe.select
+
+
+def extra_selects(face_dirs) -> list[str]:
+    """Valid new selections for a shape with these face directions / edge axes."""
+    out = [f"Select:{a}" for a in EXTRA_SELECTS if a.startswith("Edges@") and a[-2:] in face_dirs]
+    return out + [f"Select:{a}" for a in EXTRA_SELECTS if a.startswith("Edges|") and a[-2:] in face_dirs]
+
+
+def pick(shape, direction: str, f, pick_face, planar_faces, axis_vec, dist):
+    """Face for Select:Face<dir> / Edges@Face<dir>: upstream's largest face, or with "at" the
+    face with that normal nearest to the point. `dist(face, (x, y, z))` is the distance."""
+    if not has_at(f):
+        return pick_face(shape, direction)
+    cands = planar_faces(shape, axis_vec(direction))
+    if not cands:
+        return None
+    at = tuple(float(c) for c in f.params["at"])
+    return min(cands, key=lambda t: (round(dist(t[1], at), 6), -round(t[1].Area, 6)))
+
+
+def parallel_edges(shape, k: int, line_direction) -> list[str]:
+    """Names of the straight edges parallel to global axis k."""
+    out = []
+    for i, e in enumerate(shape.Edges):
+        d = line_direction(e)
+        if d is not None and abs(abs((d.x, d.y, d.z)[k]) - 1) < 1e-6:
+            out.append(f"Edge{i + 1}")
+    return out
+
+
+def parallel_dirs(shape, line_direction) -> list[str]:
+    """Edge-axis markers for ShapeInfo.face_dirs beyond upstream's "|Z"."""
+    return [f"|{faces.AXIS_NAMES[k]}" for k in (0, 1) if parallel_edges(shape, k, line_direction)]
+
+
+def extra_goal_num(f, scale: float) -> list[float]:
+    """"at" / scale (x, y, z) and a flag, for the goal encoding (zeros without it)."""
+    if not has_at(f):
+        return [0.0, 0.0, 0.0, 0.0]
+    return [max(-8.0, min(8.0, float(c) / scale)) for c in f.params["at"]] + [1.0]
