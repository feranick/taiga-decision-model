-"""Features on any planar face.
+"""Features on any planar face, and on origin planes with an offset (datum planes).
 
 A goal feature may carry a support normal (params nx, ny, nz, one of them +-1):
 the sketch then goes on the largest planar face with that outward normal
@@ -7,6 +7,13 @@ global coordinates (x, y, z); the coordinate along the normal is taken from the
 face itself. Rectangle sizes: w runs along the first in-plane global axis
 (X, then Y, then Z), d along the second. Without a normal, behaviour is the
 original top-face behaviour, bit for bit.
+
+Datum-plane features (param "off" present): the sketch goes on the origin plane
+normal to (nx, ny, nz) (Select:Plane:YZ / XZ / XY), shifted by "off" along that
+axis, and the pad or pocket is extruded symmetrically on both sides of the plane.
+That gives cross bores (a hole through the whole part, e.g. a piston-pin or crank
+bore through a cylinder wall), through windows (pocket_rect deeper than the part)
+and cross bosses (pins or lugs sticking out on both sides).
 """
 from __future__ import annotations
 
@@ -32,14 +39,49 @@ def face_arg(f) -> str:
     return f"Face{'+' if sign > 0 else '-'}{AXIS_NAMES[k]}"
 
 
+PLANE_FOR_AXIS = {0: "Plane:YZ", 1: "Plane:XZ", 2: "Plane:XY"}
+
+
+def is_datum(f) -> bool:
+    return "off" in f.params
+
+
 def support_for(f, recipe) -> str | None:
     """Select argument for the sketch support of goal feature `f` (hook used by the expert).
     Only top-face recipes (Face+Z) are redirected; origin-plane recipes keep their plane."""
     if recipe.support == "Face+Z" and has_normal(f):
-        return face_arg(f)
+        return PLANE_FOR_AXIS[normal(f)[0]] if is_datum(f) else face_arg(f)
     return recipe.support
 
 
+def apply_plane_offset(sk, f, app) -> None:
+    """Shift a sketch attached to an origin plane by the feature's offset "off" (global units
+    along the plane's axis). Hook in the NewSketch executor; `app` is the FreeCAD module."""
+    if f is None or not is_datum(f) or not sk.AttachmentSupport:
+        return
+    plane = sk.AttachmentSupport[0][0]
+    n = plane.Placement.Rotation.multVec(app.Vector(0, 0, 1))  # the plane's own normal (sign varies)
+    k = normal(f)[0]
+    comp = (n.x, n.y, n.z)[k]
+    sk.AttachmentOffset = app.Placement(app.Vector(0, 0, float(f.params["off"]) * comp), app.Rotation())
+
+
+def set_symmetric(feat) -> bool:
+    """Extrude a pad/pocket symmetrically to its sketch plane (FreeCAD 1.x: Midplane,
+    newer builds: SideType). Returns False if the feature has neither."""
+    props = getattr(feat, "PropertiesList", [])
+    if "SideType" in props:
+        opts = feat.getEnumerationsOfProperty("SideType") or []
+        sym = next((o for o in opts if "ymmetric" in o), None)
+        if sym is not None:
+            feat.SideType = sym
+            return True
+    if "Midplane" in props:
+        feat.Midplane = True
+        return True
+    return False
+
+
 def inplane_axes(k: int) -> tuple[int, int]:
     a = [i for i in range(3) if i != k]
     return a[0], a[1]
