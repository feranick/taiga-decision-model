 def _u(rng: random.Random, lo: float, hi: float) -> float:
@@ -100,9 +100,90 @@ def sample_side_goal(level: int, rng: random.Random) -> Goal:
     raise ValueError("could not sample a side goal")
 
 
+def _extents(base: GoalFeature) -> tuple[float, float, float]:
+    """Half extents (x, y) of the material usable for cross features, and the height."""
+    p = base.params
+    if base.kind == "base_box":
+        return p["w"] / 2, p["d"] / 2, p["h"]
+    return p["r"], p["r"], p["h"]  # base_cyl
+
+
+def datum_feature(rng: random.Random, kind: str, base: GoalFeature, axis: int) -> GoalFeature | None:
+    """A feature sketched on the origin plane normal to `axis` (0: YZ plane, along X; 1: XZ plane,
+    along Y), shifted by "off", extruded symmetrically: hole = cross bore through the part,
+    pocket_rect = through window, boss_cyl / boss_box = cross pin / lugs sticking out both sides."""
+    hx, hy, h = _extents(base)
+    along = (hx, hy)[axis]  # half extent along the extrusion
+    across = (hy, hx)[axis] * (0.6 if base.kind == "base_cyl" else 1.0)  # usable in-plane half width
+    params: dict[str, float] = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+    params["nx" if axis == 0 else "ny"] = 1.0
+    off = _u(rng, -along * 0.3, along * 0.3)
+    if kind in ("hole", "boss_cyl"):
+        r = _u(rng, 1.5, max(1.6, min(across, h / 2) * 0.35))
+        if 2 * r + 4 > h:
+            return None
+        u = _u(rng, -(across - r) * 0.5, (across - r) * 0.5)
+        v = _u(rng, r + 2, h - r - 2)
+        params["r"] = r
+        if kind == "boss_cyl":
+            params["h"] = round(2 * (along + _u(rng, 4, 15)), 1)  # sticks out on both sides
+    else:
+        a = _u(rng, 2, max(2.1, across * 0.6))
+        b = _u(rng, 2, max(2.1, (h - 4) * 0.6))
+        if b + 4 > h:
+            return None
+        u = _u(rng, -(across - a / 2) * 0.5, (across - a / 2) * 0.5)
+        v = _u(rng, b / 2 + 2, h - b / 2 - 2)
+        params.update(w=a, d=b)
+        if kind == "boss_box":
+            params["h"] = round(2 * (along + _u(rng, 4, 15)), 1)
+        else:
+            params["depth"] = round(2 * along + 10, 1)  # deeper than the part: a through window
+    params["off"] = off
+    if axis == 0:
+        params.update(x=off, y=u, z=v)
+    else:
+        params.update(x=u, y=off, z=v)
+    return GoalFeature(kind, params)
+
+
+def sample_plane_goal(level: int, rng: random.Random) -> Goal:
+    """Box or cylinder base, 1-2 datum-plane features, optionally a top feature from the
+    original vocabulary and a top dressup."""
+    from ..goals import _base, _cut_group, _dressup, _scale
+
+    for _ in range(100):
+        base = _side_base(rng) if rng.random() < 0.6 else _base(rng, ["base_cyl"])
+        if base.kind == "base_cyl":
+            base.params["h"] = _u(rng, 14, 40)
+        feats = [base]
+        budget = 1 if level <= 2 else 4
+        if level >= 3 and rng.random() < 0.4:
+            group, _ = _cut_group(rng, base)
+            if len(group) <= budget - 1:
+                feats += group
+        n = 1 if level <= 2 else rng.choice([1, 1, 2])
+        for _ in range(n):
+            if len(feats) - 1 >= budget:
+                break
+            kind = rng.choice(["hole", "hole", "pocket_rect", "boss_cyl", "boss_box"])
+            f = datum_feature(rng, kind, base, rng.choice([0, 1]))
+            if f is not None:
+                feats.append(f)
+        if len(feats) == 1:
+            continue
+        if level >= 3 and len(feats) - 1 < budget and rng.random() < 0.5:
+            feats.append(_dressup(rng, "chamfer_top" if base.kind == "base_cyl" else rng.choice(["fillet_top", "chamfer_top"]), base))
+        return Goal(feats, level=min(level, 3), scale=_scale(base))
+    raise ValueError("could not sample a plane goal")
+
+
+SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal}
+
+
 def sample_split(split: str, level: int, rng: random.Random) -> Goal:
-    if split == "side":
-        return sample_side_goal(level, rng)
+    if split in SAMPLERS:
+        return SAMPLERS[split](level, rng)
     raise ValueError(split)
 
 
