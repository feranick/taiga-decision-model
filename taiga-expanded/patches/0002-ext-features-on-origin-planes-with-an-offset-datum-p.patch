+# ---------------------------------------------------------------- datum planes (patch 0002)
+
+
+def _datum_hole(axis=1, off=3.0):
+    p = {"r": 3, "x": 0, "y": 0, "z": 10, "nx": 0.0, "ny": 0.0, "nz": 0.0, "off": off}
+    p["nx" if axis == 0 else "ny"] = 1.0
+    p["xy"[axis]] = off
+    return GoalFeature("hole", p)
+
+
+def test_datum_support_is_the_origin_plane():
+    assert faces.support_for(_datum_hole(1), RECIPES["hole"]) == "Plane:XZ"
+    assert faces.support_for(_datum_hole(0), RECIPES["hole"]) == "Plane:YZ"
+    base = GoalFeature("base_cyl", {"r": 20, "h": 30})
+    g = Goal([base, _datum_hole(1)], level=2, scale=40)
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    assert expert_actions(g, meta) == ["Select:Plane:XZ"]
+
+
+def test_datum_offset_and_encoding():
+    tok = encode_state(State(doc_open=True), Goal([GoalFeature("base_box", {"w": 40, "d": 30, "h": 20}), _datum_hole(1, 4.0)],
+                                                   level=2, scale=40), invariant=True, sentinel=True)
+    from freecad_s1.model.featurize import SEG_GOAL
+    row = tok.num[np.flatnonzero(tok.seg == SEG_GOAL)[1]]
+    assert abs(row[33] - 0.1) < 1e-3 and row[38] == 1.0  # off / scale, off present
+
+
+class _App:
+    """Just enough of the FreeCAD module for apply_plane_offset."""
+
+    class Vector(_V):
+        pass
+
+    class Rotation:
+        def __init__(self, cols=None):
+            self.R = np.eye(3) if cols is None else np.array(cols, float).T
+
+        def multVec(self, v):  # noqa: N802
+            return _V(*(self.R @ np.array([v.x, v.y, v.z])))
+
+    class Placement:
+        def __init__(self, base=None, rot=None):
+            self.Base, self.Rotation = base, rot
+
+
+class _Plane:
+    def __init__(self, cols):
+        self.Placement = _App.Placement(_V(), _App.Rotation(cols))
+
+
+class _AttachedSketch:
+    def __init__(self, plane):
+        self.AttachmentSupport = [(plane, "")]
+        self.AttachmentOffset = None
+
+
+def test_plane_offset_follows_the_plane_normal_sign():
+    # an XZ plane whose normal points to -Y: a +3 mm global offset becomes -3 along the sketch normal
+    sk = _AttachedSketch(_Plane([(1, 0, 0), (0, 0, 1), (0, -1, 0)]))
+    faces.apply_plane_offset(sk, _datum_hole(1, 3.0), _App)
+    assert sk.AttachmentOffset.Base.z == -3.0
+    sk = _AttachedSketch(_Plane([(0, 1, 0), (0, 0, 1), (1, 0, 0)]))  # YZ plane, normal +X
+    faces.apply_plane_offset(sk, _datum_hole(0, 3.0), _App)
+    assert sk.AttachmentOffset.Base.z == 3.0
+    sk = _AttachedSketch(_Plane([(1, 0, 0), (0, 0, 1), (0, -1, 0)]))
+    faces.apply_plane_offset(sk, GoalFeature("hole", {"r": 3, "x": 0, "y": 0}), _App)  # not a datum feature
+    assert sk.AttachmentOffset is None
+
+
+class _Feat:
+    def __init__(self, props, enum=None):
+        self.PropertiesList = props
+        self._enum = enum
+
+    def getEnumerationsOfProperty(self, name):  # noqa: N802
+        return self._enum
+
+
+def test_symmetric_extrusion_uses_what_the_feature_has():
+    f = _Feat(["Length", "Midplane"])
+    assert faces.set_symmetric(f) and f.Midplane is True
+    f = _Feat(["Length", "SideType", "Midplane"], ["One side", "Two sides", "Symmetric to plane"])
+    assert faces.set_symmetric(f) and f.SideType == "Symmetric to plane"
+    assert not faces.set_symmetric(_Feat(["Length"]))
+
+
+def test_plane_sampler_geometry():
+    rng = random.Random(5)
+    seen = set()
+    for _ in range(300):
+        g = sampler.sample_plane_goal(3, rng)
+        base = g.features[0]
+        assert base.kind in ("base_box", "base_cyl") and len(g.features) <= 5
+        hx, hy, h = sampler._extents(base)
+        for f in g.features[1:]:
+            if not faces.is_datum(f):
+                continue
+            seen.add(f.kind)
+            k = faces.normal(f)[0]
+            p = f.params
+            assert k in (0, 1) and abs(p["xy"[k]] - p["off"]) < 1e-9  # centre lies on the shifted plane
+            half_along = (hx, hy)[k]
+            if f.kind == "pocket_rect":
+                assert p["depth"] > 2 * half_along  # a through window
+            if f.kind.startswith("boss"):
+                assert p["h"] > 2 * half_along  # sticks out on both sides
+            ext_v = p.get("r", p.get("d", 0) / 2)
+            assert ext_v < p["z"] < h - ext_v
+    assert seen == {"hole", "pocket_rect", "boss_cyl", "boss_box"}
