@@ -1012,6 +1018,12 @@ def _mixed(level: int, rng: random.Random, allow_heldout: bool = False, extra: b
     return sample_mixed_goal(level, rng, allow_heldout=allow_heldout, extra=extra, rim_holes=3 if extra else 1)
 
 
+def _points(level: int, rng: random.Random) -> Goal:
+    from .pointsel import sample_points_goal
+
+    return sample_points_goal(level, rng)
+
+
 def _mixed_at(level: int, rng: random.Random) -> Goal:
     """Suites mixed_at / mixed_at_long (patch 0016): mixed goals with a stack picked by "at" and
     top-face features written with nz=+1 (the S 80 casing's form)."""
@@ -1024,7 +1036,7 @@ SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _ou
             "revolve": sample_revolve_goal, "pattern": sample_pattern_goal,
             "edges": sample_edges_goal,
             "datum_z": sample_datum_z_goal, "overhang": sample_overhang_goal,
-            "turned": _turned, "mixed": _mixed, "mixed_at": _mixed_at}
+            "turned": _turned, "mixed": _mixed, "mixed_at": _mixed_at, "points": _points}
 # evaluation-only splits (patch 0016): not drawn for training (sample_train uses SPLITS) and not
 # part of large_ext (ext.sizes), so the earlier suites keep their goals
 EVAL_SPLITS = ("mixed_at",)
@@ -1047,6 +1059,9 @@ def sample_train(level: int, rng: random.Random) -> Goal:
     """Expanded training goal: at level >= 2 one of the expanded splits (weighted by
