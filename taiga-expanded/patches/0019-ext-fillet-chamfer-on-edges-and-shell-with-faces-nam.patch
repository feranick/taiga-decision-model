diff --git a/freecad_s1/ext/pointsel.py b/freecad_s1/ext/pointsel.py
new file mode 100644
index 0000000..678ffe4
--- /dev/null
+++ b/freecad_s1/ext/pointsel.py
@@ -0,0 +1,201 @@
+"""Selection by points (taiga-expanded, patch 0019): fillet / chamfer on chosen edges, shell
+with chosen faces.
+
+Real parts pick the edges they round one by one: in WHUCAD's 4,509 hand-built parts, 49 %
+have fillets and 20 % chamfers, and 11 % a shell; with them the share of parts whose every
+feature the goals express goes from 32 % to 96 % (docs/README_production_plan.md, 4.4).
+
+An intent names its edges or faces by points, "pts": [[x, y, z], ...] (global), one point
+on each edge (fillet_edges, chamfer_edges) or on each face to remove (shell). The model
+issues one selection command, Select:Edges@Point or Select:Face@Point; the runtime selects
+for every point the edge or face nearest to it, as it does for a face picked with "at". A
+planner names an edge by any point on it (e.g. its midpoint), and the model's command set
+stays small. Intents without "pts" behave exactly as before.
+
+The family "points" (sampler split) builds a box with features on top (bosses, pockets,
+holes) and rounds, chamfers or shells chosen edges and faces of it; every point is computed
+from the goal, so the module stays pure stdlib.
+"""
+from __future__ import annotations
+
+import math
+import random
+
+from ..schema import Goal, GoalFeature
+
+POINT_SELECTS = ["Edges@Point", "Face@Point"]  # appended to the action catalogue
+EDGE_KINDS = ("fillet_edges", "chamfer_edges")
+FACE_KINDS = ("shell",)
+
+
+def has_pts(f) -> bool:
+    pts = None if f is None else f.params.get("pts")
+    return (isinstance(pts, (list, tuple)) and len(pts) > 0
+            and all(isinstance(p, (list, tuple)) and len(p) == 3 for p in pts))
+
+
+def select_for(f) -> str | None:
+    """Select argument for an intent with points (hook for the expert), else None."""
+    if not has_pts(f):
+        return None
+    if f.kind in EDGE_KINDS:
+        return "Edges@Point"
+    if f.kind in FACE_KINDS:
+        return "Face@Point"
+    return None
+
+
+def extra_selects(has_solid: bool) -> list[str]:
+    return [f"Select:{a}" for a in POINT_SELECTS] if has_solid else []
+
+
+def resolve(elements, pts, dist, tol: float) -> list[int] | None:
+    """Index of the element nearest to each point, in order, without repeats; None if some
+    point has no element within `tol`. `dist(element, (x, y, z))` is the distance."""
+    out: list[int] = []
+    for p in pts:
+        p = tuple(float(c) for c in p)
+        d = [dist(e, p) for e in elements]
+        if not d:
+            return None
+        best = min(range(len(d)), key=lambda i: d[i])
+        if d[best] > tol:
+            return None
+        if best not in out:
+            out.append(best)
+    return out
+
+
+def resolve_names(shape, arg: str, f, scale: float, vertex) -> list[str] | None:
+    """Sub-element names for Select:Edges@Point / Select:Face@Point (runtime hook).
+    `vertex(p)` makes a Part.Vertex at p."""
+    if not has_pts(f):
+        return None
+    edges = arg.startswith("Edges")
+    elements = shape.Edges if edges else shape.Faces
+    tol = max(0.05, 0.02 * scale)
+    idx = resolve(elements, f.params["pts"], lambda e, p: e.distToShape(vertex(p))[0], tol)
+    if not idx:
+        return None
+    return [f"{'Edge' if edges else 'Face'}{i + 1}" for i in idx]
+
+
+def extra_goal_num(f, scale: float) -> list[float]:
+    """Point count / 10, centroid / scale, and a flag (zeros without points): 5 numbers."""
+    if not has_pts(f):
+        return [0.0] * 5
+    pts = f.params["pts"]
+    c = [sum(float(p[k]) for p in pts) / len(pts) for k in range(3)]
+    return [min(len(pts), 10) / 10.0, *(max(-8.0, min(8.0, v / scale)) for v in c), 1.0]
+
+
+# ----------------------------------------------------------------------------- the "points" family
+
+def _u(rng: random.Random, lo: float, hi: float) -> float:
+    return round(rng.uniform(lo, hi), 1)
+
+
+def _r3(v: float) -> float:
+    return round(v, 3)
+
+
+def _on_circle(x: float, y: float, r: float, z: float, rng: random.Random) -> list[float]:
+    # never at 0 / 90 / 180 / 270 degrees: a circle's seam vertex (or a seam line) may sit there
+    a = math.radians(rng.choice([20, 35, 55, 70]) + 90 * rng.randrange(4))
+    return [_r3(x + r * math.cos(a)), _r3(y + r * math.sin(a)), _r3(z)]
+
+
+def _base_edges(w: float, d: float, h: float) -> dict[str, tuple[list, float]]:
+    """Edge groups of a box centred on the origin, z from 0 to h: ([point, ...], size limit)."""
+    lim = min(w, d, h)
+    return {
+        "box_top": ([[0.0, d / 2, h], [0.0, -d / 2, h], [w / 2, 0.0, h], [-w / 2, 0.0, h]], lim),
+        "box_vertical": ([[w / 2, d / 2, h / 2], [-w / 2, d / 2, h / 2], [w / 2, -d / 2, h / 2],
+                          [-w / 2, -d / 2, h / 2]], lim),
+        "box_bottom": ([[0.0, d / 2, 0.0], [0.0, -d / 2, 0.0], [w / 2, 0.0, 0.0], [-w / 2, 0.0, 0.0]], lim),
+    }
+
+
+def _place(rng: random.Random, w: float, d: float, half: float, margin: float, taken: list):
+    """Centre for a feature of half-size `half` on the top face, at least `margin` from the box
+    edges and from the other features; None if there is no room."""
+    lo_x, lo_y = -w / 2 + margin + half, -d / 2 + margin + half
+    if lo_x >= -lo_x or lo_y >= -lo_y:
+        return None
+    for _ in range(40):
+        x, y = _u(rng, lo_x, -lo_x), _u(rng, lo_y, -lo_y)
+        if all(max(abs(x - tx), abs(y - ty)) > half + th + margin for tx, ty, th in taken):
+            taken.append((x, y, half))
+            return x, y
+    return None
+
+
+def sample_points_goal(level: int, rng: random.Random) -> Goal:
+    for _ in range(200):
+        w, d, h = _u(rng, 30, 90), _u(rng, 25, 80), _u(rng, 10, 40)
+        feats = [GoalFeature("base_box", {"w": w, "d": d, "h": h})]
+        margin = max(4.0, min(w, d) * 0.12)
+        # box edges: no dressup larger than ~0.6 x the gap to the features on top
+        groups = {k: (pts, min(lim, 3 * margin)) for k, (pts, lim) in _base_edges(w, d, h).items()}
+        taken: list = []
+        shell = rng.random() < 0.25
+        n_top = 0 if level <= 2 else rng.randint(1, 3)
+        for k in range(n_top):
+            kind = "boss_cyl" if shell else rng.choice(["boss_cyl", "boss_cyl", "pocket_rect", "hole"])
+            if kind == "boss_cyl":
+                r = _u(rng, 3, max(3.1, min(w, d) * 0.15))
+                c = _place(rng, w, d, r, margin, taken)
+                if c is None:
+                    continue
+                bh = _u(rng, 4, 15)
+                feats.append(GoalFeature("boss_cyl", {"r": r, "x": c[0], "y": c[1], "h": bh}))
+                groups[f"boss{k}_top"] = ([_on_circle(c[0], c[1], r, h + bh, rng)], min(r, bh))
+                groups[f"boss{k}_root"] = ([_on_circle(c[0], c[1], r, h, rng)], min(bh, margin))
+            elif kind == "pocket_rect":
+                pw, pd = _u(rng, 6, max(6.1, w * 0.3)), _u(rng, 6, max(6.1, d * 0.3))
+                c = _place(rng, w, d, max(pw, pd) / 2, margin, taken)
+                if c is None:
+                    continue
+                dep = _u(rng, 3, max(3.1, h * 0.6))
+                x, y = c
+                feats.append(GoalFeature("pocket_rect", {"w": pw, "d": pd, "x": x, "y": y, "depth": dep}))
+                lim = min(pw, pd, dep)
+                groups[f"pocket{k}_rim"] = ([[x, y + pd / 2, h], [x, y - pd / 2, h], [x + pw / 2, y, h],
+                                             [x - pw / 2, y, h]], lim)
+                groups[f"pocket{k}_floor"] = ([[x, y + pd / 2, h - dep], [x, y - pd / 2, h - dep],
+                                               [x + pw / 2, y, h - dep], [x - pw / 2, y, h - dep]], lim)
+                groups[f"pocket{k}_corners"] = ([[x + sx * pw / 2, y + sy * pd / 2, h - dep / 2]
+                                                 for sx in (1, -1) for sy in (1, -1)], lim)
+            else:
+                r = _u(rng, 1.5, max(1.6, min(w, d) * 0.1))
+                c = _place(rng, w, d, r, margin, taken)
+                if c is None:
+                    continue
+                feats.append(GoalFeature("hole", {"r": r, "x": c[0], "y": c[1]}))
+                groups[f"hole{k}_rim"] = ([_on_circle(c[0], c[1], r, h, rng)], min(r * 2, margin))
+        if level >= 3 and len(feats) < 2:
+            continue
+        scale = max(w, d, h + 15)
+        if shell:
+            bosses = [f for f in feats[1:] if f.kind == "boss_cyl"]
+            t = _u(rng, 0.8, max(0.9, min([min(w, d, h) * 0.15] + [f.params["r"] * 0.4 for f in bosses])))
+            faces = {"top": [_r3(-w / 2 + margin / 2), _r3(-d / 2 + margin / 2), h], "bottom": [0.0, 0.0, 0.0],
+                     "+x": [w / 2, 0.0, _r3(h / 2)], "-x": [-w / 2, 0.0, _r3(h / 2)],
+                     "+y": [0.0, d / 2, _r3(h / 2)], "-y": [0.0, -d / 2, _r3(h / 2)]}
+            names = rng.choice([["top"], ["top"], ["bottom"], ["+x"], ["top", "+y"], ["-x", "+x"]])
+            if bosses and "top" in names:  # keep the bosses' face: open the part elsewhere
+                names = [n for n in names if n != "top"] or [rng.choice(["bottom", "-y"])]
+            feats.append(GoalFeature("shell", {"t": t, "pts": [faces[n] for n in names]}))
+            return Goal(feats, level=min(level, 3), scale=scale)
+        n_dress = 1 if level <= 2 else rng.choice([1, 1, 2])
+        names = list(groups) if level >= 3 else [g for g in groups if g.startswith("box")]
+        rng.shuffle(names)
+        for g in names[:n_dress]:
+            pts, lim = groups[g]
+            chosen = rng.sample(pts, rng.randint(1, len(pts)))
+            kind = rng.choice(["fillet_edges", "chamfer_edges"])
+            v = _u(rng, 0.3, max(0.4, lim * 0.2))
+            feats.append(GoalFeature(kind, {("r" if kind == "fillet_edges" else "size"): v,
+                                            "pts": [[_r3(c) for c in p] for p in chosen]}))
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample a points goal")
