diff --git a/tests/test_ext_pointsel.py b/tests/test_ext_pointsel.py
new file mode 100644
index 0000000..3a55150
--- /dev/null
+++ b/tests/test_ext_pointsel.py
@@ -0,0 +1,99 @@
+"""taiga-expanded: fillet / chamfer on edges and shell with faces named by points (patch 0019)."""
+import random
+
+from freecad_s1.actions import ACTION_IDS, CATALOGUE, action_vector, enumerate_actions
+from freecad_s1.evaluate import SUITES
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import edges, pointsel, sampler, sizes
+from freecad_s1.goals import RECIPES, sample_split_goal
+from freecad_s1.model.featurize import NUM_DIM, SEG_GOAL, encode_state
+from freecad_s1.schema import Goal, GoalFeature, ShapeInfo, State
+
+BOX = GoalFeature("base_box", {"w": 40, "d": 30, "h": 20})
+FIL = GoalFeature("fillet_edges", {"r": 2.0, "pts": [[0.0, 15.0, 20.0], [20.0, 0.0, 20.0]]})
+SHELL = GoalFeature("shell", {"t": 1.5, "pts": [[0.0, 0.0, 20.0]]})
+
+
+def test_selections_are_appended_and_offered_on_a_solid():
+    assert ACTION_IDS[-2:] == ["Select:Edges@Point", "Select:Face@Point"]
+    assert CATALOGUE["Select:Edges@Point"].category == "select"
+    assert action_vector("Select:Edges@Point")[5] == 1.0 and action_vector("Select:Face@Point")[4] == 1.0
+    assert pointsel.extra_selects(True) == ["Select:Edges@Point", "Select:Face@Point"]
+    assert pointsel.extra_selects(False) == []
+
+
+def test_expert_selects_by_points_and_old_intents_are_unchanged():
+    assert edges.select_for(FIL, RECIPES["fillet_edges"]) == "Edges@Point"
+    assert edges.select_for(SHELL, RECIPES["shell"]) == "Face@Point"
+    assert edges.select_for(GoalFeature("shell", {"t": 1.0}), RECIPES["shell"]) == "Face+Z"  # upstream's
+    assert edges.select_for(GoalFeature("fillet_edges", {"r": 1.0, "ax": 1.0, "ay": 0.0, "az": 0.0}),
+                            RECIPES["fillet_edges"]) == "Edges|X"
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    goal = Goal([BOX, FIL], level=2, scale=40)
+    assert expert_actions(goal, meta) == ["Select:Edges@Point"]
+    meta.selection = ["Edges@Point"]
+    assert expert_actions(goal, meta) == ["PartDesign_Fillet"]
+
+
+def test_resolve_nearest_and_tolerance():
+    elements = [0.0, 10.0, 20.0]  # stand-ins: distance is |element - x|
+    dist = lambda e, p: abs(e - p[0])  # noqa: E731
+    assert pointsel.resolve(elements, [[19.9, 0, 0], [0.1, 0, 0], [20.0, 0, 0]], dist, 0.5) == [2, 0]
+    assert pointsel.resolve(elements, [[5.0, 0, 0]], dist, 0.5) is None
+
+
+def test_goal_encoding_has_the_points_block():
+    num = pointsel.extra_goal_num(FIL, 40.0)
+    assert num[0] == 0.2 and num[-1] == 1.0 and abs(num[1] - 0.25) < 1e-9
+    assert pointsel.extra_goal_num(BOX, 40.0) == [0.0] * 5
+    st = State(doc_open=True, workbench="PartDesignWorkbench", shape=ShapeInfo())
+    tok = encode_state(st, Goal([BOX, FIL], level=2, scale=40))
+    rows = [i for i, s in enumerate(tok.seg) if s == SEG_GOAL]
+    assert tok.num.shape[1] == NUM_DIM and tok.num[rows[1]].any()
+
+
+def test_points_scale_with_the_goal():
+    g = sizes.scale_goal(Goal([BOX, FIL], level=2, scale=40), 2.0)
+    assert g.features[1].params["pts"] == [[0.0, 30.0, 40.0], [40.0, 0.0, 40.0]]
+
+
+def test_points_family_goals():
+    assert "points" in sampler.SPLITS and "points" not in sampler.LARGE_EXT_SPLITS
+    assert SUITES["points"] == [(3, "points")]
+    rng = random.Random(1)
+    n_shell = n_multi = 0
+    for level in (2, 3):
+        for _ in range(300):
+            g = sample_split_goal("points", level, rng)
+            b = g.features[0].params
+            last = [f for f in g.features if pointsel.has_pts(f)]
+            assert last, g.features
+            for f in last:
+                for p in f.params["pts"]:  # every point inside the part's box (bosses above it)
+                    assert abs(p[0]) <= b["w"] / 2 + 1e-6 and abs(p[1]) <= b["d"] / 2 + 1e-6 and -1e-6 <= p[2] <= b["h"] + 16
+                if f.kind == "shell":
+                    n_shell += 1
+                    assert f.params["t"] > 0
+                else:
+                    v = f.params.get("r", f.params.get("size"))
+                    assert 0.3 <= v
+                n_multi += len(f.params["pts"]) > 1
+    assert n_shell > 50 and n_multi > 100
+
+
+def test_points_selections_are_valid_on_a_solid():
+    st = State(doc_open=True, workbench="PartDesignWorkbench", has_body=True,
+               shape=ShapeInfo(valid=True, volume=1000.0, face_dirs=["+Z", "-Z"]))
+    acts = enumerate_actions(st)
+    assert "Select:Edges@Point" in acts and "Select:Face@Point" in acts
+
+
+def test_train_only_restricts_training_goals(monkeypatch):
+    monkeypatch.setattr(sampler, "TRAIN_ONLY", ("points",))
+    rng = random.Random(9)
+    for level in (1, 2, 3):
+        for _ in range(50):
+            g = sampler.sample_train(level, rng)
+            assert any(pointsel.has_pts(f) for f in g.features)
