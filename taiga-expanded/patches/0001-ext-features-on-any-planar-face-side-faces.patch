+"""Taiga-expanded: extensions to the Taiga-S1 command vocabulary and goal space.
+
+Kept in its own package so the changes to upstream files stay small hooks:
+  faces    features on any planar face (+-X, +-Y, +-Z), not only the top face
+  sampler  goals that use the new features, mixed into the training split and
+           exposed as new evaluation suites (original suites are unchanged)
+Pure stdlib: imported by FreeCAD's interpreter (runtime) and the torch process.
+"""
diff --git a/freecad_s1/ext/faces.py b/freecad_s1/ext/faces.py
new file mode 100644
index 0000000..715c35d
--- /dev/null
+++ b/freecad_s1/ext/faces.py
@@ -0,0 +1,86 @@
+"""Features on any planar face.
+
+A goal feature may carry a support normal (params nx, ny, nz, one of them +-1):
+the sketch then goes on the largest planar face with that outward normal
+(Select:Face+X, Face-Y, ...) instead of the top face. Its centre is given in
+global coordinates (x, y, z); the coordinate along the normal is taken from the
+face itself. Rectangle sizes: w runs along the first in-plane global axis
+(X, then Y, then Z), d along the second. Without a normal, behaviour is the
+original top-face behaviour, bit for bit.
+"""
+from __future__ import annotations
+
+AXIS_NAMES = "XYZ"
+NORMAL_KEYS = ("nx", "ny", "nz")
+
+
+def has_normal(f) -> bool:
+    return any(k in f.params for k in NORMAL_KEYS)
+
+
+def normal(f) -> tuple[int, float]:
+    """(axis index, sign) of the feature's support normal; top face (+Z) by default."""
+    if not has_normal(f):
+        return 2, 1.0
+    vec = [float(f.params.get(k, 0.0)) for k in NORMAL_KEYS]
+    k = max(range(3), key=lambda i: abs(vec[i]))
+    return k, (1.0 if vec[k] >= 0 else -1.0)
+
+
+def face_arg(f) -> str:
+    k, sign = normal(f)
+    return f"Face{'+' if sign > 0 else '-'}{AXIS_NAMES[k]}"
+
+
+def support_for(f, recipe) -> str | None:
+    """Select argument for the sketch support of goal feature `f` (hook used by the expert).
+    Only top-face recipes (Face+Z) are redirected; origin-plane recipes keep their plane."""
+    if recipe.support == "Face+Z" and has_normal(f):
+        return face_arg(f)
+    return recipe.support
+
+
+def inplane_axes(k: int) -> tuple[int, int]:
+    a = [i for i in range(3) if i != k]
+    return a[0], a[1]
+
+
+def local_box(sk, f, sx: float, sy: float, vec_cls):
+    """Sketch-local centre and sizes for a profile on a side face.
+    `sk` is the attached sketch, `sx, sy` the sizes from params.profile_box,
+    `vec_cls` FreeCAD's App.Vector. Returns (centre, size_x, size_y) in sketch coordinates."""
+    k, sign = normal(f)
+    ua, va = inplane_axes(k)
+    n = [0.0, 0.0, 0.0]
+    n[k] = sign
+    nv = vec_cls(*n)
+    d = sk.Placement.Base.dot(nv)  # the sketch plane is {p : p . n = d}
+    c = [float(f.params.get("x", 0.0)), float(f.params.get("y", 0.0)), float(f.params.get("z", 0.0))]
+    c[k] = sign * d
+    inv = sk.Placement.inverse()
+    xs, ys = [], []
+    for du in (-sx / 2, sx / 2):
+        for dv in (-sy / 2, sy / 2):
+            p = list(c)
+            p[ua] += du
+            p[va] += dv
+            q = inv.multVec(vec_cls(*p))
+            xs.append(q.x)
+            ys.append(q.y)
+    centre = vec_cls((min(xs) + max(xs)) / 2, (min(ys) + max(ys)) / 2, 0)
+    return centre, max(xs) - min(xs), max(ys) - min(ys)
+
+
+# goal-feature encoding: extra block appended after upstream's goal numbers, so goals
+# without these keys featurize exactly as before
+EXT_PARAM_KEYS = ["z", "nx", "ny", "nz"]
+EXT_LENGTH_KEYS = {"z"}
+
+
+def extra_goal_num(f, scale: float) -> list[float]:
+    vals, flags = [], []
+    for key in EXT_PARAM_KEYS:
+        v = f.params.get(key)
+        vals.append(0.0 if v is None else max(-8.0, min(8.0, v / scale if key in EXT_LENGTH_KEYS else float(v))))
+        flags.append(float(key in f.params))
+    return vals + flags
diff --git a/freecad_s1/ext/sampler.py b/freecad_s1/ext/sampler.py
new file mode 100644
index 0000000..e8eb6e1
--- /dev/null
+++ b/freecad_s1/ext/sampler.py
@@ -0,0 +1,115 @@
+"""Goals using the expanded features, and how they enter training and evaluation.
+
+Training: the "train" split draws an expanded goal with probability TRAIN_FRACTION
+(env TAIGA_EXT_FRACTION), otherwise the original sampler, so the original
+distribution stays part of training. Evaluation: the original splits (iid, comp*,
+len*) are untouched; new splits are added here (see SPLITS).
+"""
+from __future__ import annotations
+
+import os
+import random
+
+from ..schema import Goal, GoalFeature
+
+TRAIN_FRACTION = float(os.environ.get("TAIGA_EXT_FRACTION", "0.35"))
+
+# split name -> (sampler, evaluation level)
+SPLITS = ("side",)
+
+
+def _u(rng: random.Random, lo: float, hi: float) -> float:
+    return round(rng.uniform(lo, hi), 1)
+
+
+def _side_base(rng: random.Random) -> GoalFeature:
+    # tall enough for features on the side faces
+    return GoalFeature("base_box", {"w": _u(rng, 24, 80), "d": _u(rng, 24, 80), "h": _u(rng, 14, 40)})
+
+
+def side_feature(rng: random.Random, kind: str, base: GoalFeature, face: str) -> GoalFeature | None:
+    """A hole / hole_std / pocket_rect / boss_cyl / boss_box on side `face` (+X, -X, +Y, -Y) of a box base."""
+    p = base.params
+    w, d, h = p["w"], p["d"], p["h"]
+    axis, sign = face[1], (1.0 if face[0] == "+" else -1.0)
+    half_u = d / 2 if axis == "X" else w / 2  # in-plane horizontal half extent
+    depth_room = w if axis == "X" else d  # material behind the face
+    params: dict[str, float] = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+    params["n" + axis.lower()] = sign
+    if kind in ("hole", "hole_std", "boss_cyl"):
+        r = _u(rng, 1.5, max(1.6, min(half_u, h / 2) * 0.35))
+        if 2 * r + 3 > h:
+            return None
+        u = _u(rng, -(half_u - r) * 0.7, (half_u - r) * 0.7)
+        v = _u(rng, r + 1.5, h - r - 1.5)
+        params.update(r=r)
+        if kind == "boss_cyl":
+            params["h"] = _u(rng, 2, 15)
+    else:
+        a = _u(rng, 2, max(2.1, half_u * 0.7))  # along the horizontal in-plane axis
+        b = _u(rng, 2, max(2.1, (h - 3) * 0.6))  # along Z
+        if b + 3 > h:
+            return None
+        u = _u(rng, -(half_u - a / 2) * 0.7, (half_u - a / 2) * 0.7)
+        v = _u(rng, b / 2 + 1.5, h - b / 2 - 1.5)
+        params.update(w=a, d=b)
+        if kind == "boss_box":
+            params["h"] = _u(rng, 2, 15)
+        else:
+            params["depth"] = _u(rng, 1, depth_room * 0.5)
+    # centre in global coordinates; the coordinate along the normal is the face's own
+    if axis == "X":
+        params.update(x=round(sign * w / 2, 1), y=u, z=v)
+    else:
+        params.update(x=u, y=round(sign * d / 2, 1), z=v)
+    return GoalFeature(kind, params)
+
+
+def sample_side_goal(level: int, rng: random.Random) -> Goal:
+    """Box base, 1-2 side features (optionally a top feature from the original
+    vocabulary, a mirrored side boss or pocket), optional top dressup."""
+    from ..goals import _cut_group, _dressup, _scale  # original sampler pieces
+
+    for _ in range(100):
+        base = _side_base(rng)
+        feats = [base]
+        budget = 1 if level <= 2 else 4
+        if level >= 3 and rng.random() < 0.4:
+            group, _ = _cut_group(rng, base)
+            if len(group) <= budget - 1:
+                feats += group
+        n_side = 1 if level <= 2 else rng.choice([1, 1, 2])
+        for _ in range(n_side):
+            if len(feats) - 1 >= budget:
+                break
+            face = rng.choice(["+X", "-X", "+Y", "-Y"])
+            kind = rng.choice(["hole", "hole_std", "pocket_rect", "boss_cyl", "boss_box"])
+            f = side_feature(rng, kind, base, face)
+            if f is None:
+                continue
+            feats.append(f)
+            # mirror across YZ: only for +X bosses/pockets (a through hole mirrors onto itself)
+            if (face == "+X" and kind in ("boss_cyl", "boss_box", "pocket_rect") and len(feats) - 1 < budget
+                    and rng.random() < 0.4):
+                feats.append(GoalFeature("mirror", {}))
+        if len(feats) == 1:
+            continue
+        if level >= 3 and len(feats) - 1 < budget and rng.random() < 0.5:
+            feats.append(_dressup(rng, rng.choice(["fillet_top", "chamfer_top"]), base))
+        return Goal(feats, level=min(level, 3), scale=_scale(base))
+    raise ValueError("could not sample a side goal")
+
+
+def sample_split(split: str, level: int, rng: random.Random) -> Goal:
+    if split == "side":
+        return sample_side_goal(level, rng)
+    raise ValueError(split)
+
+
+def use_expanded_for_train(rng: random.Random) -> bool:
+    return rng.random() < TRAIN_FRACTION
+
+
+def sample_train(level: int, rng: random.Random) -> Goal:
+    """Expanded training goal at `level` (levels 1 stays original: a bare base has no side)."""
+    return sample_side_goal(max(level, 2), rng)
