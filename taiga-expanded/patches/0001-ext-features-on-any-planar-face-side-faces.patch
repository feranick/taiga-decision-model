@@ -0,0 +1,138 @@
+"""taiga-expanded: features on side faces (pure-Python parts; FreeCAD parts in test_ext_runtime.py)."""
+import random
+
+import numpy as np
+
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, sampler
+from freecad_s1.goals import RECIPES, sample_goal, sample_split_goal
+from freecad_s1.model.featurize import encode_state
+from freecad_s1.schema import Goal, GoalFeature, State
+
+
+def _side_goal():
+    base = GoalFeature("base_box", {"w": 40, "d": 30, "h": 20})
+    hole = GoalFeature("hole", {"r": 3, "x": 20, "y": 2, "z": 10, "nx": 1.0, "ny": 0.0, "nz": 0.0})
+    return Goal([base, hole], level=2, scale=40)
+
+
+def test_support_follows_normal():
+    g = _side_goal()
+    assert faces.support_for(g.features[1], RECIPES["hole"]) == "Face+X"
+    top = GoalFeature("hole", {"r": 3, "x": 0, "y": 0})
+    assert faces.support_for(top, RECIPES["hole"]) == "Face+Z"  # unchanged without a normal
+    assert faces.support_for(GoalFeature("base_ring", {}), RECIPES["base_ring"]) == "Plane:XZ"
+    for k, f in (("ny", -1.0), ("nx", -1.0), ("ny", 1.0)):
+        p = {"nx": 0.0, "ny": 0.0, "nz": 0.0, k: f}
+        assert faces.face_arg(GoalFeature("hole", p)) == f"Face{'+' if f > 0 else '-'}{k[1].upper()}"
+
+
+def test_expert_selects_side_face():
+    g = _side_goal()
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    assert expert_actions(g, meta) == ["Select:Face+X"]
+    meta.selection = ["Face+X"]
+    assert expert_actions(g, meta) == ["PartDesign_NewSketch"]
