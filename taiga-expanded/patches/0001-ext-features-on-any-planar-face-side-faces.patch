+class _V:
+    def __init__(self, x=0.0, y=0.0, z=0.0):
+        self.x, self.y, self.z = float(x), float(y), float(z)
+
+    def dot(self, o):
+        return self.x * o.x + self.y * o.y + self.z * o.z
+
+
+class _Placement:
+    """Rotation matrix R (columns = sketch x, y, z axes in global coordinates) + base."""
+
+    def __init__(self, cols, base):
+        self.R = np.array(cols, float).T
+        self.Base = _V(*base)
+
+    def inverse(self):
+        inv = _Placement(np.eye(3), (0, 0, 0))
+        inv.R = self.R.T
+        b = np.array([self.Base.x, self.Base.y, self.Base.z])
+        inv.Base = _V(*(-self.R.T @ b))
+        return inv
+
+    def multVec(self, v):  # noqa: N802 (FreeCAD API name)
+        p = self.R @ np.array([v.x, v.y, v.z]) + np.array([self.Base.x, self.Base.y, self.Base.z])
+        return _V(*p)
+
+
+class _Sketch:
+    def __init__(self, placement):
+        self.Placement = placement
+
+
+def test_local_box_maps_side_face_profiles():
+    # sketch on the +X face at x = 20, sketch axes: x -> global Y, y -> global Z, normal -> +X
+    sk = _Sketch(_Placement([(0, 1, 0), (0, 0, 1), (1, 0, 0)], (20, 5, 0)))
+    f = GoalFeature("pocket_rect", {"w": 8, "d": 4, "x": 20, "y": 3, "z": 10, "depth": 5, "nx": 1.0, "ny": 0.0, "nz": 0.0})
+    c, sx, sy = faces.local_box(sk, f, 8, 4, _V)
+    assert (round(c.x, 6), round(c.y, 6), round(sx, 6), round(sy, 6)) == (-2.0, 10.0, 8.0, 4.0)
+    # rotated sketch frame on -Y face (x -> -X, y -> Z): w still runs along global X
+    sk = _Sketch(_Placement([(-1, 0, 0), (0, 0, 1), (0, -1, 0)], (0, -15, 0)))
+    f = GoalFeature("pocket_rect", {"w": 8, "d": 4, "x": 6, "y": -15, "z": 9, "depth": 5, "nx": 0.0, "ny": -1.0, "nz": 0.0})
+    c, sx, sy = faces.local_box(sk, f, 8, 4, _V)
+    assert (round(c.x, 6), round(c.y, 6), round(sx, 6), round(sy, 6)) == (-6.0, 9.0, 8.0, 4.0)
