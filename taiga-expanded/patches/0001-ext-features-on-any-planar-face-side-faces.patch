+def test_side_goal_features_are_encoded():
+    g = _side_goal()
+    tok = encode_state(State(doc_open=True), g, invariant=True, sentinel=True)
+    from freecad_s1.model.featurize import SEG_GOAL
+    rows = np.flatnonzero(tok.seg == SEG_GOAL)
+    hole_row = tok.num[rows[1]]
+    assert hole_row[29 + 1] == 1.0  # nx
+    assert hole_row[33:37].tolist() == [1.0, 1.0, 1.0, 1.0]  # z, nx, ny, nz present
