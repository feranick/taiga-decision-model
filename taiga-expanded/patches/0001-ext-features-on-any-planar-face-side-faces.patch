+"""taiga-expanded: integration tests against real FreeCAD (skipped when FreeCAD is absent)."""
+import subprocess
+
+import pytest
+
+from freecad_s1.ext import sampler
+from freecad_s1.runtime.fcenv import REPO_ROOT, freecad_available, freecad_env, freecad_python
+
+pytestmark = pytest.mark.skipif(not freecad_available(), reason="FreeCAD not installed")
+
+
+def test_expanded_goals_are_buildable_and_expert_succeeds():
+    py, _ = freecad_python()
+    out = subprocess.run([py, str(REPO_ROOT / "scripts" / "smoke_ext.py"), "8"], env=freecad_env(),
+                         capture_output=True, text=True, timeout=900)
+    stats = dict(line.rsplit(" ", 1) for line in out.stdout.splitlines() if " " in line and not line[0].isdigit())
+    msg = out.stdout + out.stderr[-3000:]
+    for split in sampler.SPLITS:
+        for level in (2, 3):
+            feasible = int(stats.get(f"{split}{level}_feasible", 0))
+            infeasible = int(stats.get(f"{split}{level}_infeasible", 0))
+            assert feasible >= 0.75 * (feasible + infeasible), msg  # the sampler mostly proposes buildable goals
+            n = int(stats[f"{split}{level}_noise0.0_n"])
+            assert int(stats.get(f"{split}{level}_noise0.0_match", 0)) == n, msg  # clean expert always succeeds
+    assert "expert_invalid" not in stats, msg
