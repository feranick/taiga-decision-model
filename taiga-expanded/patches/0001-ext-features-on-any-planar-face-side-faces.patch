+def test_side_sampler_geometry_within_faces():
+    rng = random.Random(1)
+    n_side = 0
+    for _ in range(300):
+        g = sampler.sample_side_goal(3, rng)
+        base = g.features[0].params
+        assert g.features[0].kind == "base_box" and len(g.features) <= 5
+        for f in g.features[1:]:
+            if not faces.has_normal(f):
+                continue
+            n_side += 1
+            k, sign = faces.normal(f)
+            assert k in (0, 1)
+            p = f.params
+            half = {0: base["w"] / 2, 1: base["d"] / 2}
+            assert abs(abs(p["xy"[k]]) - half[k]) < 0.11  # centre lies on the face
+            ext_v = p.get("r", p.get("d", 0) / 2)
+            assert ext_v <= p["z"] <= base["h"] - ext_v  # inside the face height
+    assert n_side >= 300
