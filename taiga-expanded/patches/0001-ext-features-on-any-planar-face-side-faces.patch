@@ -0,0 +1,59 @@
+"""taiga-expanded: expert rollouts (clean + noisy) on the expanded goals, inside FreeCAD.
+Usage (FreeCAD's interpreter): smoke_ext.py [episodes per level] — prints stats, one per line."""
+import collections
+import random
+import sys
+import time
+
+from freecad_s1.ext import sampler
+from freecad_s1.goals import sample_start
+from freecad_s1.runtime.episode import GoalBuildError, build_target, score, step_budget
+from freecad_s1.runtime.session import HeadlessSession
+
+s = HeadlessSession()
+rng = random.Random(0)
+stats = collections.Counter()
+t0, nsteps = time.time(), 0
+n_eps = int(sys.argv[1]) if len(sys.argv) > 1 else 10
+for split in sampler.SPLITS:
+    for level in (2, 3):
+        for _ in range(n_eps):
+            goal = sampler.sample_split(split, level, rng)
+            try:
+                target = build_target(s, goal)
+            except GoalBuildError as exc:
+                stats[f"{split}{level}_infeasible"] += 1
+                print("INFEASIBLE", exc, goal.features, file=sys.stderr)
+                continue
+            stats[f"{split}{level}_feasible"] += 1
+            for noise in (0.0, 0.3):
+                start = sample_start(rng, level)
+                s.reset(goal, start)
+                budget = step_budget(goal, start) * (3 if noise else 1)
+                for _t in range(budget):
+                    st = s.state()
+                    valid = s.valid_actions(st)
+                    exp = s.expert()
+                    if not exp:
+                        stats["unrecoverable"] += 1
+                        break
+                    bad = [a for a in exp if a not in valid]
+                    if bad:
+                        stats["expert_invalid"] += 1
+                        print("EXPERT INVALID", bad, exp, valid, goal.features, file=sys.stderr)
+                        break
+                    a = rng.choice([x for x in valid if x != "Done"]) if rng.random() < noise else exp[0]
+                    info = s.step(a)
+                    nsteps += 1
+                    if info["done"]:
+                        break
+                sc = score(s, target)
+                key = f"{split}{level}_noise{noise}"
+                stats[key + "_n"] += 1
+                stats[key + "_match"] += int(s.done and sc["match"])
+                if noise == 0 and not (s.done and sc["match"]):
+                    print("CLEAN FAIL", goal.features, list(s.recent), sc, file=sys.stderr)
+for k in sorted(stats):
+    print(k, stats[k])
+dt = time.time() - t0
+print(f"{nsteps} steps in {dt:.1f}s = {1000 * dt / max(nsteps, 1):.1f} ms/step")
diff --git a/tests/test_ext_faces.py b/tests/test_ext_faces.py
