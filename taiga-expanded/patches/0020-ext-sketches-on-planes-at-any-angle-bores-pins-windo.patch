+++ b/tests/test_ext_angled.py
@@ -0,0 +1,90 @@
+"""taiga-expanded: sketches on planes at any angle (patch 0020)."""
+import math
+import random
+
+from freecad_s1.evaluate import SUITES
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import angled, faces, profiles, sampler, sizes
+from freecad_s1.goals import RECIPES, SPLITS, sample_split_goal
+from freecad_s1.model.featurize import NUM_DIM, SEG_GOAL, encode_state
+from freecad_s1.schema import Goal, GoalFeature, ShapeInfo, State
+
+BOX = GoalFeature("base_box", {"w": 60, "d": 40, "h": 30})
+C, S = math.cos(math.radians(30)), math.sin(math.radians(30))
+BORE = GoalFeature("hole", {"r": 3.0, "x": 0.0, "y": 0.0, "z": 15.0,
+                            "nx": 0.0, "ny": -S, "nz": C, "ux": 1.0, "uy": 0.0, "uz": 0.0})
+
+
+def _dot(a, b):
+    return sum(x * y for x, y in zip(a, b))
+
+
+def test_frame_is_orthonormal_and_u_is_projected():
+    f = GoalFeature("hole", dict(BORE.params, ux=1.0, uy=0.3, uz=0.2))  # u not perpendicular: projected
+    o, u, v, n = angled.frame(f)
+    assert o == [0.0, 0.0, 15.0]
+    for a in (u, v, n):
