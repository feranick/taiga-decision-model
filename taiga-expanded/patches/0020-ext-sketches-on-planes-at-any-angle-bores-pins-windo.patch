diff --git a/freecad_s1/ext/angled.py b/freecad_s1/ext/angled.py
new file mode 100644
index 0000000..73ac518
--- /dev/null
+++ b/freecad_s1/ext/angled.py
@@ -0,0 +1,190 @@
+"""Sketches on planes at any angle (taiga-expanded, patch 0020).
+
+A sketched intent may lie on a plane at any orientation: params "ux", "uy", "uz" (the plane's
+in-plane x direction) mark it, next to the plane's unit normal (nx, ny, nz; any direction) and
+its origin (x, y, z), the feature's centre. The profile is drawn in the plane's own frame: u
+along (ux, uy, uz), v = n x u; a circle or rectangle is centred on the origin (rectangles: w along
+u, d along v), an outline is written in (u, v) relative to the origin. As on an origin plane with
+an offset (ext.faces), the pad or pocket is extruded symmetrically: h or depth is the total, and
+holes and pockets without depth go through all, both ways. Inclined bores, angled bosses and
+pins, slanted windows and cuts.
+
+The model issues the same commands as for an origin plane (Select:Plane:XY, NewSketch, ...): the
+runtime attaches the sketch to the XY plane with an AttachmentOffset that carries the frame, and
+the sketch's normal is part of the state the model sees. In real parts these sketches are 2 % of
+WHUCAD's hand-built parts and 0.4 % of DeepCAD's designs (docs/README_production_plan.md, 4.4).
+
+Pure stdlib except placement(), which receives FreeCAD's App module.
+"""
+from __future__ import annotations
+
+import math
+import random
+
+from ..schema import Goal, GoalFeature
+
+U_KEYS = ("ux", "uy", "uz")
+N_KEYS = ("nx", "ny", "nz")
+KINDS = ("boss_cyl", "boss_box", "hole", "pocket_rect", "profile_boss", "profile_pocket")
+
+
+def is_angled(f) -> bool:
+    return f is not None and all(k in f.params for k in U_KEYS)
+
+
+def _norm(v):
+    n = math.sqrt(sum(c * c for c in v))
+    return [c / n for c in v] if n > 1e-12 else None
+
+
+def _cross(a, b):
+    return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+
+
+def frame(f) -> tuple[list[float], list[float], list[float], list[float]]:
+    """(origin, u, v, n) of an angled plane, orthonormal: n as given (normalised), u made
+    perpendicular to n, v = n x u. Raises ValueError for a degenerate frame."""
+    p = f.params
+    n = _norm([float(p.get(k, 0.0)) for k in N_KEYS])
+    u = [float(p[k]) for k in U_KEYS]
+    if n is None:
+        raise ValueError("angled plane: zero normal")
+    d = sum(a * b for a, b in zip(u, n))
+    u = _norm([a - d * b for a, b in zip(u, n)])
+    if u is None:
+        raise ValueError("angled plane: u is parallel to the normal")
+    v = _cross(n, u)
+    o = [float(p.get("x", 0.0)), float(p.get("y", 0.0)), float(p.get("z", 0.0))]
+    return o, u, v, n
+
+
+def placement(f, plane_placement, app):
+    """AttachmentOffset for a sketch attached (FlatFace) to `plane_placement`'s plane so that its
+    frame is the intent's: origin at (x, y, z), x along u, normal n."""
+    o, u, v, n = frame(f)
+    m = app.Matrix(u[0], v[0], n[0], 0, u[1], v[1], n[1], 0, u[2], v[2], n[2], 0, 0, 0, 0, 1)
+    target = app.Placement(app.Vector(*o), app.Rotation(m))
+    return plane_placement.inverse().multiply(target)
+
+
+def extra_goal_num(f) -> list[float]:
+    """u (3 numbers) and a flag for the goal encoding; zeros without an angled plane. The normal
+    is already in the encoding (nx, ny, nz), the origin too (x, y, z)."""
+    if not is_angled(f):
+        return [0.0, 0.0, 0.0, 0.0]
+    try:
+        _, u, _, _ = frame(f)
+    except ValueError:
+        return [0.0, 0.0, 0.0, 0.0]
+    return [round(c, 6) for c in u] + [1.0]
+
+
+def validate(f) -> list[str]:
+    """Errors of an angled intent (empty when well formed)."""
+    if not is_angled(f):
+        return []
+    errs = []
+    if f.kind not in KINDS:
+        errs.append(f"{f.kind} cannot be on an angled plane (only {', '.join(KINDS)})")
+    try:
+        frame(f)
+    except ValueError as exc:
+        errs.append(str(exc))
+    if "off" in f.params:
+        errs.append("an angled plane takes its position from x, y, z, not 'off'")
+    return errs
+
+
+# ----------------------------------------------------------------------------- the "angled" family
+
+
+def _r(v: float, k: int = 4) -> float:
+    return round(v, k) + 0.0
+
+
+def _u(rng: random.Random, lo: float, hi: float) -> float:
+    return round(rng.uniform(lo, hi), 1)
+
+
+def _rot(v, axis, deg):
+    """v rotated about the unit `axis` by `deg` degrees (Rodrigues)."""
+    a = math.radians(deg)
+    c, s = math.cos(a), math.sin(a)
+    k = axis
+    kv = sum(x * y for x, y in zip(k, v))
+    kxv = _cross(k, v)
+    return [v[i] * c + kxv[i] * s + k[i] * kv * (1 - c) for i in range(3)]
+
+
+def tilted(rng: random.Random, base_axis: int) -> tuple[list[float], list[float]]:
+    """A normal tilted 15-60 degrees from the base axis about one of the two perpendicular axes,
+    and an in-plane u: the tilt axis (perpendicular to the normal by construction)."""
+    e = [0.0, 0.0, 0.0]
+    e[base_axis] = 1.0
+    t_axis = rng.choice([i for i in range(3) if i != base_axis])
+    t = [0.0, 0.0, 0.0]
+    t[t_axis] = 1.0
+    deg = rng.choice([-1, 1]) * _u(rng, 15, 60)
+    n = _rot(e, t, deg)
+    return [_r(c) for c in n], t
+
+
+def angled_feature(rng: random.Random, kind: str, base: GoalFeature) -> GoalFeature | None:
+    """An angled bore, pin, boss or window through a box or cylinder base: a plane through a point
+    inside the part, tilted 15-60 degrees, the feature extruded both ways."""
+    p = base.params
+    if base.kind == "base_box":
+        hx, hy, h = p["w"] / 2, p["d"] / 2, p["h"]
+    else:
+        hx = hy = p["r"] * 0.7
+        h = p["h"]
+    small = min(2 * hx, 2 * hy, h)
+    if small < 12:
+        return None
+    base_axis = rng.choice([0, 1, 2])
+    n, u = tilted(rng, base_axis)
+    o = [_u(rng, -0.25 * hx, 0.25 * hx), _u(rng, -0.25 * hy, 0.25 * hy), _u(rng, 0.4 * h, 0.6 * h)]
+    through = round(2 * math.sqrt(hx * hx + hy * hy + h * h) + 10, 1)  # longer than the part, both ways
+    params = {"nx": n[0], "ny": n[1], "nz": n[2], "ux": u[0], "uy": u[1], "uz": u[2], "x": o[0], "y": o[1], "z": o[2]}
+    if kind == "hole":
+        params["r"] = _u(rng, 1.5, max(1.6, small * 0.15))
+    elif kind == "boss_cyl":
+        params["r"] = _u(rng, 2.0, max(2.1, small * 0.18))
+        params["h"] = round(through + _u(rng, 4, 20), 1)  # a pin sticking out on both sides
+    elif kind == "pocket_rect":
+        params.update(w=_u(rng, 3, max(3.1, small * 0.35)), d=_u(rng, 2, max(2.1, small * 0.25)), depth=through)
+    else:
+        return None
+    return GoalFeature(kind, params)
+
+
+def sample_angled_goal(level: int, rng: random.Random) -> Goal:
+    """Box or cylinder base, 1-2 features on angled planes (bores, pins, windows), at level 3
+    optionally a top feature group first and a top dressup last."""
+    from ..goals import _base, _cut_group, _dressup, _scale
+
+    for _ in range(100):
+        if rng.random() < 0.7:
+            base = GoalFeature("base_box", {"w": _u(rng, 30, 80), "d": _u(rng, 24, 70), "h": _u(rng, 16, 50)})
+        else:
+            base = _base(rng, ["base_cyl"])
+            base.params["h"] = _u(rng, 16, 45)
+        feats = [base]
+        budget = 1 if level <= 2 else 4
+        if level >= 3 and rng.random() < 0.4:
+            group, _ = _cut_group(rng, base)
+            if len(group) <= budget - 1:
+                feats += group
+        n = 1 if level <= 2 else rng.choice([1, 2])
+        for _ in range(n):
+            if len(feats) - 1 >= budget:
+                break
+            f = angled_feature(rng, rng.choice(["hole", "hole", "boss_cyl", "pocket_rect"]), base)
+            if f is not None:
+                feats.append(f)
+        if not any(is_angled(f) for f in feats):
+            continue
+        if level >= 3 and len(feats) - 1 < budget and rng.random() < 0.3:
+            feats.append(_dressup(rng, "chamfer_top", base))
+        return Goal(feats, level=min(level, 3), scale=_scale(base))
+    raise ValueError("could not sample an angled goal")
