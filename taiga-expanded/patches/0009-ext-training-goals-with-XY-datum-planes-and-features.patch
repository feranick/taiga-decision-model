+def test_overhanging_features_are_wider_than_their_face():
+    rng = random.Random(4)
+    n = 0
+    for _ in range(400):
+        g = sampler.sample_overhang_goal(3, rng)
+        base, second = g.features[0], g.features[1]
+        if base.kind == "base_cyl" and second.kind == "boss_cyl":  # cap over a plug
+            assert second.params["r"] > base.params["r"]
+            n += 1
+        elif base.kind == "base_cyl" and second.kind == "profile_boss":  # flap over a disc
+            _, _, w, d = pr.bbox(second.params["outline"])
+            assert max(w, d) > 2 * base.params["r"]
+            n += 1
+        elif base.kind == "base_box" and second.kind == "profile_boss":  # cover plate over a spigot
+            _, _, w, d = pr.bbox(second.params["outline"])
+            assert w > base.params["w"] and d > base.params["d"]
+            n += 1
+        elif base.kind == "base_box":  # neck, then a wider flange on the neck's end face
+            neck, flange = g.features[1], g.features[2]
+            assert flange.params["r"] > neck.params["r"] and "at" in flange.params
+            n += 1
+    assert n == 400
