+"""taiga-expanded: features on XY datum planes, and features wider than their face (patch 0009)."""
+import random
+
+from freecad_s1.evaluate import SUITES
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, profiles as pr, sampler
+from freecad_s1.goals import RECIPES
+from freecad_s1.schema import Goal
+
+
+def test_new_splits_and_suites():
+    assert sampler.SPLITS[-2:] == ("datum_z", "overhang")
+    assert SUITES["datum_z"] == [(3, "datum_z")] and SUITES["overhang"] == [(3, "overhang")]
+
+
+def test_xy_datum_features_go_on_the_xy_plane():
+    rng = random.Random(1)
+    seen = 0
+    for _ in range(300):
+        g = sampler.sample_datum_z_goal(3, rng)
+        for f in g.features[1:]:
+            if "off" in f.params and f.params.get("nz") == 1.0:
+                seen += 1
+                assert faces.support_for(f, RECIPES[f.kind]) == "Plane:XY"
+                assert f.params["z"] == f.params["off"]
+    assert seen > 250
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    f = next(f for f in sampler.sample_datum_z_goal(3, random.Random(3)).features[1:] if "off" in f.params)
+    assert expert_actions(Goal([sampler._side_base(random.Random(0)), f], level=2, scale=40), meta) == ["Select:Plane:XY"]
