+def test_cavities_stay_inside_the_part():
+    rng = random.Random(2)
+    for _ in range(400):
+        g = sampler.sample_datum_z_goal(3, rng)
+        base = g.features[0]
+        if base.kind == "profile_revolve":
+            continue
+        h = base.params["h"]
+        for f in g.features[1:]:
+            if f.kind in ("pocket_rect", "profile_pocket") and "off" in f.params:
+                wide = f.kind == "pocket_rect" and (base.kind == "base_box" and (f.params["w"] > base.params["w"]
+                                                                                   or f.params["d"] > base.params["d"]))
+                lo, hi = f.params["off"] - f.params["depth"] / 2, f.params["off"] + f.params["depth"] / 2
+                assert 0 < lo and hi < h  # closed top and bottom (a slot through two sides when wider)
+                if not wide and base.kind == "base_box":
+                    assert f.params["w"] < base.params["w"] and f.params["d"] < base.params["d"]
+
