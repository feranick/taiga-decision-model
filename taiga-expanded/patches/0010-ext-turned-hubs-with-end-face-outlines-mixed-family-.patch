diff --git a/tests/test_ext_mixed.py b/tests/test_ext_mixed.py
new file mode 100644
index 0000000..80c0b5f
--- /dev/null
+++ b/tests/test_ext_mixed.py
@@ -0,0 +1,119 @@
+"""taiga-expanded: turned hubs with outline features on the end face, mixed-family goals,
+revolve profiles away from the origin, level-1 expanded bases (patch 0010)."""
+import json
+import math
+import random
+
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, mixed, profiles as pr, revolve as rv, sampler
+from freecad_s1.goals import RECIPES, SPLITS, heldout_composition, sample_split_goal
+from freecad_s1.schema import Goal
+
+
+def _lathe(base):
+    """(along-axis, radius) points of a revolve feature's outline."""
+    axis = rv.axis_index(base)
+    ua, _ = faces.inplane_axes(rv.plane_for_axis(axis))
+    return axis, [(p[0], p[1]) if ua == axis else (p[1], p[0]) for p in pr.polyline(base.params["outline"])]
+
+
+def test_new_splits_are_registered():
+    assert sampler.SPLITS[-2:] == ("turned", "mixed")
+    assert {"turned", "mixed"} <= set(SPLITS)
+
+
+def test_blade_is_a_closed_curved_strip_inside_its_radii():
+    o = mixed.blade(10.0, 30.0, 0.3, 0.9, 3.0)
+    assert pr.is_closed(o)
+    assert [s[0] for s in o["segs"]] == ["S", "L", "S", "L"]
+    radii = [math.hypot(*p) for p in pr.polyline(o)]
+    assert 9.0 < min(radii) and max(radii) < 31.0
+    assert pr.area(o) > 0.5 * 3.0 * 20.0  # roughly thickness x length
+
+
+def test_turned_goals_put_the_outline_on_the_hub_end_face_and_pattern_about_the_axis():
+    rng = random.Random(1)
+    shifted = 0
+    for _ in range(300):
+        g = mixed.sample_turned_goal(3, rng)
+        base, f, pat = g.features[:3]
+        axis, ar = _lathe(base)
+        assert base.kind == "profile_revolve" and f.kind in ("profile_boss", "profile_pocket")
+        assert pat.kind == "polar_pattern" and rv.axis_index(pat) == axis
+        a_end, r_hub = max(a for a, _ in ar), max(r for _, r in ar)
+        shifted += abs(min(a for a, _ in ar)) > 1e-6
+        assert max(math.hypot(*p) for p in pr.polyline(f.params["outline"])) < r_hub
+        if axis == 2:
+            assert not faces.has_normal(f)  # the top face
+        else:
+            assert faces.normal(f) == (axis, 1.0) and f.params["xyz"[axis]] == round(a_end, 1)
+            assert faces.support_for(f, RECIPES[f.kind]) == f"Face+{'XY'[axis]}"
+        assert heldout_composition(g) is None
+    assert 40 < shifted < 160  # about 30 % away from the origin
+
+
+def test_revolve_goals_are_often_away_from_the_origin():
+    rng = random.Random(2)
+    n = 0
+    for _ in range(400):
+        g = sampler.sample_revolve_goal(3, rng)
+        _, ar = _lathe(g.features[0])
+        n += abs(min(a for a, _ in ar)) > 0.25 * g.scale
+    assert 80 < n < 200
+
+
+def test_mixed_goals_are_long_varied_and_never_held_out():
+    rng = random.Random(3)
+    lengths, kinds = [], set()
+    for _ in range(400):
+        g = sample_split_goal("mixed", 3, rng)
+        assert heldout_composition(g) is None
+        assert "boss_box" not in [f.kind for f in g.features]
+        lengths.append(len(g.features))
+        kinds |= {f.kind for f in g.features}
+        for a, b in zip(g.features, g.features[1:]):  # a pattern / mirror copies the feature just before it
+            if b.kind in ("linear_pattern", "mirror", "polar_pattern"):
+                assert a.kind not in ("linear_pattern", "mirror", "polar_pattern", "base_box")
+    assert min(lengths) >= 3 and max(lengths) >= 10 and sum(x >= 6 for x in lengths) > 150
+    assert {"profile_boss", "profile_pocket", "hole_std", "linear_pattern", "mirror"} <= kinds
+    long_ = [len(sample_split_goal("mixed", 4, rng).features) for _ in range(200)]
+    assert min(long_) >= 6 and sum(x >= 9 for x in long_) > 100
+
+
+def test_mixed_side_features_use_distinct_faces():
+    rng = random.Random(4)
+    for _ in range(300):
+        g = sampler.sample_split("mixed", 3, rng)
+        side = [faces.face_arg(f) for f in g.features[1:] if faces.has_normal(f) and not faces.is_datum(f)]
+        assert len(set(side)) == len(side)
+
+
+def test_level1_training_goals_include_lone_expanded_bases():
+    rng = random.Random(5)
+    goals = [sample_split_goal("train", 1, rng) for _ in range(2000)]
+    assert all(len(g.features) == 1 for g in goals)
+    names = [g.features[0].kind for g in goals]
+    assert names.count("profile_revolve") > 60 and names.count("profile_base") > 10
+    assert names.count("base_box") > 300  # upstream's level-1 bases stay most of level 1
+
+
+def test_expert_starts_an_end_face_feature_on_the_end_face():
+    rng = random.Random(7)
+    g = mixed.sample_turned_goal(2, rng)
+    while rv.axis_index(g.features[0]) == 2:
+        g = mixed.sample_turned_goal(2, rng)
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Revolution"] = ObjMeta("Revolution", "feature", goal_ref=0)
+    axis = rv.axis_index(g.features[0])
+    assert expert_actions(Goal(g.features[:2], level=2, scale=g.scale), meta) == [f"Select:Face+{'XY'[axis]}"]
+
+
+def test_goal_file_cli(tmp_path):
+    out = tmp_path / "g.json"
+    mixed.main(["--split", "mixed", "--level", "3", "--n", "5", "--out", str(out)])
+    goals = json.loads(out.read_text())
+    assert len(goals) == 5
+    for spec in goals.values():
+        g = Goal.from_json(spec)
+        assert g.features[0].kind == "base_box" and g.scale > 0
