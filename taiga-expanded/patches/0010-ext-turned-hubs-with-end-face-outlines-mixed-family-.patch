index 0000000..6bb6dfa
--- /dev/null
+++ b/freecad_s1/ext/mixed.py
@@ -0,0 +1,388 @@
+"""Turned parts with outline features on an end face, and mixed-family goals (taiga-expanded, patch 0010).
+
+turned: a hub turned about X, Y or Z (optionally bored, optionally away from the origin along
+        its axis); on its end face a curved blade, curved slot or other outline (boss or
+        pocket) off the axis, polar-patterned about the axis (impeller-like); optionally an
+        axial bore and a bolt circle.
+mixed:  a box base with several feature groups drawn from different families on different
+        regions of the part: top features, rows and mirrors on the top face, side-face
+        features, rows, windows and mirrors, cross bores (datum planes), and a final edge
+        break. Level 3 gives 3-11 intents, level >= 4 8-14 (longer than upstream's training
+        maximum of 5).
+
+Neither family produces a composition upstream holds out (goals.heldout_composition): no
+boss_box at all, no mirrored hole_std, no patterned pocket_rect.
+
+Pure stdlib.
+"""
+from __future__ import annotations
+
+import math
+import random
+
+from ..schema import Goal, GoalFeature
+
+
+def _u(rng: random.Random, lo: float, hi: float) -> float:
+    return round(rng.uniform(lo, hi), 1)
+
+
+def _r3(x: float) -> float:
+    return round(x, 3)
+
+
+# ----------------------------------------------------------------------------- outlines
+
+def blade(r1: float, r2: float, theta0: float, sweep: float, thick: float, n: int = 8) -> dict:
+    """Curved blade between radii r1 < r2 about the in-plane origin: a leading spline and a
+    trailing spline `thick` apart (constant width), joined by straight ends."""
+    def lead(t):
+        r = r1 + (r2 - r1) * t
+        a = theta0 + sweep * t
+        return r, a
+
+    def pt(r, a):
+        return [_r3(r * math.cos(a)), _r3(r * math.sin(a))]
+
+    side = 1.0 if sweep >= 0 else -1.0
+    a_pts = [pt(*lead(i / n)) for i in range(n + 1)]
+    b_pts = []
+    for i in range(n, -1, -1):
+        r, a = lead(i / n)
+        b_pts.append(pt(r, a - side * thick / r))  # trailing side, behind the leading curve
+    return {"start": a_pts[0], "segs": [["S", a_pts[1:]], ["L", *b_pts[0]], ["S", b_pts[1:]], ["L", *a_pts[0]]]}
+
+
+def blade_extent(r1: float, r2: float, sweep: float, thick: float) -> float:
+    """Angle (rad) one blade occupies about the axis."""
+    return abs(sweep) + thick / r1
+
+
+def _offaxis_shape(rng: random.Random, rho: float, half: float, phi: float) -> dict:
+    from .sampler import _shape
+
+    return _shape(rng, rho * math.cos(phi), rho * math.sin(phi), half, half)
+
+
+# ----------------------------------------------------------------------------- turned
+
+def _end_face_params(axis: int, end: float) -> dict:
+    """Support params of a feature on the +axis end face at axial position `end`
+    (axis Z: the top face, no normal; X / Y: side face +X / +Y)."""
+    if axis == 2:
+        return {}
+    p = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+    p[("nx", "ny")[axis]] = 1.0
+    p["xy"[axis]] = round(end, 1)
+    return p
+
+
+def _uv_to_xyz(axis: int, end: float, u: float, v: float) -> dict:
+    """Global centre of an end-face feature from in-plane (u, v) (ext.faces.inplane_axes order)."""
+    from . import faces
+
+    c = [0.0, 0.0, 0.0]
+    c[axis] = end
+    ua, va = faces.inplane_axes(axis)
+    c[ua], c[va] = u, v
+    return {"x": round(c[0], 1), "y": round(c[1], 1), "z": round(c[2], 1)}
+
+
+def _end_outline_feature(kind: str, outline: dict, axis: int, end: float, **extra) -> GoalFeature:
+    from . import profiles as pr
+
+    cu, cv, w, d = pr.bbox(outline)
+    p = {"outline": outline, "w": round(w, 1), "d": round(d, 1), **_end_face_params(axis, end)}
+    if axis == 2:
+        p.update(x=round(cu, 1), y=round(cv, 1))
+    else:
+        p.update({k: v for k, v in _uv_to_xyz(axis, end, cu, cv).items() if k != "xyz"[axis]})
+    p.update(extra)
+    return GoalFeature(kind, p)
+
+
+def _end_hole(axis: int, end: float, r: float, u: float, v: float) -> GoalFeature:
+    p = {"r": round(r, 1), **_end_face_params(axis, end)}
+    if axis == 2:
+        p.update(x=round(u, 1), y=round(v, 1))
+    else:
+        p.update({k: val for k, val in _uv_to_xyz(axis, end, u, v).items() if k != "xyz"[axis]})
+    return GoalFeature("hole", p)
+
+
+def sample_turned_goal(level: int, rng: random.Random) -> Goal:
+    from . import patterns as pt
+    from . import profiles as pr
+    from . import revolve as rv
+
+    for _ in range(200):
+        axis = rng.choice([0, 1, 2])
+        R, L = _u(rng, 20, 50), _u(rng, 6, 25)
+        r_in = _u(rng, 3, R * 0.25) if rng.random() < 0.4 else 0.0
+        shift = 0.0
+        if rng.random() < 0.3:
+            shift = round(rng.choice([1.0, -1.0]) * rng.uniform(0.3, 3.0) * max(2 * R, L), 1)
+        a0, a1 = shift, shift + L
+        base = GoalFeature("profile_revolve", rv.revolve_params(
+            axis, outline=rv.lathe_outline(axis, [(a0, r_in), (a0, R), (a1, R), (a1, r_in)]), angle=360.0))
+        scale = max(2 * R, L)
+        if level <= 1:
+            return Goal([base], level=1, scale=scale)
+        kind = rng.choice(["profile_boss", "profile_boss", "profile_pocket"])
+        lo = max(r_in + 2.0, 0.15 * R)
+        if rng.random() < 0.6:  # curved blade or curved slot
+            r1 = _u(rng, lo, max(lo + 0.1, 0.45 * R))
+            r2 = _u(rng, min(r1 + 0.3 * R, R - 2.0), R - 2.0)
+            if r2 - r1 < 4:
+                continue
+            thick = _u(rng, 1.5, max(1.6, min(0.12 * R, 0.4 * r1)))
+            sweep = rng.choice([1.0, -1.0]) * rng.uniform(0.3, 1.2)
+            ext = blade_extent(r1, r2, sweep, thick)
+            n_max = int(0.85 * 2 * math.pi / ext)
+            if n_max < 3:
+                continue
+            outline = blade(r1, r2, rng.uniform(0, 2 * math.pi), sweep, thick)
+            n = rng.randint(3, min(8, n_max))
+        else:  # another outline shape off the axis
+            n = rng.randint(3, 8)
+            rho = _u(rng, lo + 3, max(lo + 3.1, 0.6 * R))
+            half = min(rho * math.sin(math.pi / n) * 0.6, R - rho - 1.5, rho - lo) * 0.9
+            if half < 1.5:
+                continue
+            outline = _offaxis_shape(rng, rho, half, rng.uniform(0, 2 * math.pi))
+        if pr.area(outline) < 4:
+            continue
+        extra = {"h": _u(rng, 2, 0.6 * R)} if kind == "profile_boss" else {"depth": _u(rng, 1, L * 0.6)}
+        feats = [base, _end_outline_feature(kind, outline, axis, a1, **extra),
+                 GoalFeature("polar_pattern", pt.pattern_params("polar_pattern", axis, rng.choice([1.0, -1.0]),
+                                                                n=float(n), angle=360.0))]
+        if level >= 3:
+            if r_in == 0.0 and rng.random() < 0.5:  # axial bore through the hub
+                feats.append(_end_hole(axis, a1, _u(rng, 1.5, max(1.6, lo * 0.6)), 0.0, 0.0))
+            elif kind == "profile_pocket" and rng.random() < 0.4:  # bolt circle outside the slots
+                rb = _u(rng, min(R - 3.0, 0.8 * R), R - 3.0)
+                r = _u(rng, 1.0, max(1.1, min(2.5, R - rb - 1.0)))
+                if R - rb - r > 0.8:
+                    feats += [_end_hole(axis, a1, r, rb, 0.0),
+                              GoalFeature("polar_pattern", pt.pattern_params("polar_pattern", axis, 1.0,
+                                                                             n=float(rng.randint(3, 8)), angle=360.0))]
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample a turned goal")
+
+
+# ----------------------------------------------------------------------------- mixed
+
+def _top_single(rng, base, xr, yr):
+    """One top-face feature inside x in xr, y in yr (no boss_box)."""
+    from .sampler import _shape, _outline_feature
+
+    h = base.params["h"]
+    kind = rng.choice(["hole", "hole_std", "boss_cyl", "pocket_rect", "outline"])
+    span = min(xr[1] - xr[0], yr[1] - yr[0])
+    cx, cy = (xr[0] + xr[1]) / 2, (yr[0] + yr[1]) / 2
+    if kind in ("hole", "hole_std", "boss_cyl"):
+        r = _u(rng, 1.5, max(1.6, span * 0.2))
+        p = {"r": r, "x": _u(rng, xr[0] + r + 1, max(xr[0] + r + 1.1, xr[1] - r - 1)),
+             "y": _u(rng, yr[0] + r + 1, max(yr[0] + r + 1.1, yr[1] - r - 1))}
+        if kind == "boss_cyl":
+            p["h"] = _u(rng, 2, 15)
+        return [GoalFeature(kind, p)]
+    if kind == "pocket_rect":
+        w, d = _u(rng, 2, max(2.1, (xr[1] - xr[0]) * 0.5)), _u(rng, 2, max(2.1, (yr[1] - yr[0]) * 0.5))
+        return [GoalFeature("pocket_rect", {"w": w, "d": d, "x": round(cx, 1), "y": round(cy, 1),
+                                            "depth": _u(rng, 1, h * 0.6)})]
+    half = max(1.5, span * 0.3)
+    outline = _shape(rng, cx, cy, half, half)
+    if rng.random() < 0.5:
+        return [_outline_feature("profile_boss", outline, h=_u(rng, 2, 12))]
+    return [_outline_feature("profile_pocket", outline, depth=_u(rng, 1, h * 0.6))]
+
+
+def _top_row(rng, base, xr, yr):
+    """A row along +-Y of holes / pins / slots / outline pockets, within x in xr."""
+    from . import patterns as pt
+    from .sampler import _span, _top_feature, _shape, _outline_feature
+
+    h = base.params["h"]
+    kind = rng.choice(["hole", "hole_std", "boss_cyl", "slot_pocket", "outline"])
+    r = _u(rng, 1.5, max(1.6, (xr[1] - xr[0]) * 0.2))
+    sp = _span(rng, yr[0] + r + 1.5, yr[1] - r - 1.5, 2 * r)
+    if sp is None:
+        return None
+    first, length, n, sign = sp
+    x = round((xr[0] + xr[1]) / 2, 1)
+    if kind == "outline":
+        f = _outline_feature(rng.choice(["profile_pocket", "profile_boss"]), _shape(rng, x, first, r, r))
+        f.params.update({"h": _u(rng, 2, 10)} if f.kind == "profile_boss" else {"depth": _u(rng, 1, h * 0.6)})
+    else:
+        f = _top_feature(rng, kind, x, first, r, h)
+    return [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", 1, sign, n=float(n), length=length))]
+
+
+def _top_mirror(rng, base, xr, yr):
+    """A top feature at y > 0 mirrored across XZ (no hole_std: mirrored hole_std is held out)."""
+    from . import patterns as pt
+    from .sampler import _top_feature, _shape, _outline_feature
+
+    h = base.params["h"]
+    y_lo = max(yr[0], 0.0)
+    kind = rng.choice(["hole", "boss_cyl", "pocket_rect", "outline"])
+    r = _u(rng, 1.5, max(1.6, min(xr[1] - xr[0], yr[1] - y_lo) * 0.2))
+    x = round((xr[0] + xr[1]) / 2, 1)
+    y = _u(rng, y_lo + r + 1, max(y_lo + r + 1.1, yr[1] - r - 1))
+    if kind == "pocket_rect":
+        f = GoalFeature("pocket_rect", {"w": round(2 * r, 1), "d": round(r, 1), "x": x, "y": y, "depth": _u(rng, 1, h * 0.6)})
+    elif kind == "outline":
+        f = _outline_feature(rng.choice(["profile_pocket", "profile_boss"]), _shape(rng, x, y, r, r))
+        f.params.update({"h": _u(rng, 2, 10)} if f.kind == "profile_boss" else {"depth": _u(rng, 1, h * 0.6)})
+    else:
+        f = _top_feature(rng, kind, x, y, r, h)
+    return [f, GoalFeature("mirror", pt.pattern_params("mirror", 1))]
+
+
+def _side_group(rng, base, face, faces_free):
+    """Features on one side face: a single feature, a row along the face, a window / outline
+    boss, or a mirror to the opposite face (which then counts as used)."""
+    from . import patterns as pt
+    from .sampler import side_feature, _span, _shape, _outline_feature
+
+    p = base.params
+    w, d, h = p["w"], p["d"], p["h"]
+    axis, sign = face[1], (1.0 if face[0] == "+" else -1.0)
+    k_face = 0 if axis == "X" else 1
+    what = rng.choice(["single", "row", "outline", "mirror"])
+    opposite = ("-" if face[0] == "+" else "+") + axis
+    if what == "mirror" and opposite not in faces_free:
+        what = "single"
+    if what == "outline":
+        half_u = (d if axis == "X" else w) / 2
+        ru, rv = _u(rng, 2, max(2.1, half_u * 0.4)), _u(rng, 2, max(2.1, h * 0.3))
+        cu, cv = _u(rng, -(half_u - ru) * 0.6, (half_u - ru) * 0.6), h / 2
+        params = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+        params["n" + axis.lower()] = sign
+        if axis == "X":
+            params.update(x=round(sign * w / 2, 1), y=round(cu, 1), z=round(cv, 1))
+        else:
+            params.update(x=round(cu, 1), y=round(sign * d / 2, 1), z=round(cv, 1))
+        kind = rng.choice(["profile_pocket", "profile_boss"])
+        params.update({"h": _u(rng, 2, 10)} if kind == "profile_boss" else {"depth": _u(rng, 1, (w if axis == "X" else d) * 0.3)})
+        return [_outline_feature(kind, _shape(rng, cu, cv, ru, rv), **params)], []
+    kinds = ["hole", "hole_std", "boss_cyl", "pocket_rect"] if what == "single" else (
+        ["hole", "hole_std", "boss_cyl"] if what == "row" else ["hole", "boss_cyl", "pocket_rect"])
+    f = side_feature(rng, rng.choice(kinds), base, face)
+    if f is None:
+        return None
+    if what == "single":
+        return [f], []
+    if what == "mirror":
+        return [f, GoalFeature("mirror", pt.pattern_params("mirror", k_face))], [opposite]
+    r = f.params["r"]
+    k = 1 if axis == "X" else 0
+    half = (d if k == 1 else w) / 2
+    sp = _span(rng, -(half - r - 1.5), half - r - 1.5, 2 * r)
+    if sp is None:
+        return [f], []
+    first, length, n, sgn = sp
+    f.params["xyz"[k]] = first
+    return [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", k, sgn, n=float(n), length=length))], []
+
+
+def _cross_group(rng, base):
+    """A cross bore through the part (datum plane), optionally repeated up the height."""
+    from . import patterns as pt
+    from .sampler import datum_feature, _span
+
+    f = datum_feature(rng, "hole", base, rng.choice([0, 1]))
+    if f is None:
+        return None
+    if rng.random() < 0.4:
+        r, h = f.params["r"], base.params["h"]
+        sp = _span(rng, r + 2, h - r - 2, 2 * r)
+        if sp is not None:
+            first, length, n, sign = sp
+            f.params["z"] = first
+            return [f, GoalFeature("linear_pattern", pt.pattern_params("linear_pattern", 2, sign, n=float(n), length=length))]
+    return [f]
+
+
+def sample_mixed_goal(level: int, rng: random.Random) -> Goal:
+    for _ in range(200):
+        base = GoalFeature("base_box", {"w": _u(rng, 40, 95), "d": _u(rng, 30, 80), "h": _u(rng, 16, 45)})
+        w, d, h = base.params["w"], base.params["d"], base.params["h"]
+        if level <= 2:
+            n_groups = 1
+        elif level == 3:
+            n_groups = rng.randint(2, 5)
+        else:
+            n_groups = rng.randint(5, 7)
+        # top regions: the two halves along X (rows and mirrors run along Y inside a half)
+        top_regions = [((-w / 2 + 1.5, -1.5), (-d / 2 + 1.5, d / 2 - 1.5)), ((1.5, w / 2 - 1.5), (-d / 2 + 1.5, d / 2 - 1.5))]
+        rng.shuffle(top_regions)
+        faces_free = ["+X", "-X", "+Y", "-Y"]
+        rng.shuffle(faces_free)
+        cross_free = True
+        top, side, cross = [], [], []
+        for _g in range(n_groups * 3):
+            if len(top) + len(side) + len(cross) >= n_groups:
+                break
+            where = rng.choice(["top", "top", "side", "side", "cross"])
+            if where == "top" and top_regions:
+                xr, yr = top_regions.pop()
+                g = rng.choice([_top_single, _top_row, _top_mirror])(rng, base, xr, yr)
+                if g:
+                    top.append(g)
+            elif where == "side" and faces_free:
+                face = faces_free.pop()
+                out = _side_group(rng, base, face, faces_free)
+                if out:
+                    g, used = out
+                    for u in used:
+                        faces_free.remove(u)
+                    side.append(g)
+            elif where == "cross" and cross_free:
+                cross_free = False
+                g = _cross_group(rng, base)
+                if g:
+                    cross.append(g)
+        groups = top + side + cross
+        if len(groups) < min(n_groups, 2 if level >= 3 else 1):
+            continue
+        feats = [base] + [f for g in groups for f in g]
+        if level >= 3 and rng.random() < 0.2:
+            feats.append(GoalFeature("chamfer_top", {"size": _u(rng, 0.5, 1.0)}))
+        return Goal(feats, level=min(level, 3), scale=max(w, d, h))
+    raise ValueError("could not sample a mixed goal")
+
+
+# ----------------------------------------------------------------------------- goal files
+
+def main(argv: list[str] | None = None) -> None:
+    """Write sampled goals of a split to a goals JSON for build/taiga_build_part.py, e.g. to
+    check with FreeCAD that the teacher builds them:
+        python -m freecad_s1.ext.mixed --split mixed --level 3 --n 200 --out mixed_goals.json
+        python <repo>/build/taiga_build_part.py --goals mixed_goals.json --check"""
+    import argparse
+    import json
+
