+
+    ap = argparse.ArgumentParser(description=main.__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--split", required=True, help="any split of goals.SPLITS, e.g. mixed, turned, revolve, train")
+    ap.add_argument("--level", type=int, default=3)
+    ap.add_argument("--n", type=int, default=100)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    rng = random.Random(args.seed)
+    goals = {}
+    for i in range(args.n):
+        g = sample_split_goal(args.split, args.level, rng)
+        goals[f"{args.split}_L{args.level}_{i:04d}"] = {"features": [{"kind": f.kind, "params": f.params} for f in g.features],
