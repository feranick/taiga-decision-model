diff --git a/tests/test_ext_hollow.py b/tests/test_ext_hollow.py
new file mode 100644
index 0000000..087468a
--- /dev/null
+++ b/tests/test_ext_hollow.py
@@ -0,0 +1,64 @@
+"""taiga-expanded: hollow parts, pads first, then a large cavity (patch 0021)."""
+import random
+
+from freecad_s1.evaluate import SPLIT_SEED_OFFSET, SUITES
+from freecad_s1.ext import faces, hollow, profiles, sampler
+from freecad_s1.goals import SPLITS, sample_split_goal
+from freecad_s1.schema import GOAL_KINDS
+
+PADS = ("boss_box", "boss_cyl")
+CUTS = ("pocket_rect", "profile_pocket")
+
+
+def _goals(n=60, seed=5):
+    rng = random.Random(seed)
+    return [sample_split_goal("hollow", level, rng) for level in (2, 3, 3) for _ in range(n)]
+
+
+def test_family_and_suite_are_registered():
+    assert "hollow" in sampler.SPLITS and "hollow" in SPLITS and SUITES["hollow"] == [(3, "hollow")]
+    assert "hollow" not in sampler.LARGE_EXT_SPLITS  # large_ext keeps its goals
+    assert sampler.TRAIN_WEIGHTS["hollow"] == 1.5
+    assert len(set(SPLIT_SEED_OFFSET.values())) == len(SPLIT_SEED_OFFSET) - 2  # only len and large share iid's 0
+
+
+def test_pads_come_first_then_a_closed_cavity():
+    for g in _goals():
+        kinds = [f.kind for f in g.features]
+        assert kinds[0] in ("base_box", "base_cyl") and all(k in GOAL_KINDS for k in kinds)
+        first_cut = next(i for i, f in enumerate(g.features) if f.kind in CUTS)
+        assert any(k in PADS for k in kinds[1:first_cut])  # at least one pad before the cavity
+        h = g.features[0].params["h"]
+        for f in g.features:
+            if f.kind in CUTS:
+                p = f.params
+                assert faces.is_datum(f) and p["nz"] == 1.0
+                assert p["off"] - p["depth"] / 2 >= 0.9 and p["off"] + p["depth"] / 2 <= h - 0.9  # closed
+
+
+def test_flange_pads_stick_out_of_one_side_only():
+    n = 0
+    for g in _goals():
+        base = g.features[0]
+        for f in g.features[1:]:
+            if f.kind in PADS and faces.is_datum(f):
+                n += 1
+                k = 0 if f.params["nx"] == 1.0 else 1
+                along = hollow._extent(base, k)
+                c, L = f.params["off"], f.params["h"]
+                inner, outer = sorted((abs(c) - L / 2, abs(c) + L / 2))
+                assert outer > along and -along < inner < along  # out on one side, inner end inside
+    assert n >= 60
+
+
+def test_the_part_stays_well_over_its_target_after_the_pads():
+    for g in _goals(30):
+        base = g.features[0]
+        body = hollow._volume(base)
+        removed = 0.0
+        for f in g.features[1:]:
+            if f.kind in CUTS:
+                p = f.params
+                area = p["w"] * p["d"] if f.kind == "pocket_rect" else abs(profiles.area(p["outline"]))
+                removed += area * p["depth"]
+        assert body / (body - min(removed, 0.95 * body)) >= hollow.MIN_RATIO  # the cavities remove a large share
-- 
2.34.1

