diff --git a/tests/test_ext_draft.py b/tests/test_ext_draft.py
new file mode 100644
index 0000000..356bcec
--- /dev/null
+++ b/tests/test_ext_draft.py
@@ -0,0 +1,86 @@
+"""taiga-expanded: draft angles on side faces (patch 0022)."""
+import math
+import random
+
+from freecad_s1.actions import ACTION_IDS, CATALOGUE, action_vector, enumerate_actions
+from freecad_s1.evaluate import SUITES
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import draft, faces, sampler, sizes
+from freecad_s1.goals import RECIPES, SPLITS, sample_split_goal
+from freecad_s1.runtime import params as P
+from freecad_s1.schema import GOAL_KINDS, Goal, GoalFeature, ShapeInfo, State
+
+BOX = GoalFeature("base_box", {"w": 60, "d": 40, "h": 30})
+DRAFT = GoalFeature("draft", {"angle": 5.0})
+
+
+def _meta(selection=()):
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    meta.objects["Pad"] = ObjMeta("Pad", "feature", goal_ref=0)
+    meta.selection = list(selection)
+    return meta
+
+
+def test_kind_selection_and_recipe():
+    assert GOAL_KINDS[-1] == "draft" and RECIPES["draft"].feature == "PartDesign_Draft"
+    assert "Select:Faces|Z" in ACTION_IDS and CATALOGUE["Select:Faces|Z"].category == "select"
+    assert action_vector("Select:Faces|Z") == [0.0, 0.0, 1.0, 0.0, 1.0, 0.0]  # Z, a face selection
+    st = State(doc_open=True, workbench="PartDesignWorkbench", has_body=True,
+               shape=ShapeInfo(valid=True, volume=1.0, face_dirs=["+Z", "-Z", "|Z"]))
+    assert "Select:Faces|Z" in enumerate_actions(st)
+
+
+def test_expert_selects_the_side_faces_then_drafts():
+    goal = Goal([BOX, DRAFT], level=2, scale=60)
+    assert expert_actions(goal, _meta()) == ["Select:Faces|Z"]
+    assert expert_actions(goal, _meta(["Faces|Z"]))[0] == "PartDesign_Draft"
+    by_pts = GoalFeature("draft", {"angle": 3.0, "pts": [[30.0, 0.0, 15.0]]})
+    assert expert_actions(Goal([BOX, by_pts], level=2, scale=60), _meta()) == ["Select:Face@Point"]
+
+
+def test_angle_reaches_the_executor_and_the_encoding():
+    assert P.dressup_value(DRAFT, "PartDesign_Draft") == 5.0
+    assert P.dressup_value(BOX, "PartDesign_Draft") == 3.0  # upstream's distractor value, unchanged
+    num = faces.extra_goal_num(DRAFT, 60.0)
+    assert len(num) == faces.EXT_NUM_DIM and abs(num[17] - 5.0 / 360) < 1e-9 and num[16] == 1.0
+    assert draft.validate(DRAFT) == [] and draft.validate(GoalFeature("draft", {"angle": 45.0}))
+    assert sizes.scale_goal(Goal([BOX, DRAFT], level=2, scale=60), 3.0).features[1].params["angle"] == 5.0
+
+
+class _Obj:
+    def __init__(self, **kw):
+        self.__dict__.update(kw)
+
+
+def test_configure_sets_plane_direction_and_angle():
+    feat = _Obj(Angle=3.0)
+    draft.configure(feat, DRAFT, lambda role: role)
+    assert feat.Angle == 5.0 and feat.NeutralPlane == ("XY_Plane", [""]) and feat.PullDirection == ("Z_Axis", [""])
+    other = _Obj(Angle=3.0)
+    draft.configure(other, BOX, lambda role: role)
+    assert other.__dict__ == {"Angle": 3.0}
+
+
+def test_family_suite_and_feasible_angles():
+    assert "draft" in sampler.SPLITS and "draft" in SPLITS and SUITES["draft"] == [(3, "draft")]
+    assert "draft" not in sampler.LARGE_EXT_SPLITS
+    rng = random.Random(3)
+    n_pts = n_boss = 0
+    for level in (2, 3, 3, 3):
+        for _ in range(50):
+            g = sample_split_goal("draft", level, rng)
+            kinds = [f.kind for f in g.features]
+            assert kinds[0] in ("base_box", "base_cyl", "base_hex", "profile_base") and kinds.count("draft") == 1
+            d = g.features[kinds.index("draft")]
+            assert 1.0 <= d.params["angle"] <= 10.0 and draft.validate(d) == []
+            h = g.features[0].params["h"]
+            t = math.tan(math.radians(d.params["angle"]))
+            for f in g.features[1:kinds.index("draft")]:
+                n_boss += 1
+                half = f.params["r"] if f.kind == "boss_cyl" else min(f.params["w"], f.params["d"]) / 2
+                assert (h + f.params["h"]) * t <= 0.5 * half + 0.06  # the boss keeps half its size
+            n_pts += "pts" in d.params
+            if g.features[0].kind == "profile_base":
+                assert all(s[0] in ("L", "A") for s in g.features[0].params["outline"]["segs"])  # no splines
+    assert n_pts >= 5 and n_boss >= 30
