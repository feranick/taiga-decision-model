new file mode 100644
index 0000000..bbfc82a
--- /dev/null
+++ b/freecad_s1/ext/draft.py
@@ -0,0 +1,170 @@
+"""Draft angles (taiga-expanded, patch 0022).
+
+Cast and moulded parts taper their side faces so they leave the mould: the S 80 casing, covers
+and brackets are castings. An intent "draft" tapers faces by "angle" (degrees, 0.5-20) about the
+XY plane (z = 0, the part's base), pulled along +Z: an outer face leans inward going up, so the
+part narrows towards its top, as build123d-translator's draft does. Which faces:
+  - all side faces (planar faces parallel to Z, and cylinders about Z) by default: the model
+    issues Select:Faces|Z;
+  - or the faces named by points, "pts": [[x, y, z], ...], one point on each (Select:Face@Point,
+    patch 0019).
+The model then issues PartDesign_Draft (an upstream command, until now only a distractor with a
+fixed 3 degrees); the runtime sets the angle, the neutral plane and the pull direction.
+
+The family "draft": a box, cylinder, hexagon or outline base, optionally bosses on top, the draft
+(all side faces, or one or two faces of a box by points) and optionally a bore through it after.
+Pure stdlib except faces_parallel_z() and configure(), which receive FreeCAD objects.
+"""
+from __future__ import annotations
+
+import math
+import random
+
+from ..schema import Goal, GoalFeature
+
+KIND = "draft"
+SELECT = "Faces|Z"  # appended to the action catalogue
+MIN_ANGLE, MAX_ANGLE = 0.5, 20.0
+
+
+def is_draft(f) -> bool:
+    return f is not None and f.kind == KIND
+
+
+def angle(f) -> float:
+    return float(f.params.get("angle", 3.0))
+
+
+def extra_goal_num(f) -> list[float]:
+    """For the goal encoding, in the axis / angle block (ext.revolve): the pull direction (+Z)
+    and angle / 360."""
+    return [0.0, 0.0, 1.0, angle(f) / 360.0]
+
+
+def validate(f) -> list[str]:
+    if not is_draft(f):
+        return []
+    a = f.params.get("angle")
+    if not isinstance(a, (int, float)) or not (MIN_ANGLE <= a <= MAX_ANGLE):
+        return [f"draft: 'angle' must be a number of degrees in [{MIN_ANGLE}, {MAX_ANGLE}]"]
+    return []
+
+
+def faces_parallel_z(shape, tol: float = 1e-6) -> list[str]:
+    """Names of the side faces for Select:Faces|Z: planar faces whose normal is horizontal and
+    cylinders whose axis is vertical (runtime hook)."""
+    out = []
+    for i, face in enumerate(shape.Faces):
+        s = face.Surface
+        kind = type(s).__name__
+        if kind == "Plane":
+            u0, u1, v0, v1 = face.ParameterRange
+            n = face.normalAt((u0 + u1) / 2, (v0 + v1) / 2)
+            if abs(n.z) < tol:
+                out.append(f"Face{i + 1}")
+        elif kind == "Cylinder" and abs(abs(s.Axis.z) - 1) < tol:
+            out.append(f"Face{i + 1}")
+    return out
+
+
+def configure(feat, f, origin_feature) -> None:
+    """Hook in the dressup executor for PartDesign_Draft: angle, neutral plane (XY) and pull
+    direction (+Z) from a draft intent. Other intents keep upstream's behaviour."""
+    if not is_draft(f):
+        return
+    feat.Angle = angle(f)
+    feat.NeutralPlane = (origin_feature("XY_Plane"), [""])
+    feat.PullDirection = (origin_feature("Z_Axis"), [""])
+    feat.Reversed = False
+
+
+# ----------------------------------------------------------------------------- the "draft" family
+
+
+def _u(rng: random.Random, lo: float, hi: float) -> float:
+    return round(rng.uniform(lo, hi), 1)
+
+
+def _base(rng: random.Random):
+    """(base feature, half extents of its footprint (hx, hy), height)."""
+    from . import profiles as pr
+    from .sampler import _outline_feature
+
+    r = rng.random()
+    h = _u(rng, 10, 40)
+    if r < 0.4:
+        w, d = _u(rng, 24, 80), _u(rng, 24, 80)
+        return GoalFeature("base_box", {"w": w, "d": d, "h": h}), (w / 2, d / 2), h
+    if r < 0.6:
+        rad = _u(rng, 12, 40)
+        return GoalFeature("base_cyl", {"r": rad, "h": h}), (rad * 0.7, rad * 0.7), h
+    if r < 0.75:
+        rad = _u(rng, 12, 40)
+        return GoalFeature("base_hex", {"r": rad, "h": h}), (rad * 0.6, rad * 0.6), h
+    w, d = _u(rng, 24, 80), _u(rng, 24, 70)
+    kind = rng.choice(["rounded_rect", "slot", "polygon", "d_shape"])  # no splines: draft needs planes / cylinders
+    m = min(w, d)
+    if kind == "rounded_rect":
+        outline = pr.rounded_rect(0.0, 0.0, w, d, _u(rng, 0.1, 0.4) * m / 2)
+        half = (w / 2 * 0.8, d / 2 * 0.8)
+    elif kind == "slot":
+        outline = pr.slot(0.0, 0.0, max(w, d), m * 0.6)
+        half = (max(w, d) / 2 * 0.5, m * 0.3 * 0.6)
+    elif kind == "polygon":
+        outline = pr.polygon(0.0, 0.0, m / 2, rng.choice([5, 6, 8]))
+        half = (m / 2 * 0.55, m / 2 * 0.55)
+    else:
+        outline = pr.d_shape(0.0, 0.0, m / 2, _u(rng, 0.3, 0.7) * m / 2)
+        half = (m / 2 * 0.45, m / 2 * 0.45)
+    return _outline_feature("profile_base", outline, h=h), half, h
+
+
+def _boss(rng: random.Random, xr, yr):
+    """A boss on top inside x in xr, y in yr: (feature, half size)."""
+    span = min(xr[1] - xr[0], yr[1] - yr[0])
+    if span < 6:
+        return None
+    hb = _u(rng, 3, 15)
+    if rng.random() < 0.5:
+        r = _u(rng, 3, max(3.1, span * 0.35))
+        return GoalFeature("boss_cyl", {"r": r, "x": _u(rng, xr[0] + r, max(xr[0] + r + 0.1, xr[1] - r)),
+                                        "y": _u(rng, yr[0] + r, max(yr[0] + r + 0.1, yr[1] - r)), "h": hb}), r
+    w, d = _u(rng, 6, max(6.1, (xr[1] - xr[0]) * 0.7)), _u(rng, 6, max(6.1, (yr[1] - yr[0]) * 0.7))
+    return GoalFeature("boss_box", {"w": w, "d": d, "x": round((xr[0] + xr[1]) / 2, 1),
+                                    "y": round((yr[0] + yr[1]) / 2, 1), "h": hb}), min(w, d) / 2
+
+
+def sample_draft_goal(level: int, rng: random.Random) -> Goal:
+    from .goalsfile import goal_scale
+
+    for _ in range(200):
+        base, (hx, hy), h = _base(rng)
+        feats = [base]
+        limits = [0.35 * min(hx, hy) / h]  # tan of the largest angle the base takes
+        if level >= 3 and rng.random() < 0.6:
+            regions = [((-hx * 0.55, -1.5), (-hy * 0.55, hy * 0.55)), ((1.5, hx * 0.55), (-hy * 0.55, hy * 0.55))]  # inside the narrowed top
+            rng.shuffle(regions)
+            for xr, yr in regions[:rng.choice([1, 2])]:
+                b = _boss(rng, xr, yr)
+                if b is None:
+                    continue
+                f, half = b
+                feats.append(f)
+                limits.append(0.5 * half / (h + f.params["h"]))  # the boss narrows over its full height
+        tmax = math.degrees(math.atan(min(limits)))
+        if tmax < 1.0:
+            continue
+        params = {"angle": _u(rng, 1.0, min(tmax, 10.0))}
+        if base.kind == "base_box" and rng.random() < 0.3:  # one or two faces of the box, named by points
+            p = base.params
+            sides = [[p["w"] / 2, 0.0, h / 2], [-p["w"] / 2, 0.0, h / 2], [0.0, p["d"] / 2, h / 2], [0.0, -p["d"] / 2, h / 2]]
+            rng.shuffle(sides)
+            params["pts"] = [[round(c, 3) for c in q] for q in sides[:rng.choice([1, 2])]]
+        feats.append(GoalFeature(KIND, params))
+        if level >= 3 and rng.random() < 0.4:  # a bore through the drafted part
+            r = _u(rng, 1.5, max(1.6, min(hx, hy) * 0.25))
+            if not any(f.kind in ("boss_cyl", "boss_box") and abs(f.params["x"]) < r + 8 and abs(f.params["y"]) < r + 8
+                       for f in feats):
+                feats.append(GoalFeature("hole", {"r": r, "x": 0.0, "y": 0.0}))
+        return Goal(feats, level=min(level, 3), scale=goal_scale([base]))
+    raise ValueError("could not sample a draft goal")
