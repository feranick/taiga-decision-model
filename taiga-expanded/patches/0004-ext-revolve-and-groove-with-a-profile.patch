new file mode 100644
index 0000000..8bb8b03
--- /dev/null
+++ b/freecad_s1/ext/revolve.py
@@ -0,0 +1,88 @@
+"""Revolve and groove with a profile.
+
+profile_revolve (additive, PartDesign_Revolution) and profile_groove (subtractive,
+PartDesign_Groove) turn a closed outline (ext.profiles) around a global axis through the
+origin. The outline is sketched on an origin plane that contains the axis, given like a
+datum feature (ext.faces): normal (nx, ny, nz) and "off": 0. The axis is (ax, ay, az), one
+of them 1, and "angle" (degrees, default 360) the sweep.
+
+Outlines are written in the plane's (u, v) coordinates (ext.faces convention). Helpers
+below build them from (along-axis, radius) pairs, so a turned part is described like a
+lathe drawing: radius >= 0, the axis is r = 0.
+
+Pure stdlib except set_axis(), which works on FreeCAD objects passed in.
+"""
+from __future__ import annotations
+
+from . import faces
+
+AXIS_KEYS = ("ax", "ay", "az")
+REVOLVE_KINDS = ("profile_revolve", "profile_groove")
+
+
+def has_axis(f) -> bool:
+    return any(k in f.params for k in AXIS_KEYS)
+
+
+def axis_index(f) -> int:
+    vec = [abs(float(f.params.get(k, 0.0))) for k in AXIS_KEYS]
+    return max(range(3), key=lambda i: vec[i])
+
+
+def angle(f) -> float:
+    return float(f.params.get("angle", 360.0))
+
+
+def plane_for_axis(axis: int) -> int:
+    """Normal (axis index) of the origin plane used to sketch a profile turned about `axis`:
+    Z -> XZ plane (normal Y), X -> XZ plane (normal Y), Y -> YZ plane (normal X)."""
+    return 0 if axis == 1 else 1
+
+
+def to_uv(axis: int, a: float, r: float) -> tuple[float, float]:
+    """(along-axis a, radius r) -> (u, v) on the plane from plane_for_axis(axis)."""
+    k = plane_for_axis(axis)
+    ua, va = faces.inplane_axes(k)  # global axes of u and v
+    return (a, r) if ua == axis else (r, a)
+
+
+def lathe_outline(axis: int, pts_ar: list[tuple[float, float]]) -> dict:
+    """Closed outline from (a, r) points (lines between them, closed back to the first)."""
+    uv = [list(map(lambda x: round(x, 3), to_uv(axis, a, r))) for a, r in pts_ar]
+    return {"start": uv[0], "segs": [["L", *p] for p in uv[1:]] + [["L", *uv[0]]]}
+
+
+def revolve_params(axis: int, **extra) -> dict:
+    """Common params of a revolve/groove feature turned about global `axis` (0, 1, 2)."""
+    k = plane_for_axis(axis)
+    p = {"nx": 0.0, "ny": 0.0, "nz": 0.0, "off": 0.0, "ax": 0.0, "ay": 0.0, "az": 0.0}
+    p[("nx", "ny", "nz")[k]] = 1.0
+    p[AXIS_KEYS[axis]] = 1.0
+    p.update(x=0.0, y=0.0, z=0.0)
+    p.update(extra)
+    return p
+
+
+def set_axis(feat, sk, f, vec_cls) -> None:
+    """Revolution/Groove hook: revolve about the sketch axis that runs along the intent's
+    global axis (H_Axis or V_Axis), with the intent's angle. Intents without an axis keep
+    upstream's behaviour (V_Axis, 360)."""
+    if f is None or not has_axis(f):
+        return
+    k = axis_index(f)
+    rot = sk.Placement.Rotation
+    xdir, ydir = rot.multVec(vec_cls(1, 0, 0)), rot.multVec(vec_cls(0, 1, 0))
+    if abs((xdir.x, xdir.y, xdir.z)[k]) > 0.99:
+        feat.ReferenceAxis = (sk, ["H_Axis"])
+    elif abs((ydir.x, ydir.y, ydir.z)[k]) > 0.99:
+        feat.ReferenceAxis = (sk, ["V_Axis"])
+    feat.Angle = angle(f)
+
+
+def extra_goal_num(f) -> list[float]:
+    """Axis (ax, ay, az) and angle / 360 for the goal encoding (zeros without an axis)."""
+    if not has_axis(f):
+        return [0.0, 0.0, 0.0, 0.0]
+    vec = [0.0, 0.0, 0.0]
+    vec[axis_index(f)] = 1.0
+    return vec + [angle(f) / 360.0]
