+def test_axis_and_angle_are_encoded():
+    f = _shaft(0)
+    f.params["angle"] = 180.0
+    tok = encode_state(State(doc_open=True), Goal([f], level=1, scale=40), invariant=True, sentinel=True)
+    row = tok.num[np.flatnonzero(tok.seg == SEG_GOAL)[0]]
+    assert row[43:47].tolist() == [1.0, 0.0, 0.0, 0.5]
