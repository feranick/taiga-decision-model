+def test_revolve_sampler_profiles_stay_off_the_negative_radius_side():
+    rng = random.Random(6)
+    for _ in range(300):
+        g = sampler.sample_revolve_goal(3, rng)
+        for f in g.features:
+            if f.kind not in rv.REVOLVE_KINDS:
+                continue
+            k = rv.axis_index(f)
+            o = f.params["outline"]
+            assert pr.is_closed(o)
+            radial = [u if rv.to_uv(k, 0, 1) == (1, 0) else v for u, v in pr.polyline(o)]
+            assert min(radial) >= -1e-9  # never crosses the axis: a valid revolve
+        assert g.features[0].kind == "profile_revolve"
