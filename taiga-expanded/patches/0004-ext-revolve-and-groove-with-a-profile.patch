diff --git a/tests/test_ext_revolve.py b/tests/test_ext_revolve.py
new file mode 100644
index 0000000..c8fda00
--- /dev/null
+++ b/tests/test_ext_revolve.py
@@ -0,0 +1,97 @@
+"""taiga-expanded: revolve / groove with a profile (patch 0004), pure-Python parts."""
+import random
+
+import numpy as np
+
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, profiles as pr, revolve as rv, sampler
+from freecad_s1.goals import RECIPES
+from freecad_s1.model.featurize import SEG_GOAL, encode_state
+from freecad_s1.schema import GOAL_KINDS, Goal, GoalFeature, State
+
+
+def _shaft(axis=2):
+    pts = [(0, 0), (0, 10), (20, 10), (20, 6), (40, 6), (40, 0)]
+    return GoalFeature("profile_revolve", rv.revolve_params(axis, outline=rv.lathe_outline(axis, pts), angle=360.0))
+
+
+def test_kinds_recipes_and_plane():
+    assert GOAL_KINDS[-2:] == ["profile_revolve", "profile_groove"]
+    assert RECIPES["profile_revolve"].feature == "PartDesign_Revolution"
+    assert RECIPES["profile_groove"].feature == "PartDesign_Groove"
+    assert faces.support_for(_shaft(2), RECIPES["profile_revolve"]) == "Plane:XZ"
+    assert faces.support_for(_shaft(0), RECIPES["profile_revolve"]) == "Plane:XZ"
+    assert faces.support_for(_shaft(1), RECIPES["profile_revolve"]) == "Plane:YZ"
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    assert expert_actions(Goal([_shaft(2)], level=1, scale=40), meta) == ["Select:Plane:XZ"]
+
+
+def test_lathe_outline_maps_axis_and_radius():
+    # about Z on the XZ plane: u = X = radius, v = Z = along the axis
+    o = rv.lathe_outline(2, [(0, 0), (0, 10), (30, 10), (30, 0)])
+    assert pr.bbox(o) == (5.0, 15.0, 10.0, 30.0)
+    # about X on the XZ plane: u = X = along, v = Z = radius
+    o = rv.lathe_outline(0, [(0, 0), (0, 10), (30, 10), (30, 0)])
+    assert pr.bbox(o) == (15.0, 5.0, 30.0, 10.0)
+    # about Y on the YZ plane: u = Y = along, v = Z = radius
+    o = rv.lathe_outline(1, [(0, 0), (0, 10), (30, 10), (30, 0)])
+    assert pr.bbox(o) == (15.0, 5.0, 30.0, 10.0)
+
+
+class _V:
+    def __init__(self, x=0.0, y=0.0, z=0.0):
+        self.x, self.y, self.z = float(x), float(y), float(z)
+
+
+class _Rot:
+    def __init__(self, cols):
+        self.R = np.array(cols, float).T
+
+    def multVec(self, v):  # noqa: N802
+        return _V(*(self.R @ np.array([v.x, v.y, v.z])))
+
+
+class _Sk:
+    def __init__(self, cols):
+        self.Placement = type("P", (), {"Rotation": _Rot(cols)})()
+
+
+class _Feat:
+    ReferenceAxis = None
+    Angle = None
+
+
+def test_set_axis_picks_the_sketch_axis_along_the_global_axis():
+    xz = [(1, 0, 0), (0, 0, 1), (0, -1, 0)]  # XZ plane: sketch x -> X, y -> Z
+    yz = [(0, 1, 0), (0, 0, 1), (1, 0, 0)]  # YZ plane: sketch x -> Y, y -> Z
+    for cols, axis, expected in ((xz, 2, "V_Axis"), (xz, 0, "H_Axis"), (yz, 1, "H_Axis")):
+        sk, feat = _Sk(cols), _Feat()
+        rv.set_axis(feat, sk, _shaft(axis), _V)
+        assert feat.ReferenceAxis == (sk, [expected]) and feat.Angle == 360.0
+    feat = _Feat()
+    rv.set_axis(feat, _Sk(xz), GoalFeature("base_ring", {"ri": 5, "ro": 10, "h": 5}), _V)  # upstream kind: untouched
+    assert feat.ReferenceAxis is None
