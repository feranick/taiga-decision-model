-SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _outline_split}
+def sample_revolve_goal(level: int, rng: random.Random) -> Goal:
+    """Turned parts: a stepped profile revolved about Z (mostly), X or Y, optionally hollow;
+    then ring grooves, a revolved collar, an axial hole and a top chamfer (Z parts)."""
+    from . import revolve as rv
+
+    for _ in range(100):
+        axis = rng.choice([2, 2, 2, 0, 1])
+        n_steps = rng.randint(1, 3)
+        lengths = [_u(rng, 6, 30) for _ in range(n_steps)]
+        radii = [_u(rng, 8, 35) for _ in range(n_steps)]
+        r_in = _u(rng, 2, min(radii) - 4) if rng.random() < 0.3 and min(radii) > 7 else 0.0
+        pts, a = [(0.0, r_in), (0.0, radii[0])], 0.0
+        for i, (ln, r) in enumerate(zip(lengths, radii)):
+            a += ln
+            pts.append((a, r))
+            if i + 1 < n_steps:
+                pts.append((a, radii[i + 1]))
+        pts.append((a, r_in))
+        total = a
+        base = GoalFeature("profile_revolve", rv.revolve_params(axis, outline=rv.lathe_outline(axis, pts), angle=360.0))
+        feats = [base]
+        r_max = max(radii)
+
+        def top_ok(fs):
+            # "Face+Z" picks the largest +Z face: make sure that is the end face (widest step on
+            # top, no collar yet), solid so an axial hole has material to cut
+            return r_in == 0.0 and radii[-1] >= r_max and not any(x.kind == "profile_revolve" for x in fs[1:])
+
+        budget = 1 if level <= 2 else 4
+        n_extra = 1 if level <= 2 else rng.randint(1, 3)
+        for _ in range(n_extra):
+            if len(feats) - 1 >= budget:
+                break
+            what = rng.choice(["groove", "groove", "collar", "hole"] if axis == 2 else ["groove", "groove", "collar"])
+            if what == "groove":
+                i = rng.randrange(n_steps)
+                a0 = sum(lengths[:i])
+                w = _u(rng, 1.5, max(1.6, min(6.0, lengths[i] * 0.4)))
+                if lengths[i] < w + 3:
+                    continue
+                ag = _u(rng, a0 + w / 2 + 1.5, a0 + lengths[i] - w / 2 - 1.5)
+                depth = _u(rng, 1.0, max(1.1, (radii[i] - r_in) * 0.35))
+                ring = [(ag - w / 2, radii[i] - depth), (ag + w / 2, radii[i] - depth),
+                        (ag + w / 2, radii[i] + 2), (ag - w / 2, radii[i] + 2)]
+                feats.append(GoalFeature("profile_groove", rv.revolve_params(axis, outline=rv.lathe_outline(axis, ring),
+                                                                             angle=360.0)))
+            elif what == "collar":
+                i = rng.randrange(n_steps)
+                a0 = sum(lengths[:i])
+                w = _u(rng, 2, max(2.1, lengths[i] * 0.5))
+                ac = _u(rng, a0 + w / 2, a0 + lengths[i] - w / 2)
+                r_out = radii[i] + _u(rng, 2, 10)
+                r_max = max(r_max, r_out)
+                collar = [(ac - w / 2, max(r_in, radii[i] - 2)), (ac + w / 2, max(r_in, radii[i] - 2)),
+                          (ac + w / 2, r_out), (ac - w / 2, r_out)]
+                feats.append(GoalFeature("profile_revolve", rv.revolve_params(axis, outline=rv.lathe_outline(axis, collar),
+                                                                              angle=360.0)))
+            elif top_ok(feats):  # axial hole through the top face of a part turned about Z
+                r_top = radii[-1]
+                feats.append(GoalFeature("hole", {"r": _u(rng, 1.5, max(1.6, r_top * 0.35)), "x": 0.0, "y": 0.0}))
+        if axis == 2 and level >= 3 and len(feats) - 1 < budget and top_ok(feats) and rng.random() < 0.6:
+            feats.append(GoalFeature("chamfer_top", {"size": _u(rng, 0.5, 1.5)}))
+        scale = max(2 * r_max, total)
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample a revolve goal")
+
+
+SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _outline_split,
+            "revolve": sample_revolve_goal}
 
 
 def sample_split(split: str, level: int, rng: random.Random) -> Goal:
