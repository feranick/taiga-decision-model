diff --git a/tests/test_ext_keep_heldout.py b/tests/test_ext_keep_heldout.py
new file mode 100644
index 0000000..be58e31
--- /dev/null
+++ b/tests/test_ext_keep_heldout.py
@@ -0,0 +1,61 @@
+"""taiga-expanded: TAIGA_KEEP_HELDOUT=1 trains on the held-out compositions (patch 0015)."""
+import json
+import random
+
+from freecad_s1.ext import goalsfile, mixed
+from freecad_s1.goals import heldout_composition, sample_split_goal
+
+PATTERNS = ("linear_pattern", "polar_pattern", "mirror")
+
+
+def _train_goals(n, seed, level=3):
+    rng = random.Random(seed)
+    return [sample_split_goal("train", level, rng) for _ in range(n)]
+
+
+def test_default_training_never_sees_held_out_pairs(monkeypatch):
+    monkeypatch.delenv("TAIGA_KEEP_HELDOUT", raising=False)
+    assert all(heldout_composition(g) is None for g in _train_goals(1500, 1))
+
+
+def test_keep_heldout_puts_held_out_pairs_into_training(monkeypatch):
+    monkeypatch.setenv("TAIGA_KEEP_HELDOUT", "1")
+    rules = [heldout_composition(g) for g in _train_goals(3000, 2)]
+    assert rules.count("pattern+boss_box") > 30 and rules.count("mirrored_hole_std") > 10
+
+
+def test_keep_heldout_leaves_evaluation_suites_unchanged(monkeypatch):
+    monkeypatch.delenv("TAIGA_KEEP_HELDOUT", raising=False)
+    plain = {s: [sample_split_goal(s, 3, random.Random(4)).to_json() for _ in range(3)] for s in ("iid", "comp", "mixed")}
+    monkeypatch.setenv("TAIGA_KEEP_HELDOUT", "1")
+    kept = {s: [sample_split_goal(s, 3, random.Random(4)).to_json() for _ in range(3)] for s in ("iid", "comp", "mixed")}
+    assert plain == kept
+
+
+def test_mixed_training_goals_pattern_boss_box_when_kept():
+    rng = random.Random(5)
+    n_pat_box = n_cross_box = 0
+    for _ in range(600):
+        g = mixed.sample_mixed_goal(3, rng, allow_heldout=True)
+        kinds = [f.kind for f in g.features]
+        for a, b in zip(g.features, g.features[1:]):
+            if a.kind == "boss_box" and b.kind in PATTERNS:
+                n_pat_box += 1
+                n_cross_box += "off" in a.params and b.kind == "linear_pattern"
+        assert kinds[0] == "base_box"
+    assert n_pat_box > 40 and n_cross_box > 5  # incl. cross blocks repeated up the height (casing feet)
+    assert mixed._HELD is False  # reset after the goal
+
+
+def test_goals_file_keeps_held_out_goals_when_kept(tmp_path, monkeypatch):
+    base = {"kind": "base_box", "params": {"w": 40, "d": 30, "h": 10}}
+    box = {"kind": "boss_box", "params": {"w": 4, "d": 4, "x": 5, "y": 0, "h": 3}}
+    pat = {"kind": "polar_pattern", "params": {"n": 4.0}}
+    path = tmp_path / "g.json"
+    path.write_text(json.dumps({"a": {"features": [base, box, pat]}, "b": {"features": [base, box]}}))
+    monkeypatch.setenv("TAIGA_GOALS_FILE", str(path))
+    goalsfile._CACHE.clear()
+    monkeypatch.delenv("TAIGA_KEEP_HELDOUT", raising=False)
+    assert sum(len(v) for v in goalsfile.load(goalsfile.files()).values()) == 1
+    monkeypatch.setenv("TAIGA_KEEP_HELDOUT", "1")
+    assert sum(len(v) for v in goalsfile.load(goalsfile.files()).values()) == 2
