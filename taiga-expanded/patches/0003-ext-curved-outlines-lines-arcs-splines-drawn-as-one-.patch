index 0000000..34eed05
--- /dev/null
+++ b/tests/test_ext_profiles.py
@@ -0,0 +1,117 @@
+"""taiga-expanded: curved outlines (patch 0003), pure-Python parts."""
+import math
+import random
+
+import numpy as np
+
+from freecad_s1.actions import ACTION_IDS, CATALOGUE, enumerate_actions
+from freecad_s1.expert import Meta, ObjMeta, expert_actions
+from freecad_s1.ext import faces, profiles as pr, sampler
+from freecad_s1.goals import RECIPES
+from freecad_s1.model.featurize import SEG_GOAL, encode_state
+from freecad_s1.schema import GOAL_KINDS, Goal, GoalFeature, Node, State
+
+
+def _inside(pt, poly):
+    x, y = pt
+    inside = False
+    for i in range(len(poly)):
+        (x1, y1), (x2, y2) = poly[i], poly[(i + 1) % len(poly)]
+        if (y1 > y) != (y2 > y) and x < x1 + (y - y1) * (x2 - x1) / (y2 - y1):
+            inside = not inside
+    return inside
+
+
+def test_upstream_action_ids_unchanged():
+    # new commands are appended: every upstream id keeps its index
+    assert ACTION_IDS[-2:] == ["Sketcher_CreateProfile", "Sketcher_ConstrainBlock"]
+    assert ACTION_IDS.index("Sketcher_LeaveSketch") == len(ACTION_IDS) - 3
+    assert GOAL_KINDS[-3:] == ["profile_base", "profile_boss", "profile_pocket"]
+    assert CATALOGUE["Sketcher_ConstrainBlock"].category == "sketch_constraint"
+
+
+def test_generators_close_and_arcs_bulge_the_right_way():
+    for o in (pr.rounded_rect(0, 0, 40, 20, 5), pr.slot(0, 0, 40, 10), pr.polygon(0, 0, 10, 6),
+              pr.d_shape(0, 0, 10, 6), pr.blob(random.Random(1), 0, 0, 10, 8)):
+        assert pr.is_closed(o)
+    # rounded rectangle: area slightly less than w*h (corners cut by arcs, not bulging out)
+    assert 800 - (4 - math.pi) * 25 - 1 < pr.area(pr.rounded_rect(0, 0, 40, 20, 5)) < 800
+    # slot: rectangle + full circle
+    assert abs(pr.area(pr.slot(0, 0, 40, 10)) - (30 * 10 + math.pi * 25)) < 1.0
+    # D: circle minus a segment, the arc on the far side of the flat
+    o = pr.d_shape(0, 0, 10, 6)
+    assert pr.bbox(o)[2] < 16.1 and pr.bbox(o)[0] < 0  # extends from -10 to +6
+
+
+def test_profile_geometry_arcs_are_counter_clockwise_and_match_the_outline():
+    o = pr.slot(0, 0, 40, 10)
+    f = GoalFeature("profile_boss", {"outline": o})
+    geo = pr.profile_geometry(f, (0, 0, 10, 10), lambda u, v: (u, v))
+    kinds = [g[0] for g in geo]
+    assert kinds == ["line", "arc", "line", "arc"]
+    for g in geo:
+        if g[0] == "arc":
+            (cx, cy), r, lo, hi = g[1], g[2], g[3], g[4]
+            assert hi > lo and abs(r - 5) < 1e-9
+            mid = (cx + r * math.cos((lo + hi) / 2), cy + r * math.sin((lo + hi) / 2))
+            assert abs(abs(mid[0]) - 20) < 1e-6  # the arc bulges outwards (ends of the slot)
+
+
+def test_profile_geometry_polyline_fallback_and_default():
+    o = pr.blob(random.Random(2), 0, 0, 10, 6)
+    f = GoalFeature("profile_pocket", {"outline": o})
+    geo = pr.profile_geometry(f, (0, 0, 1, 1), lambda u, v: (u, v), spline_mode="polyline")
+    assert all(g[0] == "line" for g in geo) and len(geo) > 20
+    assert math.dist(geo[-1][2], geo[0][1]) < 1e-9  # closed
+    # an intent without an outline (CreateProfile chosen by mistake) still yields a closed profile
+    geo = pr.profile_geometry(GoalFeature("hole", {"r": 2, "x": 0, "y": 0}), (1, 2, 8, 6), lambda u, v: (u, v))
+    assert math.dist(geo[-1][2], geo[0][1]) < 1e-9 and {g[0] for g in geo} == {"line", "arc"}
+
+
+def test_expert_recipe_and_valid_actions():
+    base = pr.rounded_rect(0, 0, 40, 30, 6)
+    g = Goal([GoalFeature("profile_base", {"outline": base, "h": 10, "w": 40, "d": 30})], level=1, scale=40)
+    meta = Meta(doc_open=True, workbench="PartDesignWorkbench", body="Body")
+    meta.objects["Body"] = ObjMeta("Body", "body")
+    assert expert_actions(g, meta) == ["Select:Plane:XY"]
+    meta.objects["Sketch"] = ObjMeta("Sketch", "sketch", goal_ref=0)
+    meta.edit = "Sketch"
+    assert expert_actions(g, meta) == ["Sketcher_CreateProfile"]
+    meta.objects["Sketch"].geometry = ["Sketcher_CreateProfile"]
+    assert expert_actions(g, meta) == ["Sketcher_ConstrainBlock"]
+    st = State(doc_open=True, workbench="PartDesignWorkbench", edit="Sketch", has_body=True,
+               tree=[Node("Sketch", "Sketcher::SketchObject", num={"n_geo": 0.8})])
+    acts = enumerate_actions(st)
+    assert "Sketcher_CreateProfile" in acts and "Sketcher_ConstrainBlock" in acts
+    assert RECIPES["profile_pocket"].feature == "PartDesign_Pocket"
+
+
+def test_outline_side_face_support_and_encoding():
+    o = pr.slot(5, 10, 16, 6)
+    f = GoalFeature("profile_pocket", {"outline": o, "x": 20, "y": 5, "z": 10, "nx": 1.0, "ny": 0.0, "nz": 0.0})
+    assert faces.support_for(f, RECIPES["profile_pocket"]) == "Face+X"
+    g = Goal([GoalFeature("base_box", {"w": 40, "d": 30, "h": 20}), f], level=2, scale=40)
+    tok = encode_state(State(doc_open=True), g, invariant=True, sentinel=True)
+    row = tok.num[np.flatnonzero(tok.seg == SEG_GOAL)[1]]
+    ext = row[29:43]
+    assert ext[5] == 0.2 and ext[6] == 0.2 and ext[7] == 0.0  # 2 lines, 2 arcs, no spline
+    assert abs(ext[8] - 16 / 40) < 1e-3 and abs(ext[9] - 6 / 40) < 1e-3  # outline size / scale
+    assert ext[10:14].tolist() == [1.0, 1.0, 0.0, 1.0]  # z, normal, no offset, outline
+
+
+def test_outline_sampler_features_inside_their_base():
+    rng = random.Random(4)
+    for _ in range(200):
+        g = sampler.sample_outline_goal(3, rng)
+        base = pr.polyline(g.features[0].params["outline"])
+        feats = g.features[1:]
+        for i, f in enumerate(feats):
+            if f.kind in ("profile_boss", "profile_pocket"):
+                pts = pr.polyline(f.params["outline"])
+                n = int(feats[i + 1].params["n"]) if i + 1 < len(feats) and feats[i + 1].kind == "polar_pattern" else 1
+                for k in range(n):  # every patterned copy stays inside the base outline
+                    a = 2 * math.pi * k / n
+                    for x, y in pts:
+                        assert _inside((x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a)), base), g
+            elif f.kind == "hole":
+                assert _inside((f.params["x"], f.params["y"]), base)
