+    if kind == "rounded_rect":
+        return pr.rounded_rect(cx, cy, 2 * rx, 2 * ry, _u(rng, 0.15, 0.45) * r)
+    if kind == "slot":
+        if rng.random() < 0.5:
+            return pr.slot(cx, cy, 2 * rx, min(2 * ry, rx), 0.0)
+        return pr.slot(cx, cy, 2 * ry, min(2 * rx, ry), math.pi / 2)
+    if kind == "polygon":
+        return pr.polygon(cx, cy, r, rng.randint(5, 8), rng.uniform(0, math.pi))
+    if kind == "d_shape":
+        return pr.d_shape(cx, cy, r, _u(rng, 0.5, 0.8) * r)
+    return pr.blob(rng, cx, cy, rx * 0.9, ry * 0.9, rng.randint(6, 9), 0.12)
+
+
+def _outline_feature(kind: str, outline: dict, **params) -> GoalFeature:
+    from . import profiles as pr
+
+    cu, cv, w, d = pr.bbox(outline)
+    p = {"outline": outline, "w": round(w, 1), "d": round(d, 1), **params}
+    if "x" not in p and "nx" not in p and "ny" not in p:  # top-face / XY: centre in x, y
+        p.update(x=round(cu, 1), y=round(cv, 1))
+    return GoalFeature(kind, p)
+
+
+def sample_outline_goal(level: int, rng: random.Random) -> Goal:
+    """Curved outlines: a profile_base (rounded rectangle, slot, polygon, D, spline blob) and
+    profile bosses/pockets on top (optionally patterned around the centre), holes, a curved
+    window on a side face of box-like bases, and a top dressup."""
+    from . import profiles as pr
+
+    for _ in range(100):
+        rx, ry = _u(rng, 12, 40), _u(rng, 12, 40)
+        h = _u(rng, 8, 30)
+        base_outline = _shape(rng, 0.0, 0.0, rx, ry)
+        base = _outline_feature("profile_base", base_outline, h=h)
+        if pr.area(base_outline) < 50:
+            continue
+        feats = [base]
+        budget = 1 if level <= 2 else 4
+        inner = 0.45 * min(rx, ry)  # disc of this radius around the centre lies inside every base shape
+        n_feat = 1 if level <= 2 else rng.randint(1, 3)
+        for _ in range(n_feat):
+            if len(feats) - 1 >= budget:
+                break
+            what = rng.choice(["boss", "pocket", "pocket", "patterned", "hole"])
+            if what == "hole":
+                r = _u(rng, 1.5, max(1.6, inner * 0.35))
+                feats.append(GoalFeature("hole", {"r": r, "x": _u(rng, -(inner - r), inner - r) * 0.7,
+                                                  "y": _u(rng, -(inner - r), inner - r) * 0.7}))
+            elif what == "patterned" and len(feats) - 1 + 2 <= budget:
+                n = rng.randint(3, 6)
+                rho = inner * _u(rng, 0.55, 0.7)
+                half = max(1.0, min(rho * math.sin(math.pi / n) * 0.6, inner - rho) * 0.8)
+                outline = _shape(rng, rho, 0.0, half, half)
+                kind = rng.choice(["profile_pocket", "profile_boss"])
+                extra = {"h": _u(rng, 2, 12)} if kind == "profile_boss" else {"depth": _u(rng, 1, h * 0.6)}
+                feats += [_outline_feature(kind, outline, **extra), GoalFeature("polar_pattern", {"n": float(n)})]
+            else:
+                half_u, half_v = _u(rng, 3, max(3.1, inner * 0.8)), _u(rng, 3, max(3.1, inner * 0.8))
+                outline = _shape(rng, 0.0, 0.0, half_u, half_v)
+                if what == "boss":
+                    feats.append(_outline_feature("profile_boss", outline, h=_u(rng, 2, 15)))
+                else:
+                    extra = {} if rng.random() < 0.3 else {"depth": _u(rng, 1, h * 0.7)}
+                    feats.append(_outline_feature("profile_pocket", outline, **extra))
+        if len(feats) == 1:
+            continue
+        if level >= 3 and len(feats) - 1 < budget and rng.random() < 0.4:
+            if rng.random() < 0.5:
+                feats.append(GoalFeature("fillet_top", {"r": _u(rng, 0.5, 1.5)}))
+            else:
+                feats.append(GoalFeature("chamfer_top", {"size": _u(rng, 0.5, 1.5)}))
+        scale = max(2 * rx, 2 * ry, h)
+        return Goal(feats, level=min(level, 3), scale=scale)
+    raise ValueError("could not sample an outline goal")
+
+
+def sample_side_window_goal(level: int, rng: random.Random) -> Goal:
+    """Box base with a curved window (profile_pocket) on a side face — outlines off the top face."""
+    from ..goals import _scale
+
+    base = _side_base(rng)
+    p = base.params
+    face = rng.choice(["+X", "-X", "+Y", "-Y"])
+    axis, sign = face[1], (1.0 if face[0] == "+" else -1.0)
+    half_u = (p["d"] if axis == "X" else p["w"]) / 2
+    hz = p["h"] / 2
+    ru, rv = _u(rng, 2, max(2.1, half_u * 0.5)), _u(rng, 2, max(2.1, hz * 0.6))
+    cu, cv = _u(rng, -(half_u - ru) * 0.6, (half_u - ru) * 0.6), hz
+    outline = _shape(rng, cu, cv, ru, rv)
+    params = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+    params["n" + axis.lower()] = sign
+    if axis == "X":
+        params.update(x=round(sign * p["w"] / 2, 1), y=round(cu, 1), z=round(cv, 1))
+    else:
+        params.update(x=round(cu, 1), y=round(sign * p["d"] / 2, 1), z=round(cv, 1))
+    if rng.random() < 0.6:
+        params["depth"] = _u(rng, 1, (p["w"] if axis == "X" else p["d"]) * 0.4)
+    feats = [base, _outline_feature("profile_pocket", outline, **params)]
+    return Goal(feats, level=min(max(level, 2), 3), scale=_scale(base))
+
+
+def _outline_split(level: int, rng: random.Random) -> Goal:
+    return sample_side_window_goal(level, rng) if rng.random() < 0.25 else sample_outline_goal(level, rng)
+
+
+SAMPLERS = {"side": sample_side_goal, "plane": sample_plane_goal, "outline": _outline_split}
 
 
