diff --git a/freecad_s1/ext/profiles.py b/freecad_s1/ext/profiles.py
new file mode 100644
index 0000000..c884b7a
--- /dev/null
+++ b/freecad_s1/ext/profiles.py
@@ -0,0 +1,269 @@
+"""Curved outlines: closed sketch profiles made of lines, arcs and splines.
+
+A goal feature of kind profile_base / profile_boss / profile_pocket carries its outline in
+params["outline"]:
+
+    {"start": [u0, v0],
+     "segs": [["L", u, v],                      # line to (u, v)
+              ["A", um, vm, u, v],              # arc through (um, vm) to (u, v)
+              ["S", [[u1, v1], ..., [u, v]]]]}  # spline through the points to (u, v)
+
+(u, v) are global in-plane coordinates of the sketch plane, in the same convention as
+ext.faces: on the top face or the XY plane u = X, v = Y; on a face or origin plane normal
+to X: u = Y, v = Z; normal to Y: u = X, v = Z. The last segment must end at "start".
+
+The whole outline is drawn by ONE command, Sketcher_CreateProfile, and fixed by
+Sketcher_ConstrainBlock: the model decides when and where to draw it, the runtime takes
+the coordinates from the goal (as it does for rectangles and circles). The model sees a
+summary of the outline (segment counts, bounding box), never the points.
+
+Pure stdlib except create_profile(), which receives FreeCAD's modules from the caller.
+"""
+from __future__ import annotations
+
+import math
+import os
+
+from . import faces
+
+OUTLINE_KINDS = ("profile_base", "profile_boss", "profile_pocket")
+# how splines are drawn: "bspline" (sketch B-spline) or "polyline" (short lines; fallback
+# if a FreeCAD build has trouble with B-splines in sketches)
+SPLINE_MODE = os.environ.get("TAIGA_SPLINE", "bspline")
+
+
+def arc_center(p1, p2, p3):
+    """Centre and radius of the circle through three 2D points (None if collinear)."""
+    (x1, y1), (x2, y2), (x3, y3) = p1, p2, p3
+    d = 2 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2))
+    if abs(d) < 1e-12:
+        return None
+    s1, s2, s3 = x1 * x1 + y1 * y1, x2 * x2 + y2 * y2, x3 * x3 + y3 * y3
+    cx = (s1 * (y2 - y3) + s2 * (y3 - y1) + s3 * (y1 - y2)) / d
+    cy = (s1 * (x3 - x2) + s2 * (x1 - x3) + s3 * (x2 - x1)) / d
+    return (cx, cy), math.hypot(x1 - cx, y1 - cy)
+
+
+def _ccw_span(a1, am, a2) -> bool:
+    """True if going counter-clockwise from a1 reaches am before a2."""
+    return (am - a1) % (2 * math.pi) < (a2 - a1) % (2 * math.pi)
+
+
+def sample_arc(p1, pm, p2, n: int):
+    """n points along the arc p1 -> pm -> p2 (p1 excluded)."""
+    c = arc_center(p1, pm, p2)
+    if c is None:
+        return [pm, p2]
+    (cx, cy), r = c
+    a1, am, a2 = (math.atan2(p[1] - cy, p[0] - cx) for p in (p1, pm, p2))
+    if _ccw_span(a1, am, a2):
+        span = (a2 - a1) % (2 * math.pi)
+    else:
+        span = -((a1 - a2) % (2 * math.pi))
+    return [(cx + r * math.cos(a1 + span * i / n), cy + r * math.sin(a1 + span * i / n)) for i in range(1, n + 1)]
+
+
+def polyline(outline: dict, arc_pts: int = 24) -> list[tuple[float, float]]:
+    """The outline as a closed polyline (arcs sampled, splines through their points)."""
+    cur = tuple(outline["start"])
+    pts = [cur]
+    for seg in outline["segs"]:
+        if seg[0] == "L":
+            cur = (seg[1], seg[2])
+            pts.append(cur)
+        elif seg[0] == "A":
+            mid, end = (seg[1], seg[2]), (seg[3], seg[4])
+            pts += sample_arc(cur, mid, end, arc_pts)
+            cur = end
+        elif seg[0] == "S":
+            pts += [tuple(p) for p in seg[1]]
+            cur = tuple(seg[1][-1])
+    return pts
+
+
+def bbox(outline: dict) -> tuple[float, float, float, float]:
+    """(centre u, centre v, width, height) of the outline."""
+    pts = polyline(outline)
+    us, vs = [p[0] for p in pts], [p[1] for p in pts]
+    return (min(us) + max(us)) / 2, (min(vs) + max(vs)) / 2, max(us) - min(us), max(vs) - min(vs)
+
+
+def area(outline: dict) -> float:
+    """Unsigned area (shoelace on the sampled polyline)."""
+    p = polyline(outline)
+    return abs(sum(p[i][0] * p[(i + 1) % len(p)][1] - p[(i + 1) % len(p)][0] * p[i][1] for i in range(len(p)))) / 2
+
+
+def is_closed(outline: dict, tol: float = 1e-6) -> bool:
+    last = outline["segs"][-1]
+    end = {"L": (last[1], last[2]) if last[0] == "L" else None,
+           "A": (last[3], last[4]) if last[0] == "A" else None,
+           "S": tuple(last[1][-1]) if last[0] == "S" else None}[last[0]]
+    return math.dist(end, tuple(outline["start"])) < tol
+
+
+def summary(f) -> list[float] | None:
+    """[n_line, n_arc, n_spline] / 10 and bbox width/height (global units) of the outline, or None."""
+    outline = f.params.get("outline")
+    if not isinstance(outline, dict):
+        return None
+    counts = {"L": 0, "A": 0, "S": 0}
+    for seg in outline["segs"]:
+        counts[seg[0]] = counts.get(seg[0], 0) + 1
+    _, _, w, h = bbox(outline)
+    return [counts["L"] / 10, counts["A"] / 10, counts["S"] / 10, w, h]
+
+
+def default_outline(cx: float, cy: float, sx: float, sy: float) -> dict:
+    """Outline used when Sketcher_CreateProfile is chosen for an intent without one
+    (a mistake to recover from): a rectangle with one rounded corner."""
+    x0, y0, x1, y1 = cx - sx / 2, cy - sy / 2, cx + sx / 2, cy + sy / 2
+    r = min(sx, sy) / 4
+    c = r * (1 - math.sqrt(0.5))
+    return {"start": [x0, y0], "segs": [["L", x1 - r, y0], ["A", x1 - c, y0 + c, x1, y0 + r],
+                                        ["L", x1, y1], ["L", x0, y1], ["L", x0, y0]]}
+
+
+def to_local(sk, f, u: float, v: float, vec_cls):
+    """Global in-plane (u, v) -> sketch-local point, for any support (top face, side face,
+    origin plane with offset). Uses the sketch placement, like ext.faces.local_box."""
+    k, sign = faces.normal(f)
+    ua, va = faces.inplane_axes(k)
+    n = [0.0, 0.0, 0.0]
+    n[k] = sign
+    d = sk.Placement.Base.dot(vec_cls(*n))
+    p = [0.0, 0.0, 0.0]
+    p[k], p[ua], p[va] = sign * d, u, v
+    q = sk.Placement.inverse().multVec(vec_cls(*p))
+    return vec_cls(q.x, q.y, 0)
+
+
+def _dense_spline(pts, per_span: int):
+    """Catmull-Rom points through `pts` (for the polyline fallback)."""
+    out = [pts[0]]
+    for i in range(len(pts) - 1):
+        p0, p1, p2, p3 = pts[max(i - 1, 0)], pts[i], pts[i + 1], pts[min(i + 2, len(pts) - 1)]
+        for j in range(1, per_span + 1):
+            t = j / per_span
+            t2, t3 = t * t, t * t * t
+            out.append(tuple(0.5 * ((2 * p1[c]) + (-p0[c] + p2[c]) * t + (2 * p0[c] - 5 * p1[c] + 4 * p2[c] - p3[c]) * t2
+                                    + (-p0[c] + 3 * p1[c] - 3 * p2[c] + p3[c]) * t3) for c in (0, 1)))
+    out[-1] = pts[-1]
+    return out
+
+
+def profile_geometry(f, box, loc, spline_mode: str | None = None):
+    """Geometry of the outline as abstract records in sketch-local coordinates:
+    ("line", p, q), ("arc", centre, r, a_lo, a_hi), ("bspline", [points]).
+    `loc(u, v)` maps global in-plane coordinates to local (x, y). Pure Python (testable)."""
+    outline = f.params.get("outline")
+    if not isinstance(outline, dict):
+        outline = default_outline(*box)
+    mode = spline_mode or SPLINE_MODE
+    out = []
+    cur = loc(*outline["start"])
+    for seg in outline["segs"]:
+        if seg[0] == "L":
+            end = loc(seg[1], seg[2])
+            out.append(("line", cur, end))
+        elif seg[0] == "A":
+            mid, end = loc(seg[1], seg[2]), loc(seg[3], seg[4])
+            c = arc_center(cur, mid, end)
+            if c is None:
+                out.append(("line", cur, end))
+            else:
+                (cx, cy), r = c
+                a1, am, a2 = (math.atan2(p[1] - cy, p[0] - cx) for p in (cur, mid, end))
+                if _ccw_span(a1, am, a2):
+                    out.append(("arc", (cx, cy), r, a1, a1 + (a2 - a1) % (2 * math.pi)))
+                else:  # sketch arcs run counter-clockwise: draw this one from its end point
+                    out.append(("arc", (cx, cy), r, a2, a2 + (a1 - a2) % (2 * math.pi)))
+        elif seg[0] == "S":
+            pts = [cur] + [loc(*p) for p in seg[1]]
+            end = pts[-1]
+            if mode == "polyline":
+                dense = _dense_spline(pts, 8)
+                out += [("line", dense[i], dense[i + 1]) for i in range(len(dense) - 1)]
+            else:
+                out.append(("bspline", pts))
+        else:
+            raise ValueError(f"unknown outline segment {seg[0]!r}")
+        cur = end
+    return out
+
+
+def create_profile(sk, f, box, vec_cls, part) -> list[int]:
+    """Draw the outline of intent `f` in sketch `sk`; returns the new geometry ids.
+    `box` = params.profile_box(f, scale) (for the default outline), `vec_cls` = App.Vector,
+    `part` = FreeCAD's Part module."""
+    def loc(u, v):
+        q = to_local(sk, f, u, v, vec_cls)
+        return (q.x, q.y)
+
+    z = vec_cls(0, 0, 1)
+    geos = []
+    for g in profile_geometry(f, box, loc):
+        if g[0] == "line":
+            geos.append(part.LineSegment(vec_cls(*g[1], 0), vec_cls(*g[2], 0)))
+        elif g[0] == "arc":
+            geos.append(part.ArcOfCircle(part.Circle(vec_cls(*g[1], 0), z, g[2]), g[3], g[4]))
+        else:
+            bs = part.BSplineCurve()
+            bs.interpolate([vec_cls(x, y, 0) for x, y in g[1]])
+            geos.append(bs)
+    first = sk.GeometryCount
+    sk.addGeometry(geos, False)
+    return list(range(first, sk.GeometryCount))
+
+
+# ---------------------------------------------------------------- outline generators (sampler)
+
+
+def _r3(x):
+    return round(x, 3)
+
+
+def rounded_rect(cx, cy, w, h, r) -> dict:
+    r = min(r, w / 2 - 0.01, h / 2 - 0.01)
+    c = r * (1 - math.sqrt(0.5))
+    x0, y0, x1, y1 = cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2
+    p = lambda x, y: [_r3(x), _r3(y)]  # noqa: E731
+    return {"start": p(x0 + r, y0), "segs": [
+        ["L", *p(x1 - r, y0)], ["A", *p(x1 - c, y0 + c), *p(x1, y0 + r)],
+        ["L", *p(x1, y1 - r)], ["A", *p(x1 - c, y1 - c), *p(x1 - r, y1)],
+        ["L", *p(x0 + r, y1)], ["A", *p(x0 + c, y1 - c), *p(x0, y1 - r)],
+        ["L", *p(x0, y0 + r)], ["A", *p(x0 + c, y0 + c), *p(x0 + r, y0)]]}
+
+
+def slot(cx, cy, length, width, angle=0.0) -> dict:
+    """Stadium: two straight sides and two half-circle ends; `length` end to end."""
+    r = width / 2
+    a = length / 2 - r
+    ca, sa = math.cos(angle), math.sin(angle)
+    rot = lambda x, y: [_r3(cx + x * ca - y * sa), _r3(cy + x * sa + y * ca)]  # noqa: E731
+    return {"start": rot(-a, -r), "segs": [
+        ["L", *rot(a, -r)], ["A", *rot(a + r, 0), *rot(a, r)],
+        ["L", *rot(-a, r)], ["A", *rot(-a - r, 0), *rot(-a, -r)]]}
+
+
+def polygon(cx, cy, r, n, phase=0.0) -> dict:
+    pts = [[_r3(cx + r * math.cos(phase + 2 * math.pi * i / n)), _r3(cy + r * math.sin(phase + 2 * math.pi * i / n))]
+           for i in range(n)]
+    return {"start": pts[0], "segs": [["L", *q] for q in pts[1:]] + [["L", *pts[0]]]}
+
+
+def d_shape(cx, cy, r, flat) -> dict:
+    """Circle with one flat (a 'D'): the flat at distance `flat` (< r) from the centre, on +u."""
+    h = math.sqrt(r * r - flat * flat)
+    p1, p2 = [_r3(cx + flat), _r3(cy - h)], [_r3(cx + flat), _r3(cy + h)]
+    return {"start": p1, "segs": [["L", *p2], ["A", _r3(cx - r), _r3(cy), *p1]]}
+
+
+def blob(rng, cx, cy, rx, ry, n=8, wobble=0.15) -> dict:
+    """Closed spline through n points around an ellipse, radii perturbed by +-wobble."""
+    pts = []
+    for i in range(n):
+        a = 2 * math.pi * i / n
+        k = 1 + rng.uniform(-wobble, wobble)
+        pts.append([_r3(cx + k * rx * math.cos(a)), _r3(cy + k * ry * math.sin(a))])
+    return {"start": pts[0], "segs": [["S", pts[1:] + [pts[0]]]]}
