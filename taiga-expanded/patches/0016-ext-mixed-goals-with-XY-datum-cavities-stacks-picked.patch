+"""taiga-expanded: cavities, stacks picked by "at" and the explicit nz=+1 top-face form in mixed
+goals (patch 0016)."""
+import random
+
+from freecad_s1.evaluate import SUITES
+from freecad_s1.ext import mixed, sampler
+from freecad_s1.goals import heldout_composition, sample_split_goal
+
+
+def _explicit_top(f):
+    return f.params.get("nz") == 1.0 and "off" not in f.params
+
+
+def test_mixed_suites_keep_their_goals():
+    # without `extra` nothing new appears, and the mixed suite is the plain sampler
+    rng = random.Random(3)
+    for _ in range(400):
+        g = mixed.sample_mixed_goal(4, rng)
+        assert not any("at" in f.params or _explicit_top(f) for f in g.features)
+    a = [sample_split_goal("mixed", 3, random.Random(9)).to_json() for _ in range(3)]
+    b = [mixed.sample_mixed_goal(3, random.Random(9)) for _ in range(3)]
+    assert a[0] == b[0].to_json()
+
+
+def test_mixed_at_suite():
+    assert SUITES["mixed_at"] == [(3, "mixed_at")] and "mixed_at" not in sampler.SPLITS
+    rng = random.Random(1)
+    for level in (3, 4):
+        for _ in range(300):
+            g = sample_split_goal("mixed_at", level, rng)
+            assert heldout_composition(g) is None and len(g.features) <= 24
+            assert any("at" in f.params for f in g.features)
+            for f in g.features:
+                if _explicit_top(f) or ("at" in f.params and "nx" in f.params):
+                    assert "z" in f.params
+                if "at" in f.params and "nx" in f.params:  # the point is the feature's own centre
+                    assert f.params["at"] == [f.params["x"], f.params["y"], f.params["z"]]
+            # no feature without a normal once the goal uses the explicit form on top
+            assert not any(f.kind in mixed.SKETCHED and "nx" not in f.params for f in g.features[1:])
+
+
+def test_training_mixed_goals_mix_datum_and_face_normals(monkeypatch):
+    monkeypatch.delenv("TAIGA_KEEP_HELDOUT", raising=False)
+    rng = random.Random(2)
+    both = cav = stack = 0
+    for _ in range(1500):
+        g = sampler._mixed(3, rng, extra=True)
+        assert heldout_composition(g) is None
+        datum = any(f.params.get("nz") == 1.0 and "off" in f.params for f in g.features)
+        top = any(_explicit_top(f) for f in g.features)
+        cav += datum
+        stack += any("at" in f.params for f in g.features)
+        both += datum and top
+    assert cav > 300 and stack > 600 and both > 100
+
+
+def test_stack_bolt_holes_are_mirrored_about_the_neck():
+    rng = random.Random(4)
+    base = mixed.GoalFeature("base_box", {"w": 80.0, "d": 60.0, "h": 30.0})
+    seen = 0
+    for _ in range(400):
+        for face, xr in (("+Z", (1.5, 38.5)), ("+X", None), ("-Y", None)):
+            g = mixed._stack_group(rng, base, face, xr, explicit=True)
+            if not g or g[-1].kind != "mirror":
+                continue
+            seen += 1
+            neck, hole, m = g[0], g[-2], g[-1]
+            k = [a for a in "xyz" if m.params["a" + a] != 0.0][0]
+            assert neck.params[k] == 0.0 and hole.params[k] != 0.0  # mirror plane through the neck's axis
+    assert seen > 50
+
