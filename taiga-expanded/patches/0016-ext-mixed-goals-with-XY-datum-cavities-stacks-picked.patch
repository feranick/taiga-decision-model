+SKETCHED = ("hole", "hole_std", "boss_cyl", "boss_box", "pocket_rect", "profile_pocket", "profile_boss")
+
+
+def _explicit_top(f: GoalFeature, h: float, with_at: bool) -> GoalFeature:
+    """A top-face feature written with its normal (nz=+1) and z = h, optionally also "at"
+    (patch 0016). The teacher builds it exactly as without them."""
+    if f.kind not in SKETCHED or any(k in f.params for k in ("nx", "ny", "nz")):
+        return f
+    p = dict(f.params)
+    p.update(nx=0.0, ny=0.0, nz=1.0, z=round(h, 1))
+    if with_at and "at" not in p:
+        p["at"] = [p.get("x", 0.0), p.get("y", 0.0), round(h, 1)]
+    return GoalFeature(f.kind, p)
+
+
+def _stack_group(rng, base, face, xr=None, explicit=False):
+    """A stack on one face of the box (patch 0016), every feature's face picked with "at": a
+    neck (boss_cyl; boss_box only with held-out pairs kept), optionally a wider flange on it,
+    then a bore through them and / or bolt holes in the flange rim mirrored across the neck's
+    axis plane, or a hole in the neck's end. On the top face the neck stays in the X half xr.
+    Side-face features carry their normal; top-face ones only with `explicit`."""
+    from . import patterns as pt
+    from .sampler import _circle, _outline_feature
+
+    p = base.params
+    w, d, h = p["w"], p["d"], p["h"]
+    k, sign = "xyz".index(face[1].lower()), (1.0 if face[0] == "+" else -1.0)
+    ua, va = [i for i in range(3) if i != k]
+    m = 1 if k == 2 else ua  # mirror axis: y on top, the horizontal in-plane axis on a side
+    if k == 2:
+        room = {0: (xr[1] - xr[0]) / 2, 1: d / 2}
+    else:
+        room = {ua: (d if k == 0 else w) / 2, 2: h / 2}
+    r_room = min(room.values())
+    rn = _u(rng, 2.5, max(2.6, r_room * 0.45))
+    if rn + 1.5 > r_room:
+        return None
+    mirror = rng.random() < 0.5
+    c = [0.0, 0.0, 0.0]
+    c[k] = h if k == 2 else sign * (w / 2 if k == 0 else d / 2)
+    if k == 2:
+        c[0] = round((xr[0] + xr[1]) / 2, 1)
+    for a in (ua, va):
+        if a == k or (k == 2 and a == 0):
+            continue
+        lo, hi = (rn + 1.5, h - rn - 1.5) if a == 2 else (-(room[a] - rn - 1.5), room[a] - rn - 1.5)
+        c[a] = 0.0 if (a == m and mirror) else _u(rng, lo, max(lo + 0.1, hi))
+    c = [round(v, 1) for v in c]
+
+    def place(q):
+        if k == 2 and not explicit:
+            return {"x": q[0], "y": q[1]}
+        n = {"nx": 0.0, "ny": 0.0, "nz": 0.0}
+        n["n" + "xyz"[k]] = sign
+        return {**n, "x": q[0], "y": q[1], "z": q[2]}
+
+    def shifted(q, dist):
+        q = list(q)
+        q[k] = round(q[k] + sign * dist, 1)
+        return q
+
+    hn = _u(rng, 3, 15)
+    kind = rng.choice(_kinds(["boss_cyl"], "boss_box"))
+    if kind == "boss_box":
+        neck = GoalFeature("boss_box", {**place(c), "w": round(2 * rn, 1), "d": round(2 * rn, 1), "h": hn, "at": list(c)})
+    else:
+        neck = GoalFeature("boss_cyl", {**place(c), "r": rn, "h": hn, "at": list(c)})
+    feats = [neck]
+    end = shifted(c, hn)
+    flange = rng.random() < 0.6
+    rf = hf = 0.0
+    if flange:
+        rf = min(round(rn * _u(rng, 1.4, 2.2), 1), round(r_room * 1.1, 1))
+        flange = rf - rn >= 1.0
+    if flange:
+        hf = _u(rng, 2, 8)
+        feats.append(GoalFeature("boss_cyl", {**place(end), "r": rf, "h": hf, "at": list(end)}))
+        end = shifted(end, hf)
+    if rng.random() < (0.8 if flange else 0.5):  # bore through flange and neck, into the part
+        rb = round(rn * _u(rng, 0.4, 0.75), 1)
+        feats.append(_outline_feature("profile_pocket", _circle(end[ua], end[va], rb), **place(end),
+                                      depth=round(hn + hf + _u(rng, 1, 5), 1), at=list(end)))
+    elif not flange:  # a hole in the neck's end
+        feats.append(GoalFeature("hole", {**place(end), "r": round(rn * _u(rng, 0.3, 0.6), 1), "at": list(end)}))
+    if flange and mirror and rf - rn > 3 and rng.random() < 0.7:  # bolt hole in the rim, mirrored
+        q = list(end)
+        q[m] = round(c[m] + (rn + rf) / 2, 1)
+        hr = _u(rng, 1, max(1.1, (rf - rn) * 0.25))
+        feats.append(_outline_feature("profile_pocket", _circle(q[ua], q[va], hr), **place(q),
+                                      depth=round(hf + 1, 1), at=q))
+        feats.append(GoalFeature("mirror", pt.pattern_params("mirror", m)))
+    return feats
+
